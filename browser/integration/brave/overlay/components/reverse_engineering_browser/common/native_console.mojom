module reb.mojom;

import "mojo/public/mojom/base/shared_memory.mojom";
import "mojo/public/mojom/base/unguessable_token.mojom";

// Bound on the renderer's IO thread, so a Stop is heard while a command or a
// document-start injection holds the main thread. It reaches only the
// execution that `request_id` names: a Stop that arrives after that execution
// returned does nothing.
interface NativeConsoleControl {
  Stop(uint64 request_id);
};

// Frame-associated ordering plus an exact document token prevents a console
// request queued before navigation from executing in the replacement page.
interface NativeConsoleAgent {
  Describe() => (mojo_base.mojom.UnguessableToken? document);
  // Sent before any command, while the main thread is free to bind it.
  BindControl(pending_receiver<NativeConsoleControl> control);
  Runtime(mojo_base.mojom.UnguessableToken document,
          uint64 request_id,
          uint64 expires_at_monotonic_us,
          string command) => (uint16 status, uint16 type, string text, bool truncated);
  Evaluate(mojo_base.mojom.UnguessableToken document,
           uint64 request_id,
           uint64 expires_at_monotonic_us,
           string source) => (uint16 status, uint16 type, string text, bool truncated);
};

// Process-wide document-start script delivery for the separately armed
// experiment. The browser pushes the set before a renderer process launches, so
// a process created after arming holds it before its first document commits.
// The set is one read-only region every renderer maps, so a large set is never
// copied per process; a cleared set sends none. Arm replies with the number of
// scripts this renderer can actually run, so the owner can tell "never
// received the set" from "ran and reported nothing".
interface NativeConsoleScriptClient {
  Arm(uint64 generation, mojo_base.mojom.ReadOnlySharedMemoryRegion? scripts) => (uint32 armed);
};

interface NativeConsoleScriptHost {
  // `control` stops an injection of a replaced or cleared set that is still
  // running, while it holds the renderer's main thread.
  BindClient(pending_remote<NativeConsoleScriptClient> client,
             pending_remote<NativeConsoleControl> control);
  // One page-JavaScript observation. The document token resolves this
  // record to a nonsecret document ID among the sending process's own frames;
  // it is never published and never grants console execution ownership.
  Observed(uint64 generation,
           uint64 script_id,
           uint64 frame_id,
           mojo_base.mojom.UnguessableToken document,
           uint32 record,
           bool truncated,
           string text);
};
