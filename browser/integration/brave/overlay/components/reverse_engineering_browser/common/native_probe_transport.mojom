module reb.mojom;

import "mojo/public/mojom/base/shared_memory.mojom";
import "mojo/public/mojom/base/big_buffer.mojom";

interface NativeProbeClient {
  Configure(uint64 session_id,
            uint64 category_mask,
            uint64 expires_at_monotonic_ns,
            bool capture_canvas_images,
            mojo_base.mojom.UnsafeSharedMemoryRegion queue_region,
            uint64 wasm_capture_epoch,
            string guest_adapter_json,
            // Fixed 44-byte native JavaScript dispatch site records (at most 8),
            // already validated by the browser; empty when not armed.
            array<uint8> js_dispatch_sites,
            // Fixed 44-byte function-entry site records (shape 3, at most 8)
            // for native JavaScript invocation identity; empty when not armed.
            array<uint8> js_invocation_sites,
            // The session's sensitive opt-in for settled-value digests.
            bool js_invocation_digests,
            // --reb-capture-request-content: renderer request targets and
            // script cookie records (protocol/native-network-v3.md).
            bool capture_request_content,
            // --reb-capture-browser-internal: record internal schemes.
            bool capture_browser_internal);
  // Fixed 524-byte sample-budget policy, or empty for the unrestricted
  // historical budgets. The next Configure publishes it. It does not arm
  // compilation, so a later session may replace it.
  SetWasmSampleBudget(array<uint8> policy);
  // Restarts both sample indexes without Disable or a new configuration.
  ResetWasmSampleBudgets();
  Disable();
  // Browser verdict on the module bytes carried by the guest capture whose
  // dispatch sequence number is module_token. The renderer keeps sending an
  // empty module only after acceptance, and resends after a rejection.
  NativeGuestModuleStatus(uint64 wasm_capture_epoch,
                          uint64 module_token,
                          bool accepted);
};

// Process-wide renderer connection. Event records travel through the shared
// queue. Mojo carries lifecycle changes and one coalesced wake-up per batch.
interface NativeProbeHost {
  BindClient(pending_remote<NativeProbeClient> client);
  EventsAvailable();
  CaptureWasmDispatch(uint64 capture_epoch,
                      uint64 session_id,
                      uint64 sequence_number,
                      uint64 monotonic_time_ns,
                      uint32 process_id,
                      uint32 thread_id,
                      uint64 frame_id,
                      uint64 execution_context_id,
                      uint64 document_token_high,
                      uint64 document_token_low,
                      uint32 function_index,
                      uint32 module_byte_offset,
                      uint32 selector,
                      uint32 table_count,
                      // Immediate live caller. caller_observed is true only
                      // after this activation was walked. Kind 0 is unknown
                      // (host, another instance, a non-Liftoff frame, or a
                      // frame whose code could not be read) and the index is
                      // then 0. Kind 1 is a Liftoff function of this module.
                      // An unwalked record keeps kind 0 and index 0 and is not
                      // unknown. protocol/native-wasm-dispatch-v1.md.
                      bool caller_observed,
                      uint8 caller_kind,
                      uint32 caller_function_index,
                      uint32 sample_index,
                      // JavaScript invocation context (state 0 to 3, ID
                      // nonzero only for state 2), see
                      // protocol/native-js-invocation-v1.md.
                      uint8 js_invocation_state,
                      uint32 js_invocation_id,
                      string source_url,
                      mojo_base.mojom.BigBuffer content);
  // Physical call_indirect observation; same admission and module transfer as
  // CaptureWasmDispatch, with its own 16-record budget.
  CaptureWasmIndirect(uint64 capture_epoch,
                      uint64 session_id,
                      uint64 sequence_number,
                      uint64 monotonic_time_ns,
                      uint32 process_id,
                      uint32 thread_id,
                      uint64 frame_id,
                      uint64 execution_context_id,
                      uint64 document_token_high,
                      uint64 document_token_low,
                      uint32 function_index,
                      uint32 module_byte_offset,
                      uint32 table_index,
                      uint32 slot,
                      uint32 callee_function_index,
                      uint32 resolution,
                      uint32 sample_index,
                      uint8 js_invocation_state,
                      uint32 js_invocation_id,
                      string source_url,
                      mojo_base.mojom.BigBuffer content);
  // Trap or still-executing follow-up for one host-visible Wasm call.
  // content may be empty: the browser then binds the one module already
  // captured for this document, or records an explicit gap.
  CaptureWasmExecution(uint64 capture_epoch,
                       uint64 session_id,
                       uint64 sequence_number,
                       uint64 monotonic_time_ns,
                       uint32 process_id,
                       uint32 thread_id,
                       uint64 frame_id,
                       uint64 execution_context_id,
                       uint64 document_token_high,
                       uint64 document_token_low,
                       uint32 invocation_id,
                       uint32 function_index,
                       uint32 module_byte_offset,
                       uint32 related_sample_index,
                       uint8 kind,
                       uint8 reason,
                       uint8 bounds,
                       uint8 known,
                       uint8 related_stream,
                       uint8 js_invocation_state,
                       uint32 js_invocation_id,
                       string source_url,
                       mojo_base.mojom.BigBuffer content);
  CaptureNativeGuest(uint64 capture_epoch,
                     array<uint8> invocation_record,
                     array<uint8> dispatch_record,
                     uint64 execution_context_id,
                     uint64 document_token_high,
                     uint64 document_token_low,
                     string source_url,
                     string adapter_json,
                     mojo_base.mojom.BigBuffer wasm_module,
                     mojo_base.mojom.BigBuffer bytecode);
  CaptureNativeGuestHost(uint64 capture_epoch, array<uint8> event_record);
  CaptureGeneratedArtifact(uint16 kind,
                           uint16 capture_origin,
                           uint64 creator_event_id,
                           uint64 execution_context_id,
                           uint64 frame_id,
                           string source_url,
                           mojo_base.mojom.BigBuffer content,
                           uint64 allocating_script_id,
                           bool allocating_script_is_eval,
                           mojo_base.mojom.BigBuffer allocating_script_source,
                           uint64 allocating_script_session_id);
};
