+std::uint32_t InitiatorProcessId(
+    const content::GlobalRenderFrameHostToken& render_frame_token) {
+  if (render_frame_token.child_id < 0) {
+    return 0;
+  }
+  content::RenderProcessHost* const render_process =
+      content::RenderProcessHost::FromID(render_frame_token.child_id);
+  return render_process
+             ? static_cast<std::uint32_t>(render_process->GetProcess().Pid())
+             : 0;
+}
+
+std::uint64_t FrameId(
+    const content::GlobalRenderFrameHostToken& render_frame_token) {
+  if (render_frame_token.child_id < 0) {
+    return 0;
+  }
+  const base::UnguessableToken& token = render_frame_token.frame_token.value();
+  return std::rotl(token.GetHighForSerialization(), 17) ^
+         token.GetLowForSerialization();
+}
