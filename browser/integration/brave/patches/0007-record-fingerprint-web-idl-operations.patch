+def _reb_probe_details(cg_context):
+    if not cg_context.property_:
+        return None
+    interface = cg_context.class_like.identifier
+    category = _REB_TRACKED_INTERFACES.get(interface)
+    if not category:
+        return None
+    member = cg_context.property_.identifier
+    tracked_members = _REB_TRACKED_MEMBERS.get(interface)
+    if tracked_members is not None and member not in tracked_members:
+        return None
+    if member in _REB_EXPLICIT_PROBES.get(interface, set()):
+        return None
+    if not (cg_context.attribute_get or cg_context.attribute_set or
+            cg_context.operation_group or cg_context.stringifier):
+        return None
+    operation = "{}.{}".format(interface, member)
+    if cg_context.attribute_set:
+        operation += ".set"
+    return category, operation
+
+
+def _make_report_reb_binding_event(cg_context):
+    details = _reb_probe_details(cg_context)
+    if not details:
+        return None
+    category, operation = details
+    record_method = ("RecordPropertyRead" if cg_context.attribute_get else
+                     "RecordApiCall")
+    if category == "Canvas":
+        statement = (
+            "::reb::NativeProbeSink::Get().{}("
+            "::reb::NativeProbeCategory::k{}, \"{}\");".format(
+                record_method, category, operation))
+    else:
+        record_method += "Once"
+        statement = (
+            "static std::atomic<std::uint64_t> "
+            "reb_observed_session_id{{0}};\n"
+            "::reb::NativeProbeSink::Get().{}("
+            "::reb::NativeProbeCategory::k{}, \"{}\", "
+            "reb_observed_session_id);".format(
+                record_method, category, operation))
+    node = TextNode(statement)
+    node.accumulate(
+        CodeGenAccumulator.require_include_headers([
+            "brave/components/reverse_engineering_browser/renderer/"
+            "native_probe_sink.h",
+        ]))
+    if category != "Canvas":
+        node.accumulate(
+            CodeGenAccumulator.require_stdcpp_include_headers(["atomic"]))
+    return node
+
