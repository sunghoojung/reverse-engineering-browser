+// Runs no Shields hook and changes nothing, so the proxy only forwards and,
+// for native capture, records (protocol/native-network-v3.md).
+template <template <typename> class T>
+class ObservingRequestHandler final : public BraveRequestHandler<T> {
+ public:
+  int OnBeforeURLRequest(T<brave::BraveRequestInfo>,
+                         net::CompletionOnceCallback,
+                         GURL*) override {
+    return net::OK;
+  }
+  int OnBeforeStartTransaction(T<brave::BraveRequestInfo>,
+                               net::CompletionOnceCallback,
+                               net::HttpRequestHeaders*) override {
+    return net::OK;
+  }
+  int OnHeadersReceived(T<brave::BraveRequestInfo>,
+                        net::CompletionOnceCallback,
+                        const net::HttpResponseHeaders*,
+                        scoped_refptr<net::HttpResponseHeaders>*,
+                        GURL*) override {
+    return net::OK;
+  }
+  void OnURLRequestDestroyed(T<brave::BraveRequestInfo>) override {}
+};
+
+}  // namespace
