--- a/v8/include/v8-callbacks.h
+++ b/v8/include/v8-callbacks.h
@@ -317,6 +317,19 @@ using ExtensionCallback = bool (*)(const FunctionCallbackInfo<Value>&);
 using AllowWasmCodeGenerationCallback = bool (*)(Local<Context> context,
                                                  Local<String> source);
 
+enum class WasmModuleBytesOrigin {
+  kCompile,
+  kModule,
+  kInstantiate,
+};
+
+// Called synchronously after WebAssembly code generation is authorized and
+// V8 has copied the caller-owned module bytes.
+using WasmModuleBytesCallback = void (*)(Local<Context> context,
+                                         WasmModuleBytesOrigin origin,
+                                         const uint8_t* bytes,
+                                         size_t size);
+
 // --- Callback for APIs defined on v8-supported objects, but implemented
 // by the embedder. Example: WebAssembly.{compile|instantiate}Streaming ---
 using ApiImplementationCallback = void (*)(const FunctionCallbackInfo<Value>&);
