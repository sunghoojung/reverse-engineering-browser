+void NotifyWasmModuleBytes(i::Isolate* isolate,
+                           Local<Context> context,
+                           const WasmModuleBytesOrigin origin,
+                           const base::span<const uint8_t> bytes) {
+  WasmModuleBytesCallback callback = isolate->wasm_module_bytes_callback();
+  if (!callback) {
+    return;
+  }
+  callback(context, origin, bytes.data(), bytes.size());
+}
