diff --git a/v8/test/inspector/debugger/reb-ignore-debugger-statements.js b/v8/test/inspector/debugger/reb-ignore-debugger-statements.js
new file mode 100644
--- /dev/null
+++ b/v8/test/inspector/debugger/reb-ignore-debugger-statements.js
@@ -0,0 +1,43 @@
+// Copyright 2026 the V8 project authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+// Flags: --reb-ignore-debugger-statements
+
+const {session, contextGroup, Protocol} = InspectorTest.start(
+    'Native debugger-statement suppression leaves explicit breakpoints active');
+
+InspectorTest.runAsyncTestSuite([
+  async function testNativeDebuggerStatementSuppression() {
+    await Protocol.Debugger.enable();
+    await Protocol.Runtime.enable();
+
+    const evaluation = await Protocol.Runtime.evaluate({
+      expression: 'debugger; globalThis.rebDebuggerStatementContinued = true;',
+    });
+    InspectorTest.log(
+        `Debugger statement continued: ${evaluation.result.result.value}`);
+
+    const sourceURL = 'reb-explicit-breakpoint.js';
+    const {result: {scriptId}} = await Protocol.Runtime.compileScript({
+      expression: [
+        'function target() {',
+        '  return 7;',
+        '}',
+        'target();',
+      ].join('\n'),
+      sourceURL,
+      persistScript: true,
+    });
+    await Protocol.Debugger.setBreakpointByUrl({
+      lineNumber: 1,
+      url: sourceURL,
+    });
+
+    const runPromise = Protocol.Runtime.runScript({scriptId});
+    const {params: {reason, hitBreakpoints}} =
+        await Protocol.Debugger.oncePaused();
+    InspectorTest.log(
+        `Explicit breakpoint paused with reason ${reason} and ` +
+        `${hitBreakpoints.length} hit breakpoint.`);
+    await Protocol.Debugger.resume();
+    await runPromise;
+
+    await Protocol.Debugger.disable();
+    await Protocol.Runtime.disable();
+  },
+]);
