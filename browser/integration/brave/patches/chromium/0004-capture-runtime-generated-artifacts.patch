+std::uint64_t StableExecutionContextId(const ExecutionContext& context) {
+  return context.GetExecutionContextToken().Visit([](const auto& typed_token) {
+    const base::UnguessableToken& token = typed_token.value();
+    return std::rotl(token.GetHighForSerialization(), 17) ^
+           token.GetLowForSerialization();
+  });
+}
+
+std::uint64_t StableFrameId(const ExecutionContext& context) {
+  const ExecutionContextToken token = context.GetExecutionContextToken();
+  return token.Is<LocalFrameToken>() ? StableExecutionContextId(context) : 0;
+}
+
+void CaptureGeneratedSource(v8::Local<v8::Context> context,
+                            const reb::NativeArtifactKind kind,
+                            const reb::NativeArtifactCaptureOrigin capture_origin,
+                            const base::span<const std::uint8_t> content) {
+  reb::NativeProbeSink& sink = reb::NativeProbeSink::Get();
+  if (!sink.IsArtifactCaptureEnabled()) {
+    return;
+  }
+  ExecutionContext* execution_context = ToExecutionContext(context);
+  if (!execution_context) {
+    return;
+  }
+  const CString source_url = execution_context->Url().GetString().Utf8();
+  if (source_url.empty()) {
+    return;
+  }
+  sink.CaptureGeneratedArtifact(
+      kind, capture_origin, StableExecutionContextId(*execution_context),
+      StableFrameId(*execution_context),
+      std::string_view(source_url.data(), source_url.length()), content);
+}
+
+void CaptureDynamicJavaScript(v8::Local<v8::Context> context,
+                              v8::Local<v8::String> source) {
+  reb::NativeProbeSink& sink = reb::NativeProbeSink::Get();
+  if (!sink.IsArtifactCaptureEnabled()) {
+    return;
+  }
+  v8::Isolate* isolate = context->GetIsolate();
+  const std::size_t utf8_size = source->Utf8Length(isolate);
+  if (utf8_size == 0 || utf8_size > reb::kNativeArtifactMaxContentBytes) {
+    return;
+  }
+  std::vector<std::uint8_t> content(utf8_size);
+  const std::size_t written = source->WriteUtf8(
+      isolate, reinterpret_cast<char*>(content.data()), content.size(),
+      v8::String::WriteFlags::kReplaceInvalidUtf8);
+  if (written != content.size()) {
+    return;
+  }
+  CaptureGeneratedSource(context, reb::NativeArtifactKind::kJavaScript,
+                         reb::NativeArtifactCaptureOrigin::kDynamicJavaScript,
+                         content);
+}
+
+void CaptureWasmModuleBytes(v8::Local<v8::Context> context,
+                            const v8::WasmModuleBytesOrigin origin,
+                            const std::uint8_t* bytes,
+                            const std::size_t size) {
+  const auto capture_origin =
+      origin == v8::WasmModuleBytesOrigin::kCompile
+          ? reb::NativeArtifactCaptureOrigin::kWebAssemblyCompile
+      : origin == v8::WasmModuleBytesOrigin::kModule
+          ? reb::NativeArtifactCaptureOrigin::kWebAssemblyModule
+          : reb::NativeArtifactCaptureOrigin::kWebAssemblyInstantiate;
+  CaptureGeneratedSource(context, reb::NativeArtifactKind::kWasm, capture_origin,
+                         UNSAFE_BUFFERS(base::span(bytes, size)));
+}
