+
+bool IsRebOnlyUseCounter(const v8::Isolate::UseCounterFeature feature) {
+  return feature >= v8::Isolate::kRebMathAcos &&
+         feature <= v8::Isolate::kRebDateGetTimezoneOffset;
+}
