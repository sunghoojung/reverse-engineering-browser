+}  // namespace
+
 void UseCounterCallback(v8::Isolate* isolate,
                         v8::Isolate::UseCounterFeature feature) {
   if (V8PerIsolateData::From(isolate)->IsUseCounterDisabled()) {
     return;
   }
 
+  const std::string_view runtime_operation = RuntimeFingerprintOperation(feature);
+  if (!runtime_operation.empty()) {
+    static std::array<std::atomic<std::uint64_t>, v8::Isolate::kUseCounterFeatureCount>
+        observed_sessions{};
+    const auto feature_index = static_cast<std::size_t>(feature);
+    reb::NativeProbeSink::Get().RecordApiCallOnce(reb::NativeProbeCategory::kRuntime,
+                                                   runtime_operation,
+                                                   observed_sessions[feature_index]);
+    if (IsRebOnlyUseCounter(feature)) {
+      return;
+    }
+  }
+
   std::optional<WebFeature> blink_feature;
   std::optional<WebDXFeature> webdx_feature;
   bool deprecated = false;
