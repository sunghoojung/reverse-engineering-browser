+void CaptureRuntimeBuffer(v8::Local<v8::Context> context,
+                          const v8::RuntimeBufferKind kind,
+                          const std::uint8_t* bytes,
+                          const std::size_t size) {
+  reb::NativeProbeSink& sink = reb::NativeProbeSink::Get();
+  if (!sink.IsVmCaptureEnabled()) {
+    return;
+  }
+  if (kind != v8::RuntimeBufferKind::kArrayBuffer &&
+      kind != v8::RuntimeBufferKind::kUint8Array &&
+      kind != v8::RuntimeBufferKind::kUint16Array &&
+      kind != v8::RuntimeBufferKind::kUint32Array) {
+    return;
+  }
+  if (bytes == nullptr || size == 0) {
+    return;
+  }
+  // Copy before Blink URL conversion. On-heap typed arrays can move if
+  // Utf8() allocates while the caller still holds DataPtr().
+  std::vector<std::uint8_t> retained(size);
+  std::copy(bytes, bytes + size, retained.begin());
+  ExecutionContext* execution_context = ToExecutionContext(context);
+  if (!execution_context) {
+    return;
+  }
+  const std::string source_url = execution_context->Url().GetString().Utf8();
+  if (source_url.empty()) {
+    return;
+  }
+  sink.CaptureRuntimeTypedArray(
+      StableExecutionContextId(*execution_context), StableFrameId(*execution_context),
+      std::string_view(source_url.data(), source_url.length()),
+      base::span<const std::uint8_t>(retained));
+}
