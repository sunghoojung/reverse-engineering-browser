+std::vector<WebConsoleListener> WebNode::ConsoleEventListeners(
+    v8::Isolate* isolate,
+    unsigned limit) const {
+  std::vector<WebConsoleListener> result;
+  Node* node = Unwrap<Node>();
+  unsigned types = 0;
+  for (const auto& type : node->EventTypes()) {
+    if (++types > limit)
+      break;
+    const auto* listeners = node->GetEventListeners(type);
+    if (!listeners)
+      continue;
+    for (const auto& registered : *listeners) {
+      if (result.size() >= limit)
+        return result;
+      if (registered->Removed())
+        continue;
+      auto* listener = DynamicTo<JSEventListener>(registered->Callback());
+      if (listener && !listener->GetWorldForInspector().IsMainWorld())
+        continue;
+      // JSEventListener::GetListenerObject directly returns CallbackObject.
+      // Other JSBasedEventListener implementations can compile inline code.
+      result.push_back({WebString(type),
+                        listener ? listener->GetListenerObject(*node)
+                                 : v8::Undefined(isolate).As<v8::Value>(),
+                        registered->Capture(), registered->Passive(),
+                        registered->Once()});
+    }
+  }
+  return result;
+}
+
+base::ScopedClosureRunner WebNode::AddConsoleEventListener(
+    const WebString& type,
+    base::RepeatingCallback<void(WebDOMEvent)> handler) {
+  class EventListener : public NativeEventListener {
+   public:
+    EventListener(Node* node,
+                  AtomicString event_type,
+                  base::RepeatingCallback<void(WebDOMEvent)> handler,
+                  bool use_capture)
+        : node_(node),
+          event_type_(event_type),
+          handler_(std::move(handler)),
+          use_capture_(use_capture) {}
+
+    void Invoke(ExecutionContext*, Event* event) override {
+      handler_.Run(WebDOMEvent(event));
+    }
+
+    void AddListener() {
+      node_->addEventListener(event_type_, this,
+                              /*use_capture=*/use_capture_);
+    }
+
+    void RemoveListener() {
+      node_->removeEventListener(event_type_, this,
+                                 /*use_capture=*/use_capture_);
+    }
+
+    void Trace(Visitor* visitor) const override {
+      NativeEventListener::Trace(visitor);
+      visitor->Trace(node_);
+    }
+
+   private:
+    Member<Node> node_;
+    AtomicString event_type_;
+    base::RepeatingCallback<void(WebDOMEvent)> handler_;
+    bool use_capture_ = false;
+  };
+
+  WebPrivatePtrForGC<EventListener> listener =
+      MakeGarbageCollected<EventListener>(Unwrap<Node>(), AtomicString(type),
+                                          std::move(handler),
+                                          /*use_capture=*/false);
+  listener->AddListener();
+  return base::ScopedClosureRunner(BindOnce(
+      &EventListener::RemoveListener, WrapWeakPersistent(listener.Get())));
+}
