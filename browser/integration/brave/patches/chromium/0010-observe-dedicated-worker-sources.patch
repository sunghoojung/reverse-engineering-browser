+reb::NativeWorkerText NativeWorkerSourceText(const String& text) {
+  if (text.empty()) {
+    return {};
+  }
+  return text.Is8Bit() ? reb::NativeWorkerText{text.Span8(), {}}
+                      : reb::NativeWorkerText{{}, text.Span16()};
+}
+
+void CaptureNativeDedicatedWorkerScript(ExecutionContext* context,
+                                       const ParkableString& source,
+                                       const String& url,
+                                       reb::NativeWorkerSourceKind kind) {
+  if (!reb::IsNativeWorkerSourceCaptureEnabled()) {
+    return;
+  }
+  if (!context || !context->IsDedicatedWorkerGlobalScope()) {
+    return;
+  }
+  const auto token_value = [](const auto& token) {
+    return reb::NativeWorkerToken{token.value().GetHighForSerialization(),
+                                 token.value().GetLowForSerialization()};
+  };
+  const auto worker = context->GetExecutionContextToken().Visit(token_value);
+  const auto now = static_cast<std::uint64_t>(
+      base::TimeTicks::Now().since_origin().InNanoseconds());
+  reb::NativeWorkerCaptureTicket ticket;
+  if (reb::BeginNativeWorkerSourceCapture(worker, now, ticket) !=
+      reb::NativeWorkerCaptureStatus::kAccepted) {
+    return;
+  }
+  const auto parent = context->GetParentExecutionContextToken();
+  // Never synchronously unpark a source or acquire its parking lock from a
+  // probe. Dedicated-worker sources are normally non-parkable; report an
+  // explicit gap if that changes instead of hiding blocking I/O in a hook.
+  const auto source_text = source.may_be_parked()
+                               ? reb::NativeWorkerText{{}, {}, true}
+                               : NativeWorkerSourceText(source.ToString());
+  static_cast<void>(reb::CaptureNativeWorkerSource(
+      ticket, parent ? parent->Visit(token_value) : reb::NativeWorkerToken{},
+      kind, source_text, NativeWorkerSourceText(url), now));
+}
