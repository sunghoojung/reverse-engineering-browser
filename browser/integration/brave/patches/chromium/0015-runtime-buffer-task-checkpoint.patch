+struct PendingRuntimeBuffer {
+  std::uint64_t generation = 0;
+  std::uint64_t execution_context_id = 0;
+  std::uint64_t frame_id = 0;
+  std::uint64_t script_id = 0;
+  bool is_eval = false;
+  std::size_t size = 0;
+  v8::Global<v8::Context> context;
+  v8::Global<v8::Value> buffer;
+  v8::Global<v8::String> source;
+  v8::Global<v8::String> name;
+};
+
+class RuntimeBufferSnapshots final : public V8PerIsolateData::UserData {
+ public:
+  explicit RuntimeBufferSnapshots(v8::Isolate* isolate) : isolate_(isolate) {}
+
+  void Enqueue(v8::Local<v8::Value> buffer,
+               std::size_t size,
+               std::size_t retained_buffer_size,
+               const v8::RuntimeBufferScript& allocator,
+               ExecutionContext& execution_context,
+               std::uint64_t generation) {
+    auto& sink = reb::NativeProbeSink::Get();
+    const auto context_id = StableExecutionContextId(execution_context);
+    const auto frame_id = StableFrameId(execution_context);
+    const auto script_id = static_cast<std::uint64_t>(allocator.script_id);
+    if (!sink.RuntimeBufferHasSignal(generation, context_id, frame_id, size,
+                                     script_id, allocator.is_eval))
+      return;
+    if (retained_buffer_size > reb::kNativeArtifactMaxContentBytes ||
+        !pending_.CanRetain(retained_buffer_size)) {
+      sink.RecordRuntimeBufferOmission(generation, frame_id,
+                                        "runtime_buffer_checkpoint_limit");
+      return;
+    }
+    if (allocator.name.IsEmpty() ||
+        allocator.name->Length() > static_cast<int>(reb::kNativeArtifactMaxUrlBytes) ||
+        allocator.name->Utf8Length(isolate_) > reb::kNativeArtifactMaxUrlBytes) {
+      sink.RecordRuntimeBufferOmission(generation, frame_id,
+                                        "allocating_script_url_unavailable");
+      return;
+    }
+    if (allocator.source->Length() >
+        static_cast<int>(reb::kNativeArtifactMaxContentBytes)) {
+      sink.RecordRuntimeBufferOmission(generation, frame_id,
+                                        "allocating_script_unavailable");
+      return;
+    }
+    const std::size_t source_bytes = allocator.source->Utf8Length(isolate_);
+    if (source_bytes == 0 ||
+        source_bytes > reb::kNativeArtifactMaxContentBytes ||
+        retained_buffer_size > reb::kNativeArtifactMaxContentBytes ||
+        !pending_.CanRetain(retained_buffer_size + source_bytes)) {
+      sink.RecordRuntimeBufferOmission(generation, frame_id,
+                                       "runtime_buffer_checkpoint_limit");
+      return;
+    }
+    PendingRuntimeBuffer pending;
+    pending.generation = generation;
+    pending.execution_context_id = context_id;
+    pending.frame_id = frame_id;
+    pending.script_id = script_id;
+    pending.is_eval = allocator.is_eval;
+    pending.size = size;
+    pending.context.Reset(isolate_, allocator.context);
+    pending.buffer.Reset(isolate_, buffer);
+    pending.source.Reset(isolate_, allocator.source);
+    if (!allocator.name.IsEmpty())
+      pending.name.Reset(isolate_, allocator.name);
+    pending_.Push(std::move(pending), retained_buffer_size + source_bytes);
+    if (!scheduled_) {
+      scheduled_ = true;
+      if (!base::SingleThreadTaskRunner::HasCurrentDefault() ||
+          !base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+              FROM_HERE, BindOnce(&RuntimeBufferSnapshots::Drain,
+                                  WrapWeakPersistent(this)))) {
+        Drop("runtime_buffer_checkpoint_unavailable");
+        scheduled_ = false;
+      }
+    }
+  }
+
+  void WillBeDestroyed() override {
+    // Release all V8 globals while the isolate is still alive. A queued weak
+    // task may survive teardown but must not dereference the disposed isolate.
+    Drop("runtime_buffer_checkpoint_unavailable");
+    isolate_ = nullptr;
+  }
+
+ private:
+  void Drop(std::string_view reason) {
+    pending_.Drain([&](PendingRuntimeBuffer pending) {
+      reb::NativeProbeSink::Get().RecordRuntimeBufferOmission(
+          pending.generation, pending.frame_id, reason);
+    });
+  }
+
+  void Drain() {
+    scheduled_ = false;
+    if (!isolate_)
+      return;
+    auto& sink = reb::NativeProbeSink::Get();
+    pending_.Drain([&](PendingRuntimeBuffer pending) {
+      // No handle access or byte copy after disable, expiry or session change.
+      if (pending.generation != sink.RuntimeCaptureGeneration())
+        return;
+      v8::HandleScope handle_scope(isolate_);
+      auto context = pending.context.Get(isolate_);
+      ScriptState* script_state = ScriptState::MaybeFrom(isolate_, context);
+      if (!script_state || !script_state->ContextIsValid()) {
+        sink.RecordRuntimeBufferOmission(pending.generation, pending.frame_id,
+                                         "runtime_buffer_context_destroyed");
+        return;
+      }
+      ExecutionContext* execution_context = ToExecutionContext(context);
+      if (!execution_context || execution_context->IsContextDestroyed() ||
+          StableExecutionContextId(*execution_context) !=
+              pending.execution_context_id) {
+        sink.RecordRuntimeBufferOmission(pending.generation, pending.frame_id,
+                                         "runtime_buffer_context_destroyed");
+        return;
+      }
+      auto value = pending.buffer.Get(isolate_);
+      v8::Local<v8::ArrayBuffer> buffer;
+      std::size_t offset = 0;
+      std::size_t size = 0;
+      if (value->IsArrayBuffer()) {
+        buffer = value.As<v8::ArrayBuffer>();
+        size = buffer->ByteLength();
+      } else if (value->IsUint8Array() || value->IsUint16Array() ||
+                 value->IsUint32Array()) {
+        auto view = value.As<v8::ArrayBufferView>();
+        buffer = view->Buffer();
+        offset = view->ByteOffset();
+        size = view->ByteLength();
+      } else {
+        sink.RecordRuntimeBufferOmission(pending.generation, pending.frame_id,
+                                         "runtime_buffer_checkpoint_invalid");
+        return;
+      }
+      auto backing = buffer->GetBackingStore();
+      if (buffer->WasDetached() || !backing || backing->IsShared() ||
+          backing->IsResizableByUserJavaScript() || size != pending.size ||
+          size < 32 || size > reb::kNativeArtifactMaxContentBytes ||
+          offset > backing->ByteLength() ||
+          size > backing->ByteLength() - offset) {
+        sink.RecordRuntimeBufferOmission(pending.generation, pending.frame_id,
+                                         "runtime_buffer_checkpoint_invalid");
+        return;
+      }
+      std::string source_url;
+      if (!pending.name.IsEmpty()) {
+        v8::String::Utf8Value name(isolate_, pending.name.Get(isolate_));
+        if (*name)
+          source_url.assign(*name, static_cast<std::size_t>(name.length()));
+      }
+      std::vector<std::uint8_t> source;
+      if (sink.RuntimeScriptSourceNeeded(pending.execution_context_id,
+                                         pending.script_id)) {
+        auto string = pending.source.Get(isolate_);
+        const std::size_t length = string->Utf8Length(isolate_);
+        source.resize(length);
+        if (string->WriteUtf8(
+                isolate_, reinterpret_cast<char*>(source.data()), length,
+                v8::String::WriteFlags::kReplaceInvalidUtf8) != length)
+          source.clear();
+      }
+      // Shared backing ownership stabilizes this pointer across host
+      // allocations. This samples the next task checkpoint, not "initialization
+      // complete".
+      const auto* bytes = static_cast<const std::uint8_t*>(backing->Data());
+      std::vector<std::uint8_t> retained(size);
+      UNSAFE_BUFFERS(
+          std::copy(bytes + offset, bytes + offset + size, retained.begin()));
+      reb::NativeRuntimeScript script{pending.script_id, pending.is_eval, source};
+      script.capture_generation = pending.generation;
+      sink.CaptureRuntimeTypedArray(pending.execution_context_id,
+                                    pending.frame_id, source_url, retained,
+                                    script);
+    });
+  }
+
+  v8::Isolate* isolate_;
+  bool scheduled_ = false;
+  reb::NativeRuntimeSnapshotQueue<PendingRuntimeBuffer> pending_;
+};
