+bool NativeWasmCallIndirectDispatchEnabled() {
+  // V8 calls this before frame walking or creating handles.
+  return reb::NativeProbeSink::Get().IsNativeWasmIndirectEnabled();
+}
+
+// Same document admission as CaptureWasmBrTableDispatch below. The slot and
+// resolved callee are physical table facts; no argument or memory is read.
+void CaptureWasmCallIndirectDispatch(
+    v8::Local<v8::Context> context,
+    const std::uint8_t* module_bytes,
+    const std::size_t module_size,
+    const std::uint32_t function_index,
+    const std::uint32_t module_byte_offset,
+    const std::uint32_t table_index,
+    const std::uint32_t slot,
+    const v8::WasmCallIndirectResolution resolution,
+    const std::uint32_t callee_function_index) {
+  reb::NativeProbeSink& sink = reb::NativeProbeSink::Get();
+  if (!sink.IsNativeWasmIndirectEnabled() || context.IsEmpty() ||
+      module_bytes == nullptr || module_size < 8 ||
+      module_size > reb::kNativeArtifactMaxContentBytes) {
+    return;
+  }
+  ExecutionContext* execution_context = ToExecutionContext(context);
+  if (!execution_context || execution_context->IsContextDestroyed()) {
+    return;
+  }
+  auto* window = DynamicTo<LocalDOMWindow>(execution_context);
+  if (!window || !window->GetFrame() || !window->document()) {
+    return;
+  }
+  reb::NativeWasmIndirectObservation observation;
+  observation.execution_context_id = StableExecutionContextId(*execution_context);
+  observation.header.frame_id = StableFrameId(*execution_context);
+  if (observation.execution_context_id == 0 || observation.header.frame_id == 0) {
+    return;
+  }
+  // Bound conversion work before allocating the UTF-8 copy, then bound bytes.
+  const String& url = execution_context->Url().GetString();
+  if (url.empty() || url.length() > reb::kNativeArtifactMaxUrlBytes) {
+    return;
+  }
+  const std::string source_url = url.Utf8();
+  if (source_url.empty() || source_url.size() > reb::kNativeArtifactMaxUrlBytes) {
+    return;
+  }
+  const base::UnguessableToken& document_token =
+      window->document()->Token().value();
+  observation.document_token_high = document_token.GetHighForSerialization();
+  observation.document_token_low = document_token.GetLowForSerialization();
+  observation.function_index = function_index;
+  observation.module_byte_offset = module_byte_offset;
+  observation.table_index = table_index;
+  observation.slot = slot;
+  observation.callee_function_index = callee_function_index;
+  observation.resolution =
+      static_cast<reb::NativeWasmIndirectResolution>(resolution);
+  observation.source_url = source_url;
+  observation.module_bytes =
+      UNSAFE_BUFFERS(base::span(module_bytes, module_size));
+  sink.RecordNativeWasmIndirect(observation);
+}
+
+bool NativeWasmBrTableDispatchEnabled() {
+  // V8 calls this before frame walking or creating handles.
+  return reb::NativeProbeSink::Get().IsNativeWasmDispatchEnabled();
+}
+
+void CaptureWasmBrTableDispatch(v8::Local<v8::Context> context,
+                               const std::uint8_t* module_bytes,
+                               const std::size_t module_size,
+                               const std::uint32_t function_index,
+                               const std::uint32_t module_byte_offset,
+                               const std::uint32_t selector,
+                               const std::uint32_t table_count) {
+  reb::NativeProbeSink& sink = reb::NativeProbeSink::Get();
+  if (!sink.IsNativeWasmDispatchEnabled() || context.IsEmpty() ||
+      module_bytes == nullptr || module_size < 8 ||
+      module_size > reb::kNativeArtifactMaxContentBytes) {
+    return;
+  }
+  ExecutionContext* execution_context = ToExecutionContext(context);
+  if (!execution_context || execution_context->IsContextDestroyed()) {
+    return;
+  }
+  // Only a live local document has the browser-side ownership needed here.
+  // Workers and other realms remain unsupported instead of being retargeted.
+  auto* window = DynamicTo<LocalDOMWindow>(execution_context);
+  if (!window || !window->GetFrame() || !window->document()) {
+    return;
+  }
+  const auto execution_context_id = StableExecutionContextId(*execution_context);
+  const auto frame_id = StableFrameId(*execution_context);
+  if (execution_context_id == 0 || frame_id == 0) {
+    return;
+  }
+  // Bound conversion work before allocating the UTF-8 copy, then bound bytes.
+  const String& url = execution_context->Url().GetString();
+  if (url.empty() || url.length() > reb::kNativeArtifactMaxUrlBytes) {
+    return;
+  }
+  const std::string source_url = url.Utf8();
+  if (source_url.empty() || source_url.size() > reb::kNativeArtifactMaxUrlBytes) {
+    return;
+  }
+  const base::UnguessableToken& document_token =
+      window->document()->Token().value();
+  sink.RecordNativeWasmDispatch(
+      execution_context_id, frame_id, source_url,
+      UNSAFE_BUFFERS(base::span(module_bytes, module_size)), function_index,
+      module_byte_offset, selector, table_count,
+      document_token.GetHighForSerialization(),
+      document_token.GetLowForSerialization());
+}
