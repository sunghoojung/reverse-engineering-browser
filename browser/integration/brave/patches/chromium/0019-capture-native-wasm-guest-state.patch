+// Epoch invalidation reaches isolates not entered during configuration.
+std::atomic<std::uint64_t> native_guest_reset_generation{1};
+std::uint64_t NativeWasmGuestEpoch() {
+  return native_guest_reset_generation.load(std::memory_order_acquire);
+}
+bool NativeWasmGuestEnabled() {
+  return reb::NativeProbeSink::Get().IsNativeWasmGuestEnabled();
+}
+void ResetNativeWasmGuest() noexcept {
+  native_guest_reset_generation.fetch_add(1, std::memory_order_acq_rel);
+  if (auto *isolate = v8::Isolate::TryGetCurrent())
+    isolate->ResetWasmGuestCapture();
+}
+bool AdmitNativeWasmGuestModule(v8::Local<v8::Context> context,
+                                const std::uint8_t *bytes, std::size_t size,
+                                std::uint32_t function_index) {
+  if (context.IsEmpty() || !bytes || size < 8 ||
+      size > reb::kNativeArtifactMaxContentBytes)
+    return false;
+  auto *execution = ToExecutionContext(context);
+  auto *window = execution ? DynamicTo<LocalDOMWindow>(execution) : nullptr;
+  if (!execution || execution->IsContextDestroyed() || !window ||
+      !window->GetFrame() || !window->document())
+    return false;
+  return reb::NativeProbeSink::Get().AdmitNativeWasmGuestModule(
+      UNSAFE_BUFFERS(base::span(bytes, size)), function_index);
+}
+bool CurrentNativeWasmGuest(std::uint32_t dispatcher,
+                            reb::NativeWasmGuestContext *output) noexcept {
+  auto *isolate = v8::Isolate::TryGetCurrent();
+  v8::WasmGuestContext state{};
+  if (!output || !isolate ||
+      !isolate->GetCurrentWasmGuestContext(dispatcher, &state))
+    return false;
+  *output = {state.instance_id,           state.invocation_id,
+             state.function_index,        state.module_byte_offset,
+             state.import_function_index, state.import_module_byte_offset};
+  return true;
+}
+
+void CaptureWasmGuestDispatch(v8::Local<v8::Context> context,
+                              const std::uint8_t *module_bytes,
+                              const std::size_t module_size,
+                              const v8::WasmGuestStateView &view) {
+  reb::NativeProbeSink &sink = reb::NativeProbeSink::Get();
+  const reb::NativeWasmGuestStateView state{
+      view.instance_id,        view.invocation_id,      view.function_index,
+      view.module_byte_offset, view.selector,           view.table_count,
+      view.accessor_context,   view.read_numeric_local, view.copy_memory};
+  // Revoke the preceding configured-site parent before any metadata rejection.
+  sink.InvalidateNativeWasmGuest(state);
+  if (!sink.IsNativeWasmGuestEnabled() || context.IsEmpty() ||
+      module_bytes == nullptr || module_size < 8 ||
+      module_size > reb::kNativeArtifactMaxContentBytes) {
+    return;
+  }
+  ExecutionContext *execution_context = ToExecutionContext(context);
+  if (!execution_context || execution_context->IsContextDestroyed()) {
+    return;
+  }
+  // Only a live local document has the browser-side ownership needed here.
+  // Workers and other realms remain unsupported instead of being retargeted.
+  auto *window = DynamicTo<LocalDOMWindow>(execution_context);
+  if (!window || !window->GetFrame() || !window->document()) {
+    return;
+  }
+  const auto execution_context_id =
+      StableExecutionContextId(*execution_context);
+  const auto frame_id = StableFrameId(*execution_context);
+  if (execution_context_id == 0 || frame_id == 0) {
+    return;
+  }
+  // Bound conversion work before allocating the UTF-8 copy, then bound bytes.
+  const String &url = execution_context->Url().GetString();
+  if (url.empty() || url.length() > reb::kNativeArtifactMaxUrlBytes) {
+    return;
+  }
+  const std::string source_url = url.Utf8();
+  if (source_url.empty() ||
+      source_url.size() > reb::kNativeArtifactMaxUrlBytes) {
+    return;
+  }
+  const base::UnguessableToken &document_token =
+      window->document()->Token().value();
+  sink.RecordNativeWasmGuest(
+      execution_context_id, frame_id, source_url,
+      UNSAFE_BUFFERS(base::span(module_bytes, module_size)), state,
+      document_token.GetHighForSerialization(),
+      document_token.GetLowForSerialization());
+}
