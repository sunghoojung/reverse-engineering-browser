+
+// Main isolate only. A worker isolate is not process-lifetime, so a delayed
+// task must not keep its pointer. RequestInterrupt is not
+// TerminateExecution. One posted task is enough: a later call reschedules
+// it from the interrupt callback instead of queueing a task per call.
+std::atomic<v8::Isolate*> g_reb_main_wasm_isolate{nullptr};
+std::atomic<bool> g_reb_wasm_deadline_posted{false};
+
+void RequestMainIsolateStackCheck() noexcept;
+void FireWasmDeadline() noexcept;
+
+void PostWasmDeadline(base::TimeDelta delay) {
+  if (g_reb_wasm_deadline_posted.exchange(true, std::memory_order_acq_rel)) {
+    return;
+  }
+  base::ThreadPool::PostDelayedTask(FROM_HERE, base::BindOnce(&FireWasmDeadline),
+                                    delay);
+}
+
+void ReconsiderWasmDeadline(v8::Isolate*, void*) {
+  // Runs on the isolate thread after the stack-guard runtime has polled.
+  // No V8 handles. The delay is the time still left on this thread's call.
+  const auto delay = reb::NativeProbeSink::Get().WasmExecutionNudgeDelayNs();
+  if (delay == reb::kNativeWasmExecutionNoNudge) {
+    return;
+  }
+  PostWasmDeadline(base::Nanoseconds(static_cast<int64_t>(delay)));
+}
+
+void RequestMainIsolateStackCheck() noexcept {
+  v8::Isolate* isolate =
+      g_reb_main_wasm_isolate.load(std::memory_order_acquire);
+  if (isolate == nullptr) {
+    return;
+  }
+  isolate->RequestInterrupt(&ReconsiderWasmDeadline, nullptr);
+}
+
+void FireWasmDeadline() noexcept {
+  g_reb_wasm_deadline_posted.store(false, std::memory_order_release);
+  RequestMainIsolateStackCheck();
+}
+
+void ArmWasmDeadlineNudge() { PostWasmDeadline(base::Seconds(5)); }
+
+void NoteWasmExecutionEntered(bool outermost,
+                              bool function_known,
+                              std::uint32_t function_index) {
+  if (!reb::NativeProbeSink::Get().NoteWasmHostCallEntered(
+          outermost, function_known, function_index)) {
+    return;
+  }
+  if (v8::Isolate::GetCurrent() ==
+      g_reb_main_wasm_isolate.load(std::memory_order_acquire)) {
+    ArmWasmDeadlineNudge();
+  }
+}
+
+void NoteWasmExecutionExited(bool tail) {
+  auto& sink = reb::NativeProbeSink::Get();
+  if (tail) {
+    sink.NoteWasmTailCall();
+  } else {
+    sink.NoteWasmHostCallReturned();
+  }
+}
