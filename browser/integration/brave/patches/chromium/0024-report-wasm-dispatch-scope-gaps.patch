+// Scope only: no function index, offset, selector, or sample.
+void NoteWasmDispatchScope(v8::WasmDispatchScope scope, bool call_indirect) {
+  reb::NativeWasmScopeGap gap = reb::NativeWasmScopeGap::kWorker;
+  switch (scope) {
+    case v8::WasmDispatchScope::kJitless:
+      gap = reb::NativeWasmScopeGap::kJitless;
+      break;
+    case v8::WasmDispatchScope::kLeftLiftoff:
+      gap = reb::NativeWasmScopeGap::kLeftLiftoff;
+      break;
+    default:
+      return;
+  }
+  const bool recorded =
+      call_indirect
+          ? reb::NativeProbeSink::Get().NoteNativeWasmIndirectScope(gap)
+          : reb::NativeProbeSink::Get().NoteNativeWasmDispatchScope(gap);
+  // A drain before the session can admit this notice must not drop it.
+  if (!recorded) v8::Isolate::RememberRebWasmDispatchScope(scope, call_indirect);
+}
+
+void ProbeWasmDispatchLimits() noexcept {
+  // A TurboFan publication on a thread with no current isolate is remembered
+  // until this isolate thread can deliver it. Nothing here is a sample.
+  v8::Isolate::DrainRebWasmDispatchScope();
+  if (!v8::Isolate::IsRebWasmJitless()) {
+    return;
+  }
+  if (v8::Isolate::IsRebWasmBrTableDispatch()) {
+    reb::NativeProbeSink::Get().NoteNativeWasmDispatchScope(
+        reb::NativeWasmScopeGap::kJitless);
+  }
+  if (v8::Isolate::IsRebWasmCallIndirectDispatch()) {
+    reb::NativeProbeSink::Get().NoteNativeWasmIndirectScope(
+        reb::NativeWasmScopeGap::kJitless);
+  }
+}
