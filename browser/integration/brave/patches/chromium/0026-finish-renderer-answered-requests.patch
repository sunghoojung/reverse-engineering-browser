+reb::NativeRendererRequest RecordNativeDataUrlStart(
+    const ResourceRequestHead& request) {
+  if (!reb::NativeProbeSink::Get().IsCaptureArmed()) [[likely]] {
+    return {};
+  }
+  return reb::NativeProbeSink::Get().RecordRequestInitiated(
+      GenerateRequestId(), request.HttpMethod().Utf8(), url::kDataScheme, "");
+}
+
+void FinishNativeDataUrl(reb::NativeRendererRequest& request,
+                         const KURL& url,
+                         int error,
+                         int64_t size) {
+  if (!request.recorded()) {
+    return;
+  }
+  if (error == net::OK) {
+    request.NoteResponse(200, false, false);
+  }
+  // The target is everything after "data:"; only its prefix is copied.
+  const String& spec = url.GetString().GetString();
+  const wtf_size_t offset = std::min<wtf_size_t>(spec.length(), 5);
+  const std::string prefix = spec.subview(offset, 116).Utf8();
+  reb::NativeProbeSink::Get().RecordRendererRequestComplete(
+      request, prefix, spec.length() - offset, -1, error, size, size);
+  request = {};
+}
