 namespace blink {
 
+reb::NativeFetchOwner BaseFetchContext::GetNativeFetchOwner() const {
+  const ExecutionContext* const context = GetExecutionContext();
+  if (!context) {
+    return {};
+  }
+  const ExecutionContextToken token = context->GetExecutionContextToken();
+  const base::UnguessableToken& value = token.value();
+  reb::NativeLoaderKind kind = reb::NativeLoaderKind::kOtherContext;
+  if (token.Is<LocalFrameToken>()) {
+    kind = reb::NativeLoaderKind::kDocument;
+  } else if (token.Is<DedicatedWorkerToken>()) {
+    kind = reb::NativeLoaderKind::kDedicatedWorker;
+  } else if (token.Is<SharedWorkerToken>()) {
+    kind = reb::NativeLoaderKind::kSharedWorker;
+  } else if (token.Is<ServiceWorkerToken>()) {
+    kind = reb::NativeLoaderKind::kServiceWorker;
+  }
+  return {kind, reb::NativeContextFold(value.GetHighForSerialization(),
+                                       value.GetLowForSerialization())};
+}
