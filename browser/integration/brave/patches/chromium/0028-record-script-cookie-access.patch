+// The frame whose cookie jar script used, as every native record names it.
+uint64_t NativeScriptCookieFrameId(const Document& document) {
+  const LocalFrame* const frame = document.GetFrame();
+  if (!frame) {
+    return 0;
+  }
+  const LocalFrameToken token = frame->GetLocalFrameToken();
+  return ::reb::NativeFrameIdOf(token.value().GetHighForSerialization(),
+                                token.value().GetLowForSerialization());
+}
