+// Request initiator stacks, protocol/native-network-v3.md. V8 fills a buffer
+// owned here; the sink copies identities and never calls back into V8.
+std::array<v8::NativeStackFrame, reb::kNativeRequestStackFrameCapacity>&
+NativeStackFrames() {
+  static base::NoDestructor<
+      std::array<v8::NativeStackFrame, reb::kNativeRequestStackFrameCapacity>>
+      frames;
+  return *frames;
+}
+
+struct NativeRequestStackCall {
+  reb::NativeRequestStackWalk& walk;
+  v8::Isolate* isolate;
+};
+
+bool NativeStackScriptNeeded(void* data, int script_id) {
+  return script_id > 0 &&
+         static_cast<NativeRequestStackCall*>(data)->walk.ScriptNeeded(
+             static_cast<std::uint32_t>(script_id));
+}
+
+void NativeStackFramesReady(void* data, const v8::NativeStackCapture& capture) {
+  reb::NativeRequestStackWalk& walk =
+      static_cast<NativeRequestStackCall*>(data)->walk;
+  const base::span<reb::NativeStackFrame> out = walk.frames();
+  const auto& in = NativeStackFrames();
+  const auto copy = [&](const std::size_t from, const std::size_t count) {
+    for (std::size_t i = from; i < from + count && i < out.size(); ++i) {
+      out[i].kind = static_cast<std::uint8_t>(in[i].kind);
+      out[i].flags = in[i].flags;
+      out[i].combinator = in[i].combinator;
+      out[i].script_id = in[i].script_id;
+      out[i].position = in[i].position;
+      out[i].detail = in[i].detail;
+    }
+  };
+  copy(0, capture.recorded);
+  copy(capture.sync_capacity, capture.async_frames);
+  walk.FramesReady(capture.total_depth, capture.recorded, capture.omitted,
+                   capture.async_frames, capture.async_truncated);
+}
+
+std::string NativeStackUtf8(v8::Isolate* isolate, v8::Local<v8::String> text,
+                            const std::size_t limit) {
+  const std::size_t size = text->Utf8Length(isolate);
+  if (size == 0 || size > limit) {
+    return {};
+  }
+  std::string out(size, '\0');
+  const std::size_t written = text->WriteUtf8(
+      isolate, out.data(), out.size(),
+      v8::String::WriteFlags::kReplaceInvalidUtf8);
+  return written == size ? out : std::string();
+}
+
+void NativeStackScriptDescribed(void* data, const v8::NativeStackScript& script) {
+  auto& call = *static_cast<NativeRequestStackCall*>(data);
+  // A walk with no admitted record keeps nothing, so skip the UTF-8 conversion.
+  if (!call.walk.has_admitted_record()) {
+    return;
+  }
+  ExecutionContext* execution_context =
+      script.context.IsEmpty() ? nullptr : ToExecutionContext(script.context);
+  if (!execution_context || script.script_id <= 0) {
+    return;
+  }
+  reb::NativeStackScriptSource source;
+  source.script_id = static_cast<std::uint32_t>(script.script_id);
+  source.kind = script.is_wasm ? reb::NativeScriptIdentityKind::kWasm
+                               : reb::NativeScriptIdentityKind::kJavaScript;
+  source.is_eval = script.is_eval;
+  source.start_line = static_cast<std::uint32_t>(std::max(script.line_offset, 0));
+  source.start_column =
+      static_cast<std::uint32_t>(std::max(script.column_offset, 0));
+  source.execution_context_id = StableExecutionContextId(*execution_context);
+  // An inline or eval script has no name of its own; its document names it.
+  std::string url;
+  if (!script.name.IsEmpty() && script.name->IsString()) {
+    url = NativeStackUtf8(call.isolate, script.name.As<v8::String>(),
+                          reb::kNativeArtifactMaxUrlBytes);
+  }
+  if (url.empty()) {
+    url = execution_context->Url().GetString().Utf8();
+  }
+  source.url = url;
+  std::string text;
+  if (script.is_wasm) {
+    if (script.wire_bytes_size > reb::kNativeScriptIdentityMaxSourceBytes) {
+      source.too_large = true;
+      source.too_large_length = script.wire_bytes_size;
+    } else if (script.wire_bytes) {
+      // V8 keeps the module alive for this call.
+      const base::span<const std::uint8_t> bytes = UNSAFE_BUFFERS(
+          base::span(script.wire_bytes, script.wire_bytes_size));
+      source.bytes = bytes;
+    }
+  } else if (!script.source.IsEmpty()) {
+    const std::size_t size = script.source->Utf8Length(call.isolate);
+    if (size > reb::kNativeScriptIdentityMaxSourceBytes) {
+      source.too_large = true;
+      source.too_large_length = size;
+    } else {
+      text = NativeStackUtf8(call.isolate, script.source,
+                             reb::kNativeScriptIdentityMaxSourceBytes);
+      const base::span<const std::uint8_t> bytes = base::as_byte_span(text);
+      source.bytes = bytes;
+    }
+  }
+  call.walk.DescribeScript(source);
+}
+
+reb::NativeRequestStackWalkResult WalkNativeRequestStack(
+    reb::NativeRequestStackWalk& walk) {
+  if (!IsMainThread()) {
+    return reb::NativeRequestStackWalkResult::kUnsupportedThread;
+  }
+  v8::Isolate* const isolate = v8::Isolate::TryGetCurrent();
+  if (!isolate || !isolate->InContext()) {
+    return reb::NativeRequestStackWalkResult::kNoScript;
+  }
+  v8::HandleScope scope(isolate);
+  if (ExecutionContext* execution_context =
+          ToExecutionContext(isolate->GetCurrentContext())) {
+    walk.SetExecutionContext(StableExecutionContextId(*execution_context));
+  }
+  NativeRequestStackCall call{walk, isolate};
+  v8::NativeStackCapture capture;
+  capture.frames = NativeStackFrames().data();
+  capture.sync_capacity = reb::kNativeRequestStackSyncLimit;
+  capture.async_capacity = reb::kNativeRequestStackAsyncLimit;
+  v8::NativeStackCallbacks callbacks;
+  callbacks.data = &call;
+  callbacks.script_needed = NativeStackScriptNeeded;
+  callbacks.frames = NativeStackFramesReady;
+  callbacks.script = NativeStackScriptDescribed;
+  return v8::CaptureNativeStack(isolate, capture, callbacks)
+             ? reb::NativeRequestStackWalkResult::kWalked
+             : reb::NativeRequestStackWalkResult::kNoScript;
+}
