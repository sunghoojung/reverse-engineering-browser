+// A Console timer watch; see protocol/native-debugger-observation-v1.md.
+void ObserveNativeTimer(ExecutionContext* context,
+                        ScheduledAction& action,
+                        bool fired,
+                        bool interval,
+                        int timeout_id,
+                        base::TimeDelta delay) {
+  const std::uint64_t frame_id = reb::debugger_observation::FrameId(context);
+  if (!reb::NativeDebuggerWatch::Wants(frame_id, reb::kNativeWatchTimers)) {
+    return;
+  }
+  CallbackFunctionBase* callback = action.CallbackFunction();
+  reb::NativeStackFrame frame;
+  if (callback) {
+    v8::HandleScope scope(callback->GetIsolate());
+    frame = reb::debugger_observation::FunctionFrame(callback->CallbackObject());
+  }
+  reb::NativeDebuggerWatch::Timer(
+      frame_id, fired, interval, !callback, static_cast<std::uint32_t>(timeout_id),
+      static_cast<std::uint32_t>(std::clamp<int64_t>(
+          delay.InMilliseconds(), 0, std::numeric_limits<std::uint32_t>::max())),
+      frame);
+}
