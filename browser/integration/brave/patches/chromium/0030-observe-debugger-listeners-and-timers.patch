+  } else if (target->ToLocalDOMWindow()) {
+    kind = 3;
+  }
+  reb::NativeDebuggerWatch::Listener(
+      frame_id, reb::debugger_observation::Latin1(event.type()), kind,
+      node_type, reb::debugger_observation::FunctionFrame(listener));
