+// A Console CSP watch; see protocol/native-debugger-observation-v1.md.
+void ObserveNativeCspViolation(ExecutionContext* context,
+                               const SecurityPolicyViolationEventInit& data) {
+  const std::uint64_t frame_id = reb::debugger_observation::FrameId(context);
+  if (!reb::NativeDebuggerWatch::Wants(frame_id, reb::kNativeWatchCsp)) {
+    return;
+  }
+  const KURL blocked(data.blockedURI());
+  reb::NativeDebuggerWatch::Csp(
+      frame_id,
+      static_cast<std::uint8_t>(
+          ContentSecurityPolicy::GetDirectiveType(data.effectiveDirective())),
+      data.disposition().AsEnum() ==
+          V8SecurityPolicyViolationEventDisposition::Enum::kReport,
+      reb::debugger_observation::Latin1(blocked.IsValid() ? blocked.Host()
+                                                          : StringView()));
+}
