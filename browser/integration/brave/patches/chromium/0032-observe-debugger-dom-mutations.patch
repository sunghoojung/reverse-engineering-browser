+  for (std::size_t depth = 0;
+       ancestor && depth < reb::kNativeWatchAncestorLimit;
+       ++depth, ancestor = ancestor->parentNode()) {
+    const int slot = reb::NativeDebuggerWatch::DomSlot(
+        DOMNodeIds::ExistingIdForNode(ancestor), reb::kNativeWatchSubtree);
+    if (slot >= 0) {
+      reb::NativeDebuggerWatch::Mutation(frame_id, reb::kNativeWatchSubtree,
+                                         slot, node_type, {});
+      return;
+    }
+  }
