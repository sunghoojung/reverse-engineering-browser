+// A Console DOM watch; see protocol/native-debugger-observation-v1.md. A
+// removal names the watched node itself, else the nearest watched ancestor.
+void ObserveNativeDomMutation(const ContainerNode& parent,
+                              const Node& child,
+                              bool removal) {
+  const std::uint64_t frame_id = reb::debugger_observation::FrameId(
+      parent.GetDocument().GetExecutionContext());
+  if (!reb::NativeDebuggerWatch::Wants(frame_id, reb::kNativeWatchDom)) {
+    return;
+  }
