+  if (removal) {
+    const int slot = reb::NativeDebuggerWatch::DomSlot(
+        DOMNodeIds::ExistingIdForNode(&child), reb::kNativeWatchRemoval);
+    if (slot >= 0) {
+      reb::NativeDebuggerWatch::Mutation(frame_id, reb::kNativeWatchRemoval,
+                                         slot, node_type, {});
+      return;
+    }
+  }
