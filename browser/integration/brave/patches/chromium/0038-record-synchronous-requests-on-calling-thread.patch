+reb::NativeRendererRequest RecordNativeRequestStart(
+    const int request_id,
+    const network::ResourceRequest& request) {
+  const reb::NativeRendererRequest start =
+      reb::NativeProbeSink::Get().RecordRequestInitiated(
+          request_id, request.method, request.url.scheme(), request.url.host());
