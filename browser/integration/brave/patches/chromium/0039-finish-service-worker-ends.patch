+// The browser proxy never sees a request this loader keeps from the network,
+// so the renderer finishes one it ends without a response; see
+// protocol/native-network-v3.md.
+void RecordNativeServiceWorkerEnd(int32_t request_id,
+                                  const GURL& url,
+                                  int error_code) {
+  const std::string_view target = url.PathForRequestPiece();
+  reb::NativeProbeSink::Get().RecordServiceWorkerRequestEnd(
+      request_id, target, target.size(), url.IntPort(), error_code);
+}
