+// A load Blink answers from a resource it holds makes no request; see
+// protocol/native-network-v3.md. The sink admits the reuse before anything is
+// converted, and only bounded prefixes are copied, since a data: URL can be
+// megabytes long.
+void RecordNativeMemoryCacheReuse(const FetchContext& context,
+                                  const Resource& resource,
+                                  const ResourceRequest& request,
+                                  const bool is_static_data) {
+  reb::NativeProbeSink& sink = reb::NativeProbeSink::Get();
+  if (!sink.IsCaptureArmed()) [[likely]] {
+    return;
+  }
+  const reb::NativeMemoryCacheAdmission admission =
+      sink.AdmitMemoryCacheReuse(context.IsOrdinaryPageForNativeCapture());
+  if (!admission.admitted()) {
+    return;
+  }
+  const KURL& url = request.Url();
+  const AtomicString& spec = url.GetString();
+  const url::Parsed& parsed = url.GetParsed();
+  const reb::NativeTargetRange range = reb::NativeRequestTargetRange(
+      spec.length(), parsed.path.begin, parsed.path.len, parsed.query.begin,
+      parsed.query.len, parsed.ref.begin, parsed.ref.len);
+  std::string target;
+  if (admission.capture_request_content) {
+    target = StringView(spec, static_cast<wtf_size_t>(range.begin),
+                        static_cast<wtf_size_t>(std::min(
+                            range.length, reb::kNativeRequestTargetPrefixBytes)))
+                 .Utf8();
+  }
+  // One byte past the 120 the record keeps tells the sink the host is longer.
+  const StringView host_view = url.Host();
+  const std::string host =
+      StringView(host_view, 0,
+                 std::min<wtf_size_t>(
+                     host_view.length(),
+                     static_cast<wtf_size_t>(
+                         reb::kNativeMemoryCacheReuseHostSize + 1)))
+          .Utf8();
+  const std::string scheme = url.Protocol().Utf8();
+  reb::NativeMemoryCacheReuse reuse;
+  reuse.request_id = GenerateRequestId();
+  reuse.owner = context.GetNativeFetchOwner();
+  reuse.scheme = scheme;
+  reuse.host = host;
+  reuse.target = target;
+  reuse.target_length = range.length;
+  reuse.port = url.Port();
+  reuse.resource_type = static_cast<std::uint8_t>(resource.GetType());
+  reuse.static_data = is_static_data;
+  reuse.status_code = resource.GetResponse().HttpStatusCode();
+  reuse.decoded_body_length = resource.GetResponse().DecodedBodyLength();
+  sink.RecordMemoryCacheReuse(admission, reuse);
+}
