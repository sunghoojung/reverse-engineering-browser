+// A load Blink answers from a resource it holds makes no request; see
+// protocol/native-network-v3.md. Only bounded prefixes are copied, since a
+// data: URL can be megabytes long.
+void RecordNativeMemoryCacheReuse(const FetchContext& context,
+                                  const Resource& resource,
+                                  const ResourceRequest& request,
+                                  const bool is_static_data) {
+  if (!reb::NativeProbeSink::Get().IsCaptureArmed()) [[likely]] {
+    return;
+  }
+  const KURL& url = request.Url();
+  const AtomicString& spec = url.GetString();
+  const url::Parsed& parsed = url.GetParsed();
+  // The path and query without the fragment, as GURL::PathForRequestPiece.
+  const unsigned begin = parsed.path.is_valid()
+                             ? static_cast<unsigned>(parsed.path.begin)
+                             : spec.length();
+  const unsigned end =
+      parsed.ref.is_valid()
+          ? static_cast<unsigned>(parsed.ref.begin - 1)
+          : static_cast<unsigned>(parsed.query.is_valid() ? parsed.query.end()
+                                                          : parsed.path.end());
+  const unsigned target_length = end > begin ? end - begin : 0;
+  const std::string target =
+      StringView(spec, begin, std::min(target_length, 116u)).Utf8();
+  // One byte past the 120 the record keeps tells the sink the host is longer.
+  const StringView host_view = url.Host();
+  const std::string host =
+      StringView(host_view, 0, std::min(host_view.length(), 121u)).Utf8();
+  const std::string scheme = url.Protocol().Utf8();
+  reb::NativeMemoryCacheReuse reuse;
+  reuse.request_id = GenerateRequestId();
+  reuse.owner = context.GetNativeFetchOwner();
+  reuse.scheme = scheme;
+  reuse.host = host;
+  reuse.target = target;
+  reuse.target_length = target_length;
+  reuse.port = url.Port();
+  reuse.resource_type = static_cast<std::uint8_t>(resource.GetType());
+  reuse.static_data = is_static_data;
+  reuse.status_code = resource.GetResponse().HttpStatusCode();
+  reuse.decoded_body_length = resource.GetResponse().DecodedBodyLength();
+  reb::NativeProbeSink::Get().RecordMemoryCacheReuse(reuse);
+}
