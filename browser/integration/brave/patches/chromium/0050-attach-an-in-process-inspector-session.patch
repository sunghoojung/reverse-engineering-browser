+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/public/web/web_native_debugger.h"
+
+#include <memory>
+#include <utility>
+
+#include "base/functional/callback.h"
+#include "third_party/blink/renderer/core/exported/web_dev_tools_agent_impl.h"
+#include "third_party/blink/renderer/core/frame/local_frame.h"
+#include "third_party/blink/renderer/core/frame/web_local_frame_impl.h"
+#include "third_party/blink/renderer/core/inspector/inspector_task_runner.h"
+#include "third_party/blink/renderer/core/inspector/main_thread_debugger.h"
+#include "third_party/blink/renderer/core/inspector/v8_inspector_string.h"
+#include "third_party/blink/renderer/core/page/page.h"
+#include "third_party/blink/renderer/platform/heap/garbage_collected.h"
+#include "third_party/blink/renderer/platform/heap/persistent.h"
+#include "third_party/blink/renderer/platform/scheduler/public/agent_group_scheduler.h"
+#include "third_party/blink/renderer/platform/wtf/functional.h"
+#include "v8/include/v8-inspector.h"
+
+namespace blink {
+
+namespace {
+
+// V8 keeps a cppgc Persistent on a ManagedChannel for as long as its session
+// lives, which is the ownership `connectShared` asks for: a session whose
+// destruction V8 defers, because a dispatch is still on the stack, can answer
+// through the channel after the embedder has let go of it. The embedder's
+// client goes away first, so the channel is detached from it rather than
+// freed with it. DevToolsSession is a ManagedChannel for the same reason.
+class NativeDebuggerChannel final
+    : public v8_inspector::V8Inspector::ManagedChannel {
+ public:
+  explicit NativeDebuggerChannel(WebNativeDebugger::Client* client)
+      : client_(client) {}
+
+  // After this, a response V8 still had in flight is dropped instead of
+  // reaching a client that no longer exists.
+  void Detach() { client_ = nullptr; }
+
+  void sendResponse(
+      int call_id,
+      std::unique_ptr<v8_inspector::StringBuffer> message) override {
+    Send(message.get());
+  }
+  void sendNotification(
+      std::unique_ptr<v8_inspector::StringBuffer> message) override {
+    Send(message.get());
+  }
+  void flushProtocolNotifications() override {}
+
+ private:
+  void Send(v8_inspector::StringBuffer* message) {
+    if (!client_ || !message) {
+      return;
+    }
+    const std::string text = ToCoreString(message->string()).Utf8();
+    client_->OnInspectorMessage(text);
+  }
+
+  // Off-heap and owned by the embedder, which detaches this channel before
+  // the client is destroyed, so this is never traced.
+  WebNativeDebugger::Client* client_ = nullptr;
+};
+
+class NativeDebuggerSession final : public WebNativeDebugger {
+ public:
+  NativeDebuggerSession(
+      NativeDebuggerChannel* channel,
+      std::shared_ptr<v8_inspector::V8InspectorSession> session)
+      : channel_(channel), session_(std::move(session)) {}
+
+  ~NativeDebuggerSession() override {
+    // The client is going away with this object. The V8 session may outlive
+    // both, so the channel, which V8 still owns, stops calling the client.
+    channel_->Detach();
+  }
+
+  void Dispatch(std::string_view message) override {
+    // V8's own 8 bit view of the bytes; the inspector answers in the same
+    // encoding, which is why the channel converts back from a StringBuffer.
+    session_->dispatchProtocolMessage(v8_inspector::StringView(
+        reinterpret_cast<const uint8_t*>(message.data()), message.size()));
+  }
+
+ private:
+  const Persistent<NativeDebuggerChannel> channel_;
+  // Shared, because V8 defers session destruction while a dispatch is still
+  // on the stack, which is what a detach during a pause needs.
+  const std::shared_ptr<v8_inspector::V8InspectorSession> session_;
+};
+
+class NativeDebuggerPoster final : public WebNativeDebuggerPoster {
+ public:
+  explicit NativeDebuggerPoster(scoped_refptr<InspectorTaskRunner> runner)
+      : runner_(std::move(runner)) {}
+
+  bool Post(bool interrupt, base::OnceClosure task) override {
+    CrossThreadOnceClosure closure(std::move(task));
+    return interrupt ? runner_->AppendTask(std::move(closure))
+                     : runner_->AppendTaskDontInterrupt(std::move(closure));
+  }
+
+ private:
+  ~NativeDebuggerPoster() override = default;
+
+  const scoped_refptr<InspectorTaskRunner> runner_;
+};
+
+// An inspector session and the task runner that reaches a paused thread both
+// belong to the local root, so a same-process iframe resolves to its root
+// rather than being refused.
+LocalFrame* LocalRootOf(WebLocalFrame* web_frame) {
+  // Dynamic, because the caller is allowed to hand this a frame it has not
+  // checked: To<> would CHECK instead of answering null.
+  auto* impl = DynamicTo<WebLocalFrameImpl>(web_frame);
+  if (!impl) {
+    return nullptr;
+  }
+  LocalFrame* frame = impl->GetFrame();
+  if (!frame) {
+    return nullptr;
+  }
+  LocalFrame& root = frame->LocalFrameRoot();
+  return root.GetPage() ? &root : nullptr;
+}
+
+}  // namespace
+
+std::unique_ptr<WebNativeDebugger> WebNativeDebugger::Attach(
+    WebLocalFrame* web_frame,
+    Client* client) {
+  LocalFrame* frame = LocalRootOf(web_frame);
+  if (!frame || !client) {
+    return nullptr;
+  }
+  v8::Isolate* isolate = frame->GetPage()->GetAgentGroupScheduler().Isolate();
+  // Without a client message loop, MainThreadDebugger::runMessageLoopOnPause
+  // returns at once and the page never actually stops.
+  WebDevToolsAgentImpl::EnsureMainThreadPauseLoop(isolate);
+  MainThreadDebugger* debugger = MainThreadDebugger::Instance(isolate);
+  v8_inspector::V8Inspector* inspector = debugger->GetV8Inspector();
+  if (!inspector) {
+    return nullptr;
+  }
+  auto* channel = MakeGarbageCollected<NativeDebuggerChannel>(client);
+  std::shared_ptr<v8_inspector::V8InspectorSession> session =
+      inspector->connectShared(
+          debugger->ContextGroupId(frame), channel,
+          v8_inspector::StringView(),
+          v8_inspector::V8Inspector::kFullyTrusted,
+          v8_inspector::V8Inspector::kNotWaitingForDebugger);
+  if (!session) {
+    return nullptr;
+  }
+  return std::make_unique<NativeDebuggerSession>(channel, std::move(session));
+}
+
+scoped_refptr<WebNativeDebuggerPoster> WebNativeDebugger::Poster(
+    WebLocalFrame* web_frame) {
+  LocalFrame* frame = LocalRootOf(web_frame);
+  if (!frame) {
+    return nullptr;
+  }
+  scoped_refptr<InspectorTaskRunner> runner = frame->GetInspectorTaskRunner();
+  if (!runner) {
+    return nullptr;
+  }
+  return base::MakeRefCounted<NativeDebuggerPoster>(std::move(runner));
+}
+
+}  // namespace blink
