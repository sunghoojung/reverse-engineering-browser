+#ifndef THIRD_PARTY_BLINK_PUBLIC_WEB_WEB_NATIVE_DEBUGGER_H_
+#define THIRD_PARTY_BLINK_PUBLIC_WEB_WEB_NATIVE_DEBUGGER_H_
+
+#include <memory>
+#include <string_view>
+
+#include "base/functional/callback_forward.h"
+#include "base/memory/ref_counted.h"
+#include "base/memory/scoped_refptr.h"
+#include "third_party/blink/public/platform/web_common.h"
+
+namespace blink {
+
+class WebLocalFrame;
+
+// Posts work to one frame's main thread so that it runs even while that
+// thread is stopped in the debugger's nested pause loop. Obtained on the main
+// thread and used from any thread, which is what lets an embedder serve
+// resume, step and evaluate from another thread.
+class BLINK_EXPORT WebNativeDebuggerPoster
+    : public base::RefCountedThreadSafe<WebNativeDebuggerPoster> {
+ public:
+  // With `interrupt`, also requests a V8 interrupt, so the task runs while
+  // script is running. Pass false for a task that runs JavaScript itself,
+  // which is not safe at an interrupt; such a task still reaches a paused
+  // main thread, because the inspector task queue is unpausable. Returns
+  // false once the frame's inspector task runner is disposed.
+  virtual bool Post(bool interrupt, base::OnceClosure task) = 0;
+
+ protected:
+  friend class base::RefCountedThreadSafe<WebNativeDebuggerPoster>;
+  virtual ~WebNativeDebuggerPoster() = default;
+};
+
+// One in-process inspector session on a frame's main thread. It opens no
+// remote debugging port, exposes no protocol endpoint and creates no DevTools
+// frontend: the messages below are built and read inside this renderer.
+class BLINK_EXPORT WebNativeDebugger {
+ public:
+  class BLINK_EXPORT Client {
+   public:
+    virtual ~Client() = default;
+    // One complete inspector response or notification as UTF-8 JSON, on the
+    // main thread, from inside Dispatch or while that thread is paused.
+    virtual void OnInspectorMessage(std::string_view message) = 0;
+  };
+
+  // Attaches to the context group of `frame`'s local root and installs the
+  // nested pause loop when no DevTools session has installed it, so that a
+  // pause actually stops the thread. `frame` need not be a local root: an
+  // inspector session belongs to the group, and a pause in a same-process
+  // iframe is a pause of that group either way. Null when the frame has no
+  // main thread debugger. Main thread only. `client` need not outlive the
+  // session: destroying the session detaches it, and V8 owns the channel for
+  // as long as a deferred destruction can still answer through it.
+  static std::unique_ptr<WebNativeDebugger> Attach(WebLocalFrame* frame,
+                                                   Client* client);
+
+  // The poster of `frame`'s local root, whose inspector task runner is the
+  // one that runs on a paused page. Main thread only; the result is safe to
+  // use from any thread.
+  static scoped_refptr<WebNativeDebuggerPoster> Poster(WebLocalFrame* frame);
+
+  virtual ~WebNativeDebugger() = default;
+
+  // Dispatches one inspector protocol command on the main thread, including
+  // while that thread is inside the nested pause loop.
+  virtual void Dispatch(std::string_view message) = 0;
+};
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_PUBLIC_WEB_WEB_NATIVE_DEBUGGER_H_
