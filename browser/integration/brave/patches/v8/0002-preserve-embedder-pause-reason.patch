+++ b/test/inspector/debugger/reb-break-program-multiple-sessions.js
@@ -0,0 +1,32 @@
+// Copyright 2026 the V8 project authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+const {contextGroup, Protocol} = InspectorTest.start(
+    'Embedder pauses are reported safely to multiple inspector sessions.');
+const peer = contextGroup.connect().Protocol;
+
+(async function() {
+  await Protocol.Debugger.enable();
+  await peer.Debugger.enable();
+  let reasons = [];
+  let pauses = 0;
+  function onPaused(message) {
+    reasons.push(message.params.reason);
+    if (reasons.length === 2) {
+      InspectorTest.log(reasons.sort().join(', '));
+      reasons = [];
+      ++pauses;
+      Protocol.Debugger.resume();
+    }
+  }
+  Protocol.Debugger.onPaused(onPaused);
+  peer.Debugger.onPaused(onPaused);
+  // The test helper invokes breakProgram once for each session. Each pause
+  // must reach both sessions, including the peer without local break details.
+  await Protocol.Runtime.evaluate({
+    expression: "inspector.breakProgram('embedder', '{}')"
+  });
+  InspectorTest.log('Completed pauses: ' + pauses);
+  InspectorTest.completeTest();
+})();
