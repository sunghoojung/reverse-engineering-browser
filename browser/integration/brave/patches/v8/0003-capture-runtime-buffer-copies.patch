@@ -15,6 +15,24 @@
 namespace v8 {
 namespace internal {
 
+namespace {
+
+void NotifyRuntimeArrayBuffer(Isolate* isolate, Tagged<Object> value) {
+  RuntimeBufferCallback callback = isolate->runtime_buffer_callback();
+  if (!callback || !IsJSArrayBuffer(value)) {
+    return;
+  }
+  Tagged<JSArrayBuffer> buffer = Cast<JSArrayBuffer>(value);
+  if (buffer->is_shared() || buffer->is_resizable_by_js() || buffer->was_detached()) {
+    return;
+  }
+  callback(reinterpret_cast<v8::Isolate*>(isolate)->GetCurrentContext(),
+           RuntimeBufferKind::kArrayBuffer,
+           static_cast<const uint8_t*>(buffer->backing_store()), buffer->GetByteLength());
+}
+
+}  // namespace
