diff --git a/src/runtime/runtime-typedarray.cc b/src/runtime/runtime-typedarray.cc
index 2725e04..a24466b 100644
--- a/src/runtime/runtime-typedarray.cc
+++ b/src/runtime/runtime-typedarray.cc
@@ -66,6 +66,41 @@ RUNTIME_FUNCTION(Runtime_TypedArrayGetBuffer) {
   return *holder->GetBuffer(isolate);
 }
 
+RUNTIME_FUNCTION(Runtime_RebCaptureRuntimeBuffer) {
+  HandleScope scope(isolate);
+  DCHECK_EQ(1, args.length());
+  RuntimeBufferCallback callback = isolate->runtime_buffer_callback();
+  if (!callback || !IsJSTypedArray(args[0])) {
+    return ReadOnlyRoots(isolate).undefined_value();
+  }
+
+  DirectHandle<JSTypedArray> typed_array = args.at<JSTypedArray>(0);
+  if (typed_array->buffer()->is_shared() || typed_array->buffer()->is_resizable_by_js() ||
+      typed_array->WasDetached()) {
+    return ReadOnlyRoots(isolate).undefined_value();
+  }
+
+  RuntimeBufferKind kind;
+  switch (typed_array->GetElementsKind()) {
+    case UINT8_ELEMENTS:
+      kind = RuntimeBufferKind::kUint8Array;
+      break;
+    case UINT16_ELEMENTS:
+      kind = RuntimeBufferKind::kUint16Array;
+      break;
+    case UINT32_ELEMENTS:
+      kind = RuntimeBufferKind::kUint32Array;
+      break;
+    default:
+      return ReadOnlyRoots(isolate).undefined_value();
+  }
+
+  const size_t byte_length = typed_array->GetByteLength();
+  callback(reinterpret_cast<v8::Isolate*>(isolate)->GetCurrentContext(), kind,
+           static_cast<const uint8_t*>(typed_array->DataPtr()), byte_length);
+  return ReadOnlyRoots(isolate).undefined_value();
+}
