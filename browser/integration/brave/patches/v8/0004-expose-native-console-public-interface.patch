+MaybeLocal<Value> EvaluateNativeConsole(Isolate* isolate, Local<String> source,
+                                        NativeConsoleEvaluationMode mode) {
+  const bool repl = mode == NativeConsoleEvaluationMode::kRepl;
+  return EvaluateGlobal(
+      isolate, source,
+      repl ? EvaluateGlobalMode::kDisableBreaks
+           : EvaluateGlobalMode::kDisableBreaksAndThrowOnSideEffect,
+      repl);
+}
+
+void GetNativeConsoleLexicalNames(Local<Context> context,
+                                  std::vector<Global<String>>* names,
+                                  uint32_t limit) {
+  GetConsoleLexicalNames(context, names, limit);
+}
