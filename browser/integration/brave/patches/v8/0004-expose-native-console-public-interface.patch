+namespace v8::debug {
+
+// kRepl runs an explicitly authorized command with native REPL semantics.
+// kReadOnly denies side effects during a verified lexical identifier lookup.
+enum class NativeConsoleEvaluationMode { kRepl, kReadOnly };
+
+V8_EXPORT MaybeLocal<Value> EvaluateNativeConsole(Isolate* isolate,
+                                                  Local<String> source,
+                                                  NativeConsoleEvaluationMode mode);
+
+// Bounded lexical enumeration never reads page-global properties or getters.
+V8_EXPORT void GetNativeConsoleLexicalNames(Local<Context> context,
+                                            std::vector<Global<String>>* names,
+                                            uint32_t limit);
