+// Exact innermost JavaScript frame identity. Values are borrowed handles and
+// are only valid within the caller's HandleScope. This never enables Inspector.
+struct RuntimeBufferScript {
+  int script_id = 0;
+  bool is_eval = false;
+  Local<Context> context;
+  Local<String> source;
+  Local<String> name;
+};
