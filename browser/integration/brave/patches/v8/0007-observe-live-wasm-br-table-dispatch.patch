+TEST(RebNativeCallIndirectRuntimeDispatch) {
+  FlagScope<bool> sampling(&v8_flags.reb_wasm_call_indirect_dispatch, true);
+  TestSignatures sigs;
+  WasmRunner<int32_t, int32_t> r(TestExecutionTier::kLiftoff);
+  WasmFunctionCompiler& add = r.NewFunction(sigs.i_ii());
+  add.Build({WASM_I32_ADD(WASM_LOCAL_GET(0), WASM_LOCAL_GET(1))});
+  add.SetSigIndex(ModuleTypeIndex{1});
+  WasmFunctionCompiler& sub = r.NewFunction(sigs.i_ii());
+  sub.Build({WASM_I32_SUB(WASM_LOCAL_GET(0), WASM_LOCAL_GET(1))});
+  sub.SetSigIndex(ModuleTypeIndex{1});
+  r.builder().AddSignature(sigs.f_ff());
+  r.builder().AddSignature(sigs.i_ii());
+  uint16_t entries[] = {static_cast<uint16_t>(add.function_index()),
+                        static_cast<uint16_t>(sub.function_index())};
+  r.builder().AddIndirectFunctionTable(entries, arraysize(entries));
+  // Distinct handler results detect a damaged index, not merely a callback.
+  r.Build({WASM_CALL_INDIRECT(1, WASM_I32V_2(66), WASM_I32V_1(22),
+                              WASM_LOCAL_GET(0))});
+  auto* api_isolate = reinterpret_cast<v8::Isolate*>(r.isolate());
+  const auto& seen = reb_indirect_observation;
+  reb_indirect_observation = {};
+  CHECK_EQ(88, r.Call(0));
+  CHECK_EQ(0, seen.count);
+  api_isolate->SetWasmCallIndirectDispatchCallback(&ObserveRebCallIndirect);
+  CHECK_EQ(44, r.Call(1));
+  CHECK_EQ(1, seen.count);
+  CHECK_EQ(r.function_index(), seen.function_index);
+  CHECK_EQ(kExprCallIndirect, seen.opcode);
+  CHECK_EQ(0, seen.table_index);
+  CHECK_EQ(1, seen.slot);
+  CHECK(seen.resolution == v8::WasmCallIndirectResolution::kResolved);
+  CHECK_EQ(sub.function_index(), seen.callee);
+  const uint32_t offset = seen.offset;
+  CHECK_EQ(88, r.Call(0));
+  CHECK_EQ(2, seen.count);
+  CHECK_EQ(0, seen.slot);
+  CHECK_EQ(add.function_index(), seen.callee);
+  CHECK_EQ(offset, seen.offset);
+  api_isolate->SetWasmCallIndirectDispatchCallback(nullptr);
+  CHECK_EQ(44, r.Call(1));
+  CHECK_EQ(2, seen.count);
+}
