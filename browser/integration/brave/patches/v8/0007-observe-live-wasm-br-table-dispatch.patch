+RUNTIME_FUNCTION(Runtime_WasmRebTraceBrTable) {
+  // Inactive/capped sessions return before handles, code references or a frame
+  // walk, even when the browser was compiled in the instrumented research mode.
+  auto callback = isolate->wasm_br_table_dispatch_callback();
+  if (callback == nullptr) return ReadOnlyRoots(isolate).undefined_value();
+  auto enabled = isolate->wasm_br_table_dispatch_enabled_callback();
+  if (enabled != nullptr && !enabled()) {
+    return ReadOnlyRoots(isolate).undefined_value();
+  }
+  CHECK(v8_flags.reb_wasm_br_table_dispatch);
+  CHECK_EQ(1, args.length());
+  CHECK(IsSmi(args[0]));
+  DisallowGarbageCollection no_gc;
+  auto* info = reinterpret_cast<const wasm::RebBrTableTracingInfo*>(
+      Cast<Smi>(args[0]).ptr());
+  wasm::WasmCodeRefScope code_scope;
+  FrameFinder<WasmFrame> frame_finder(isolate);
+  WasmFrame* frame = frame_finder.frame();
+  if (frame->wasm_code()->tier() != wasm::ExecutionTier::kLiftoff) {
+    return ReadOnlyRoots(isolate).undefined_value();
+  }
+  const int function_index = frame->GetInnermostFunctionIndex();
+  const auto instance = frame->trusted_instance_data();
+  const auto* module = instance->module();
+  if (!instance->has_native_context() || function_index < 0 ||
+      static_cast<size_t>(function_index) >= module->functions.size()) {
+    return ReadOnlyRoots(isolate).undefined_value();
+  }
+  const auto& function = module->functions[function_index];
+  const auto bytes = frame->native_module()->wire_bytes();
+  if (info->function_byte_offset >= function.code.length()) {
+    return ReadOnlyRoots(isolate).undefined_value();
+  }
+  const uint32_t offset = function.code.offset() + info->function_byte_offset;
+  if (offset >= bytes.size() || bytes[offset] != wasm::kExprBrTable) {
+    return ReadOnlyRoots(isolate).undefined_value();
+  }
+  HandleScope scope(isolate);
+  callback(Utils::ToLocal(direct_handle(instance->native_context(), isolate)),
+           bytes.data(), bytes.size(), static_cast<uint32_t>(function_index),
+           offset, info->selector, info->table_count);
+  return ReadOnlyRoots(isolate).undefined_value();
+}
+
+RUNTIME_FUNCTION(Runtime_WasmRebTraceCallIndirect) {
+  // Inactive/capped sessions return before handles, code references or a frame
+  // walk, even when the browser was compiled in the instrumented research mode.
+  auto callback = isolate->wasm_call_indirect_dispatch_callback();
+  if (callback == nullptr) return ReadOnlyRoots(isolate).undefined_value();
+  auto enabled = isolate->wasm_call_indirect_dispatch_enabled_callback();
+  if (enabled != nullptr && !enabled()) {
+    return ReadOnlyRoots(isolate).undefined_value();
+  }
+  CHECK(v8_flags.reb_wasm_call_indirect_dispatch);
+  CHECK_EQ(1, args.length());
+  CHECK(IsSmi(args[0]));
+  DisallowGarbageCollection no_gc;
+  auto* info = reinterpret_cast<const wasm::RebCallIndirectTracingInfo*>(
+      Cast<Smi>(args[0]).ptr());
+  wasm::WasmCodeRefScope code_scope;
+  FrameFinder<WasmFrame> frame_finder(isolate);
+  WasmFrame* frame = frame_finder.frame();
+  if (frame->wasm_code()->tier() != wasm::ExecutionTier::kLiftoff) {
+    return ReadOnlyRoots(isolate).undefined_value();
+  }
+  const int function_index = frame->GetInnermostFunctionIndex();
+  const auto instance = frame->trusted_instance_data();
+  const auto* module = instance->module();
+  if (!instance->has_native_context() || function_index < 0 ||
+      static_cast<size_t>(function_index) >= module->functions.size() ||
+      info->table_index >= module->tables.size()) {
+    return ReadOnlyRoots(isolate).undefined_value();
+  }
+  const auto& function = module->functions[function_index];
+  const auto bytes = frame->native_module()->wire_bytes();
+  if (info->function_byte_offset >= function.code.length()) {
+    return ReadOnlyRoots(isolate).undefined_value();
+  }
+  const uint32_t offset = function.code.offset() + info->function_byte_offset;
+  if (offset >= bytes.size() ||
+      (bytes[offset] != wasm::kExprCallIndirect &&
+       bytes[offset] != wasm::kExprReturnCallIndirect)) {
+    return ReadOnlyRoots(isolate).undefined_value();
+  }
+  // Read the entry the call is about to use without creating a funcref: a
+  // lazy placeholder already names its function, and nothing here allocates.
+  // The call itself still performs its own bounds, null and signature checks.
+  auto resolution = v8::WasmCallIndirectResolution::kUnresolved;
+  uint32_t callee_function_index = 0;
+  if (info->table_index < instance->tables()->ulength().value() &&
+      IsWasmTableObject(instance->tables()->get(info->table_index))) {
+    const auto table =
+        Cast<WasmTableObject>(instance->tables()->get(info->table_index));
+    if (info->slot >= static_cast<uint32_t>(table->current_length())) {
+      resolution = v8::WasmCallIndirectResolution::kOutOfBounds;
+    } else {
+      Tagged<Object> entry = table->entries()->get(info->slot);
+      Tagged<WasmTrustedInstanceData> owner;
+      int callee = -1;
+      if (IsWasmNull(entry)) {
+        resolution = v8::WasmCallIndirectResolution::kNull;
+      } else if (IsWasmFuncRef(entry)) {
+        const auto internal = Cast<WasmFuncRef>(entry)->internal(isolate);
+        const Tagged<TrustedObject> implicit_arg = internal->implicit_arg();
+        if (IsWasmTrustedInstanceData(implicit_arg) ||
+            (IsWasmImportData(implicit_arg) &&
+             TrustedCast<WasmImportData>(implicit_arg)
+                 ->has_importing_instance_data())) {
+          owner = internal->instance_data();
+          callee = internal->function_index();
+        }
+      } else if (IsTuple2(entry)) {
+        const auto placeholder = Cast<Tuple2>(entry);
+        if (IsWasmInstanceObject(placeholder->value1()) &&
+            IsSmi(placeholder->value2())) {
+          owner = Cast<WasmInstanceObject>(placeholder->value1())
+                      ->trusted_data(isolate);
+          callee = Cast<Smi>(placeholder->value2()).value();
+        }
+      }
+      if (!owner.is_null()) {
+        if (owner != instance) {
+          resolution = v8::WasmCallIndirectResolution::kForeign;
+        } else if (callee >= 0 &&
+                   static_cast<size_t>(callee) < module->functions.size()) {
+          resolution = v8::WasmCallIndirectResolution::kResolved;
+          callee_function_index = static_cast<uint32_t>(callee);
+        }
+      }
+    }
+  }
+  HandleScope scope(isolate);
+  callback(Utils::ToLocal(direct_handle(instance->native_context(), isolate)),
+           bytes.data(), bytes.size(), static_cast<uint32_t>(function_index),
+           offset, info->table_index, info->slot, resolution,
+           callee_function_index);
+  return ReadOnlyRoots(isolate).undefined_value();
+}
