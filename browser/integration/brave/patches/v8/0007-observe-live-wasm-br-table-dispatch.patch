+namespace {
+struct RebIndirectObservation {
+  uint32_t count = 0;
+  uint32_t function_index = 0;
+  uint32_t offset = 0;
+  uint32_t table_index = 0;
+  uint32_t slot = 0;
+  uint32_t callee = 0;
+  uint8_t opcode = 0;
+  v8::WasmCallIndirectResolution resolution =
+      v8::WasmCallIndirectResolution::kUnresolved;
+};
+thread_local RebIndirectObservation reb_indirect_observation;
+thread_local bool reb_indirect_enabled = false;
+thread_local uint32_t reb_indirect_admission_calls = 0;
+
+bool AdmitRebCallIndirect() {
+  ++reb_indirect_admission_calls;
+  return reb_indirect_enabled;
+}
+
+void ObserveRebCallIndirect(v8::Local<v8::Context> context,
+                            const uint8_t* bytes, size_t size,
+                            uint32_t function_index,
+                            uint32_t module_byte_offset, uint32_t table_index,
+                            uint32_t slot,
+                            v8::WasmCallIndirectResolution resolution,
+                            uint32_t callee_function_index) {
+  CHECK(!context.IsEmpty());
+  CHECK_LT(module_byte_offset, size);
+  auto& seen = reb_indirect_observation;
+  ++seen.count;
+  seen.function_index = function_index;
+  seen.offset = module_byte_offset;
+  seen.opcode = bytes[module_byte_offset];
+  seen.table_index = table_index;
+  seen.slot = slot;
+  seen.resolution = resolution;
+  seen.callee = callee_function_index;
+}
+
+// Builtin calls compiled into the main function's Liftoff code.
+int CountRebStubCalls(WasmRunner<int32_t, int32_t>& r) {
+  WasmCodeRefScope scope;
+  WasmCode* code = r.builder().GetFunctionCode(r.function_index());
+  CHECK_NOT_NULL(code);
+  CHECK(code->tier() == ExecutionTier::kLiftoff);
+  int count = 0;
+  for (RelocIterator it(code->instructions(), code->reloc_info(),
+                        code->constant_pool(),
+                        RelocInfo::ModeMask(RelocInfo::WASM_STUB_CALL));
+       !it.done(); it.next()) {
+    ++count;
+  }
+  return count;
+}
+
+// One call_indirect through a two-entry table; returns its stub call count.
+int BuildRebIndirectCaller(WasmRunner<int32_t, int32_t>& r) {
+  TestSignatures sigs;
+  WasmFunctionCompiler& add = r.NewFunction(sigs.i_ii());
+  add.Build({WASM_I32_ADD(WASM_LOCAL_GET(0), WASM_LOCAL_GET(1))});
+  add.SetSigIndex(ModuleTypeIndex{1});
+  r.builder().AddSignature(sigs.f_ff());
+  r.builder().AddSignature(sigs.i_ii());
+  uint16_t entries[] = {static_cast<uint16_t>(add.function_index())};
+  r.builder().AddIndirectFunctionTable(entries, arraysize(entries));
+  r.Build({WASM_CALL_INDIRECT(1, WASM_I32V_2(66), WASM_I32V_1(22),
+                              WASM_LOCAL_GET(0))});
+  return CountRebStubCalls(r);
+}
+}  // namespace
