+namespace {
+struct RebDispatchObservation {
+  uint32_t count = 0;
+  uint32_t selector = 0;
+  uint32_t offset = 0;
+};
+thread_local RebDispatchObservation reb_dispatch_observation;
+thread_local bool reb_dispatch_enabled = false;
+thread_local uint32_t reb_dispatch_admission_calls = 0;
+
+bool AdmitRebBrTable() {
+  ++reb_dispatch_admission_calls;
+  return reb_dispatch_enabled;
+}
+
+void ObserveRebBrTable(v8::Local<v8::Context> context, const uint8_t* bytes,
+                       size_t size, uint32_t function_index,
+                       uint32_t module_byte_offset, uint32_t selector,
+                       uint32_t table_count) {
+  CHECK(!context.IsEmpty());
+  CHECK_EQ(0, function_index);
+  CHECK_LT(module_byte_offset, size);
+  CHECK_EQ(kExprBrTable, bytes[module_byte_offset]);
+  CHECK_EQ(1, table_count);
+  ++reb_dispatch_observation.count;
+  reb_dispatch_observation.selector = selector;
+  reb_dispatch_observation.offset = module_byte_offset;
+}
+}  // namespace
+
+TEST(RebNativeBrTableRuntimeDispatch) {
+  FlagScope<bool> sampling(&v8_flags.reb_wasm_br_table_dispatch, true);
+  WasmRunner<int32_t, int32_t> r(TestExecutionTier::kLiftoff);
+  // Distinct branch results detect a damaged selector, not merely a callback.
+  r.Build({B1(B2(B1(WASM_BR_TABLE(WASM_LOCAL_GET(0), 1, BR_TARGET(0),
+                                  BR_TARGET(1))), RET_I8(76))),
+           WASM_I32V_2(77)});
+  auto* api_isolate = reinterpret_cast<v8::Isolate*>(r.isolate());
+  reb_dispatch_observation = {};
+  CHECK_EQ(76, r.Call(0));
+  CHECK_EQ(0, reb_dispatch_observation.count);
+  api_isolate->SetWasmBrTableDispatchCallback(&ObserveRebBrTable);
+  CHECK_EQ(76, r.Call(0));
+  CHECK_EQ(1, reb_dispatch_observation.count);
+  CHECK_EQ(0, reb_dispatch_observation.selector);
+  const uint32_t offset = reb_dispatch_observation.offset;
+  CHECK_EQ(77, r.Call(-1));
+  CHECK_EQ(2, reb_dispatch_observation.count);
+  CHECK_EQ(UINT32_MAX, reb_dispatch_observation.selector);
+  CHECK_EQ(offset, reb_dispatch_observation.offset);
+  api_isolate->SetWasmBrTableDispatchCallback(nullptr);
+  CHECK_EQ(77, r.Call(9));
+  CHECK_EQ(2, reb_dispatch_observation.count);
+}
+
+TEST(RebNativeBrTableAdmissionPredicate) {
+  FlagScope<bool> sampling(&v8_flags.reb_wasm_br_table_dispatch, true);
+  WasmRunner<int32_t, int32_t> r(TestExecutionTier::kLiftoff);
+  r.Build({B1(WASM_BR_TABLE(WASM_LOCAL_GET(0), 1, BR_TARGET(0),
+                            BR_TARGET(0))), WASM_I32V_2(93)});
+  auto* api_isolate = reinterpret_cast<v8::Isolate*>(r.isolate());
+  reb_dispatch_observation = {};
+  reb_dispatch_enabled = false;
+  reb_dispatch_admission_calls = 0;
+  api_isolate->SetWasmBrTableDispatchCallback(&ObserveRebBrTable,
+                                             &AdmitRebBrTable);
+  CHECK_EQ(93, r.Call(7));
+  CHECK_EQ(1, reb_dispatch_admission_calls);
+  CHECK_EQ(0, reb_dispatch_observation.count);
+  reb_dispatch_enabled = true;
+  CHECK_EQ(93, r.Call(-1));
+  CHECK_EQ(2, reb_dispatch_admission_calls);
+  CHECK_EQ(1, reb_dispatch_observation.count);
+  CHECK_EQ(UINT32_MAX, reb_dispatch_observation.selector);
+  reb_dispatch_enabled = false;
+  CHECK_EQ(93, r.Call(0));
+  CHECK_EQ(3, reb_dispatch_admission_calls);
+  CHECK_EQ(1, reb_dispatch_observation.count);
+  api_isolate->SetWasmBrTableDispatchCallback(nullptr, &AdmitRebBrTable);
