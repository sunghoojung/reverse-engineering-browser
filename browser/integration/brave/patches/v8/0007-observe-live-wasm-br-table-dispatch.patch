+  void TraceRebBrTable(FullDecoder* decoder, uint32_t table_count) {
+    // Keep the original selector on the operand stack. BrTable reloads it
+    // after the call, preserving all i32 bits and the ordinary branch behavior.
+    __ SpillAllRegisters();
+    LiftoffRegList pinned;
+    LiftoffRegister selector = pinned.set(__ PeekToRegister(0, pinned));
+    LiftoffRegister info = pinned.set(__ GetUnusedRegister(kGpReg, pinned));
+    __ AllocateStackSlot(info.gp(), sizeof(RebBrTableTracingInfo));
+    __ Store(info.gp(), no_reg, offsetof(RebBrTableTracingInfo, selector),
+             selector, StoreType::kI32Store, pinned);
+    __ SpillAllRegisters();
+    LiftoffRegister data = pinned.set(__ GetUnusedRegister(kGpReg, pinned));
+    __ LoadConstant(data, WasmValue(static_cast<uint32_t>(decoder->position())));
+    __ Store(info.gp(), no_reg,
+             offsetof(RebBrTableTracingInfo, function_byte_offset), data,
+             StoreType::kI32Store, pinned);
+    __ LoadConstant(data, WasmValue(table_count));
+    __ Store(info.gp(), no_reg, offsetof(RebBrTableTracingInfo, table_count),
+             data, StoreType::kI32Store, pinned);
+    WasmTraceMemoryDescriptor descriptor;
+    Register param_reg = descriptor.GetRegisterParameter(0);
+    if (info.gp() != param_reg) __ Move(param_reg, info.gp(), kIntPtrKind);
+    source_position_table_builder_.AddPosition(
+        __ pc_offset(), SourcePosition(decoder->position()), false);
+    __ CallBuiltin(Builtin::kWasmRebTraceBrTable);
+    DefineSafepoint();
+    __ DeallocateStackSlot(sizeof(RebBrTableTracingInfo));
+  }
+
+  void TraceRebCallIndirect(FullDecoder* decoder,
+                            const CallIndirectImmediate& imm) {
+    // Only i32 table indexes fit the record; table64 sites are not observed.
+    if (imm.table_imm.table->is_table64()) return;
+    // Keep the dynamic index on the operand stack. CallIndirectImpl reloads it
+    // after the call, so its bounds, null and signature checks are unchanged.
+    __ SpillAllRegisters();
+    LiftoffRegList pinned;
+    LiftoffRegister slot = pinned.set(__ PeekToRegister(0, pinned));
+    LiftoffRegister info = pinned.set(__ GetUnusedRegister(kGpReg, pinned));
+    __ AllocateStackSlot(info.gp(), sizeof(RebCallIndirectTracingInfo));
+    __ Store(info.gp(), no_reg, offsetof(RebCallIndirectTracingInfo, slot),
+             slot, StoreType::kI32Store, pinned);
+    __ SpillAllRegisters();
+    LiftoffRegister data = pinned.set(__ GetUnusedRegister(kGpReg, pinned));
+    __ LoadConstant(data, WasmValue(static_cast<uint32_t>(decoder->position())));
+    __ Store(info.gp(), no_reg,
