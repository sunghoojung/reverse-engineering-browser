+bool GuestCaptureEnabled(Isolate *isolate) {
+  if (auto epoch = isolate->wasm_guest_epoch_callback()) {
+    auto &state = isolate->reb_guest_capture_state();
+    const uint64_t generation = epoch();
+    if (state.epoch != generation) {
+      ResetRebGuestCapture(isolate);
+      state.epoch = generation;
+    }
+  }
+  auto callback = isolate->wasm_guest_dispatch_callback();
+  auto enabled = isolate->wasm_guest_enabled_callback();
+  return callback && enabled && enabled();
+}
+Isolate::RebGuestFrame *FindGuestFrame(Isolate *isolate, WasmFrame *frame) {
+  if (!frame->trusted_instance_data()->has_instance_object())
+    return nullptr;
+  auto &state = isolate->reb_guest_capture_state();
+  uint64_t instance_id = 0;
+  for (const auto &instance : state.instances) {
+    if (instance.root && *instance.root == frame->wasm_instance().ptr()) {
+      instance_id = instance.id;
+      break;
+    }
+  }
+  if (!instance_id)
+    return nullptr;
+  for (auto &entry : state.frames) {
+    if (entry.fp == frame->fp() && entry.instance_id == instance_id)
+      return &entry;
+  }
+  return nullptr;
+}
+void EnterGuestFrame(Isolate *isolate, WasmFrame *frame) {
+  auto &state = isolate->reb_guest_capture_state();
+  // Revoke a reused fp before every early return, including counter/depth caps.
+  for (auto &saved : state.frames)
+    if (saved.fp == frame->fp())
+      saved = {};
+  if (!state.next_id || state.next_id == UINT64_MAX ||
+      !frame->trusted_instance_data()->has_instance_object())
+    return;
+  Address live[128]{};
+  size_t count = 0;
+  for (StackFrameIterator it(isolate); !it.done(); it.Advance()) {
+    if (!it.frame()->is_wasm())
+      continue;
+    if (count == std::size(live)) {
+      for (auto &saved : state.frames)
+        saved = {};
+      return;
+    }
+    live[count++] = it.frame()->fp();
+  }
+  for (auto &saved : state.frames) {
+    bool found = false;
+    for (size_t i = 0; i < count; ++i)
+      found |= saved.fp == live[i];
+    if (!found)
+      saved = {};
+  }
+  uint64_t instance_id = 0;
+  Isolate::RebGuestInstance *empty = nullptr;
+  for (auto &instance : state.instances) {
+    if (!instance.root && !empty)
+      empty = &instance;
+    if (instance.root && *instance.root == frame->wasm_instance().ptr())
+      instance_id = instance.id;
+  }
+  if (!instance_id) {
+    if (!empty || state.next_id == UINT64_MAX)
+      return;
+    // Unrelated modules must not consume the bounded weak-identity budget.
+    // The embedder checks the configured dispatcher index before hashing.
+    if (auto admit = isolate->wasm_guest_module_admission()) {
+      const auto instance = frame->trusted_instance_data();
+      const int function = frame->GetInnermostFunctionIndex();
+      if (!instance->has_native_context() || function < 0)
+        return;
+      const auto bytes = frame->native_module()->wire_bytes();
+      HandleScope scope(isolate);
+      if (!admit(Utils::ToLocal(
+                     direct_handle(instance->native_context(), isolate)),
+                 bytes.data(), bytes.size(), static_cast<uint32_t>(function)))
+        return;
+    }
+    // Weak global handles are GC-updated identity keys, not lifetime roots.
+    // The fixed isolate slot outlives the handle; GC nulls this slot and
+    // releases its node without a callback when the instance becomes dead.
+    auto handle =
+        isolate->global_handles()->Create(frame->wasm_instance().ptr());
+    empty->root = handle.location();
+    GlobalHandles::MakeWeak(&empty->root);
+    empty->id = instance_id = state.next_id++;
+  }
+  if (state.next_id == UINT64_MAX)
+    return;
+  for (auto &saved : state.frames) {
+    if (!saved.fp) {
+      saved = {frame->fp(), instance_id, state.next_id++};
+      return;
+    }
+  }
+}
+struct BorrowedGuestState {
+  WasmFrame *frame;
+  const RebGuestSiteDescriptor *site;
+};
+bool ReadGuestNumericLocal(void *raw, uint32_t index, uint64_t *bits,
+                           uint8_t *width) {
+  if (!raw || !bits || !width)
+    return false;
+  const auto &state = *static_cast<BorrowedGuestState *>(raw);
+  if (!state.site || index >= state.site->locals.size())
+    return false;
+  const auto &local = state.site->locals[index];
+  if (local.bits != 32 && local.bits != 64)
+    return false;
+  if (local.is_constant) {
+    *bits = local.bits == 32
+                ? static_cast<uint32_t>(local.offset_or_constant)
+                : static_cast<uint64_t>(int64_t{local.offset_or_constant});
+  } else {
+    if (local.offset_or_constant <= 0 ||
+        static_cast<uint64_t>(local.offset_or_constant) >
+            static_cast<uint64_t>(state.frame->wasm_code()->stack_slots()) *
+                kSystemPointerSize)
+      return false;
+    const Address address = state.frame->fp() - local.offset_or_constant;
+    *bits = local.bits == 32 ? ReadUnalignedValue<uint32_t>(address)
+                             : ReadUnalignedValue<uint64_t>(address);
+  }
+  *width = local.bits;
+  return true;
+}
+bool CopyGuestMemory(void *raw, uint32_t index, uint64_t offset,
+                     uint32_t length, uint8_t *output) {
+  if (!raw || !output || !length || length > 65536)
+    return false;
+  const auto &state = *static_cast<BorrowedGuestState *>(raw);
+  const auto instance = state.frame->trusted_instance_data();
+  const auto *module = instance->module();
+  if (index >= module->memories.size() ||
+      module->memories[index].is_shared != SharedFlag::kNo ||
+      module->memories[index].is_memory64())
+    return false;
+  const size_t size = instance->memory_size(index);
+  if (offset > size || length > size - static_cast<size_t>(offset))
+    return false;
+  // Non-shared memory cannot grow/mutate in a synchronous no-JS/no-GC callback.
+  std::memcpy(output,
+              instance->memory_base(index) + static_cast<size_t>(offset),
+              length);
+  return true;
+}
+} // namespace
+void ResetRebGuestCapture(Isolate *isolate) {
+  auto &state = isolate->reb_guest_capture_state();
+  for (auto &instance : state.instances) {
+    if (instance.root)
+      GlobalHandles::Destroy(instance.root);
+    instance = {};
+  }
+  for (auto &frame : state.frames)
+    frame = {};
+  // Never reset next_id: old observations cannot become current again.
+}
+bool GetCurrentRebGuestContext(Isolate *isolate,
+                               uint32_t dispatcher_function_index,
+                               v8::WasmGuestContext *result) {
+  if (!result || !GuestCaptureEnabled(isolate))
+    return false;
+  DisallowGarbageCollection no_gc;
+  WasmCodeRefScope code_scope;
+  uint64_t import_instance = 0;
+  uint32_t import_function = 0, import_offset = 0;
+  size_t depth = 0;
+  for (StackFrameIterator it(isolate); !it.done(); it.Advance()) {
+    if (!it.frame()->is_wasm())
+      continue;
+    if (++depth > 128)
+      return false;
+    auto *frame = static_cast<WasmFrame *>(it.frame());
+    if (!frame->wasm_code()->is_liftoff())
+      return false;
+    auto *identity = FindGuestFrame(isolate, frame);
+    const int function = frame->GetInnermostFunctionIndex();
+    const int offset = frame->position();
+    // Never walk through an untracked invocation to borrow an older parent's
+    // identity, even if the untracked frame happens to share the same module.
+    if (!identity || function < 0 || offset < 0)
+      return false;
+    if (!import_instance) {
+      import_instance = identity->instance_id;
+      import_function = static_cast<uint32_t>(function);
+      import_offset = static_cast<uint32_t>(offset);
+    }
+    if (identity->instance_id != import_instance)
+      return false;
+    if (static_cast<uint32_t>(function) != dispatcher_function_index)
+      continue;
+    *result = {identity->instance_id,
+               identity->invocation_id,
+               static_cast<uint32_t>(function),
+               static_cast<uint32_t>(offset),
+               import_function,
+               import_offset};
+    return true;
+  }
+  return false;
+}
