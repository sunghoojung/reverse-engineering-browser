+TEST(RebNativeGuestParentWalkNeedsEnabledCapture) {
+  FlagScope<bool> sampling(&v8_flags.reb_wasm_br_table_dispatch, true);
+  HandleScope handles(CcTest::InitIsolateOnce());
+  auto* isolate = CcTest::isolate();
+  auto& state = CcTest::i_isolate()->reb_guest_capture_state();
+  TestSignatures sigs;
+  isolate->ResetWasmGuestCapture();
+  const uint64_t walks = state.parent_walks;
+  for (const bool compiled : {false, true}) {
+    FlagScope<bool> guest_frames(&v8_flags.reb_wasm_guest_capture, compiled);
+    NestedGuestRunners runners;
+    auto host = NewNestedGuestHost(isolate, ReenterNestedGuest, &runners);
+    ManuallyImportedJSFunction import{
+        sigs.v_v(), Cast<JSFunction>(v8::Utils::OpenDirectHandle(*host))};
+    WasmRunner<int32_t, int32_t> r(TestExecutionTier::kLiftoff, kWasmOrigin,
+                                   &import);
+    BuildNestedGuest(r);
+    runners.reentry = &r;
+    ResetNestedGuests();
+    // Without frame hooks, or with capture off: no identity, walk, handle or
+    // callback, even across reentry.
+    nested_enabled = !compiled;
+    isolate->SetWasmGuestDispatchCallback(ObserveNestedGuest,
+                                          EnableNestedGuests);
+    CHECK_EQ(9, r.Call(0));
+    CHECK(nested_activations.empty());
+    CHECK_EQ(uint64_t{0}, nested_failures);
+    CHECK_EQ(walks, state.parent_walks);
+    for (const auto& frame : state.frames) CHECK_EQ(Address{0}, frame.fp);
+    for (const auto& instance : state.instances) CHECK_NULL(instance.root);
+    if (compiled) {
+      // Expiry at the outer's first boundary: that boundary walked once; the
+      // reentered inner activation is neither tracked nor walked.
+      nested_enabled = nested_disable_at_dispatch = true;
+      CHECK_EQ(9, r.Call(0));
+      CHECK_EQ(size_t{1}, nested_activations.size());
+      CHECK_EQ(size_t{1}, nested_activations[0].dispatches);
+      CHECK_EQ(walks + 1, state.parent_walks);
+      for (const auto& instance : state.instances) CHECK_NULL(instance.root);
+      // A later interval never inherits the expired outer as a parent.
+      ResetNestedGuests();
+      CHECK_EQ(9, r.Call(1));
+      CHECK_EQ(v8::WasmGuestParent::kNone, nested_activations[0].state);
+    }
+    isolate->SetWasmGuestDispatchCallback(nullptr, nullptr);
+  }
+}
