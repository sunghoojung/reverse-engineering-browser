+namespace {
+// Models the renderer sink: one sequence number per guest callback, each
+// activation's latest dispatch, and the outer dispatch an inner activation
+// names at its first boundary. An unresolved parent counts the
+// native_guest_parent_unresolved gap the sink emits instead of a link.
+struct NestedGuestActivation {
+  uint64_t invocation = 0, parent = 0, parent_dispatch = 0, latest = 0;
+  v8::WasmGuestParent state = v8::WasmGuestParent::kNone;
+  size_t dispatches = 0;
+};
+thread_local std::vector<NestedGuestActivation> nested_activations;
+thread_local uint64_t nested_sequence = 0, nested_parent_gaps = 0,
+                      nested_failures = 0;
+thread_local bool nested_enabled = true, nested_enable_at_host = false,
+                  nested_disable_at_dispatch = false;
+// Runners live on each test's stack. Host functions reach them through their
+// callback data, so no namespace-scope global ever holds a stack address.
+struct NestedGuestRunners {
+  WasmRunner<int32_t, int32_t>* reentry = nullptr;
+  WasmRunner<int32_t, int32_t>* deep_module = nullptr;
+  int32_t deep_depth = 0;
+};
+NestedGuestRunners& NestedRunners(
+    const v8::FunctionCallbackInfo<v8::Value>& args) {
+  return *static_cast<NestedGuestRunners*>(
+      args.Data().As<v8::External>()->Value(
+          v8::kExternalPointerTypeTagDefault));
+}
+v8::Local<v8::Function> NewNestedGuestHost(v8::Isolate* isolate,
+                                           v8::FunctionCallback callback,
+                                           NestedGuestRunners* runners) {
+  return v8::Function::New(
+             isolate->GetCurrentContext(), callback,
+             v8::External::New(isolate, runners,
+                               v8::kExternalPointerTypeTagDefault))
+      .ToLocalChecked();
+}
+void ResetNestedGuests() {
+  nested_activations.clear();
+  nested_sequence = nested_parent_gaps = nested_failures = 0;
+  nested_enabled = true;
+  nested_enable_at_host = nested_disable_at_dispatch = false;
+}
+NestedGuestActivation* FindNestedGuest(uint64_t invocation) {
+  for (auto& activation : nested_activations) {
+    if (activation.invocation == invocation) return &activation;
+  }
+  return nullptr;
+}
+bool EnableNestedGuests() { return nested_enabled; }
+void ObserveNestedGuest(v8::Local<v8::Context>, const uint8_t*, size_t,
+                        const v8::WasmGuestStateView& view) {
+  if (!view.instance_id || !view.invocation_id) {
+    ++nested_failures;
+    return;
+  }
+  const uint64_t sequence = ++nested_sequence;
+  auto* activation = FindNestedGuest(view.invocation_id);
+  if (!activation) {
+    nested_activations.push_back({view.invocation_id});
+    activation = &nested_activations.back();
+    activation->state = view.parent;
+    if (view.parent == v8::WasmGuestParent::kResolved) {
+      CHECK_NE(view.invocation_id, view.parent_invocation_id);
+      const auto* parent = FindNestedGuest(view.parent_invocation_id);
+      CHECK_NOT_NULL(parent);
+      activation->parent = view.parent_invocation_id;
+      activation->parent_dispatch = parent->latest;
+    } else {
+      CHECK_EQ(uint64_t{0}, view.parent_invocation_id);
+      if (view.parent == v8::WasmGuestParent::kUnresolved) ++nested_parent_gaps;
+    }
+  }
+  // Later boundaries repeat the parent fixed at the first one.
+  CHECK_EQ(activation->state, view.parent);
+  CHECK_EQ(activation->parent, view.parent_invocation_id);
+  activation->latest = sequence;
+  ++activation->dispatches;
+  if (nested_disable_at_dispatch) nested_enabled = false;
+}
+void ReenterNestedGuest(const v8::FunctionCallbackInfo<v8::Value>& args) {
+  if (nested_enable_at_host) nested_enabled = true;
+  auto* reentry = NestedRunners(args).reentry;
+  CHECK_NOT_NULL(reentry);
+  CHECK_EQ(9, reentry->Call(1));
+}
+// mode 0: two boundaries, then JavaScript reenters this function in mode 1.
+// mode 1: an inner activation with two boundaries.
+// mode 2: one boundary, then a direct guest call in mode 1.
+// mode 3: one boundary, then a native-only activation (mode 4) calls mode 1.
+void BuildNestedGuest(WasmRunner<int32_t, int32_t>& r) {
+  r.Build(
+      {WASM_IF(WASM_I32_EQ(WASM_LOCAL_GET(0), WASM_I32V_1(0)),
+               WASM_SEQ(B1(WASM_BR_TABLE(WASM_I32V_1(0), 1, BR_TARGET(0),
+                                         BR_TARGET(0))),
+                        B1(WASM_BR_TABLE(WASM_I32V_1(0), 1, BR_TARGET(0),
+                                         BR_TARGET(0))),
+                        WASM_CALL_FUNCTION0(0), WASM_RETURN(WASM_I32V_1(9)))),
+       WASM_IF(WASM_I32_EQ(WASM_LOCAL_GET(0), WASM_I32V_1(4)),
+               WASM_RETURN(WASM_CALL_FUNCTION(1, WASM_I32V_1(1)))),
+       B1(WASM_BR_TABLE(WASM_I32V_1(0), 1, BR_TARGET(0), BR_TARGET(0))),
+       WASM_IF(WASM_I32_EQ(WASM_LOCAL_GET(0), WASM_I32V_1(2)),
+               WASM_RETURN(WASM_CALL_FUNCTION(1, WASM_I32V_1(1)))),
+       WASM_IF(WASM_I32_EQ(WASM_LOCAL_GET(0), WASM_I32V_1(3)),
+               WASM_RETURN(WASM_CALL_FUNCTION(1, WASM_I32V_1(4)))),
+       B1(WASM_BR_TABLE(WASM_I32V_1(0), 1, BR_TARGET(0), BR_TARGET(0))),
+       WASM_I32V_1(9)});
+}
+}  // namespace
+
+TEST(RebNativeGuestNestedActivationExactParent) {
+  FlagScope<bool> sampling(&v8_flags.reb_wasm_br_table_dispatch, true);
+  FlagScope<bool> guest_frames(&v8_flags.reb_wasm_guest_capture, true);
+  HandleScope handles(CcTest::InitIsolateOnce());
+  auto* isolate = CcTest::isolate();
+  NestedGuestRunners runners;
+  auto host = NewNestedGuestHost(isolate, ReenterNestedGuest, &runners);
+  TestSignatures sigs;
+  ManuallyImportedJSFunction import{
+      sigs.v_v(), Cast<JSFunction>(v8::Utils::OpenDirectHandle(*host))};
+  WasmRunner<int32_t, int32_t> r(TestExecutionTier::kLiftoff, kWasmOrigin,
+                                 &import);
+  BuildNestedGuest(r);
+  auto& state = r.isolate()->reb_guest_capture_state();
+  runners.reentry = &r;
+  ResetNestedGuests();
+  isolate->SetWasmGuestDispatchCallback(ObserveNestedGuest, EnableNestedGuests);
+  const uint64_t walks = state.parent_walks;
+  // JavaScript reentry: the inner activation names the outer's second, still
+  // current dispatch (sequence 2), not its first and not a sequence guess.
+  CHECK_EQ(9, r.Call(0));
+  CHECK_EQ(size_t{2}, nested_activations.size());
+  const auto outer = nested_activations[0], inner = nested_activations[1];
+  CHECK_EQ(v8::WasmGuestParent::kNone, outer.state);
+  CHECK_EQ(size_t{2}, outer.dispatches);
+  CHECK_EQ(v8::WasmGuestParent::kResolved, inner.state);
+  CHECK_EQ(outer.invocation, inner.parent);
+  CHECK_EQ(uint64_t{2}, inner.parent_dispatch);
+  CHECK_EQ(size_t{2}, inner.dispatches);
+  // One walk per activation, not per boundary.
+  CHECK_EQ(walks + 2, state.parent_walks);
+  // A direct guest call, with or without a tracked native-only activation of
+  // the same dispatcher between them, names the caller exactly.
+  for (const int32_t mode : {2, 3}) {
+    ResetNestedGuests();
+    CHECK_EQ(9, r.Call(mode));
+    CHECK_EQ(size_t{2}, nested_activations.size());
+    CHECK_EQ(v8::WasmGuestParent::kResolved, nested_activations[1].state);
+    CHECK_EQ(nested_activations[0].invocation, nested_activations[1].parent);
+    CHECK_EQ(uint64_t{1}, nested_activations[1].parent_dispatch);
+  }
+  // A returned activation is never a parent, even when its frame address is
+  // reused by the next top-level activation.
+  ResetNestedGuests();
+  CHECK_EQ(9, r.Call(1));
+  CHECK_EQ(v8::WasmGuestParent::kNone, nested_activations[0].state);
+  CHECK_EQ(uint64_t{0}, nested_parent_gaps);
+  CHECK_EQ(uint64_t{0}, nested_failures);
+  isolate->SetWasmGuestDispatchCallback(nullptr, nullptr);
+}
+
+namespace {
+// Module A: import 0 enters module B, main 1 calls dispatcher 2. Module B's
+// only function 1 recurses, then reenters A through its import, so B frames
+// are untracked Wasm frames of another function between two A activations.
+v8::WasmGuestModuleAdmission AdmitDeepDispatcher(v8::Local<v8::Context>,
+                                                 const uint8_t*, size_t,
+                                                 uint32_t function) {
+  return function == 2 ? v8::WasmGuestModuleAdmission::kAdmit
+                       : v8::WasmGuestModuleAdmission::kNotDispatcher;
+}
+void EnterDeepModule(const v8::FunctionCallbackInfo<v8::Value>& args) {
+  if (nested_enable_at_host) nested_enabled = true;
+  const auto& runners = NestedRunners(args);
+  CHECK_NOT_NULL(runners.deep_module);
+  CHECK_EQ(0, runners.deep_module->Call(runners.deep_depth));
+}
+}  // namespace
+
+TEST(RebNativeGuestParentUnresolvedFailsClosed) {
+  FlagScope<bool> sampling(&v8_flags.reb_wasm_br_table_dispatch, true);
+  FlagScope<bool> guest_frames(&v8_flags.reb_wasm_guest_capture, true);
+  HandleScope handles(CcTest::InitIsolateOnce());
+  auto* isolate = CcTest::isolate();
+  NestedGuestRunners runners;
+  auto enter = NewNestedGuestHost(isolate, EnterDeepModule, &runners);
+  auto reenter = NewNestedGuestHost(isolate, ReenterNestedGuest, &runners);
+  TestSignatures sigs;
+  ManuallyImportedJSFunction enter_import{
+      sigs.v_v(), Cast<JSFunction>(v8::Utils::OpenDirectHandle(*enter))};
+  ManuallyImportedJSFunction reenter_import{
+      sigs.v_v(), Cast<JSFunction>(v8::Utils::OpenDirectHandle(*reenter))};
+  WasmRunner<int32_t, int32_t> a(TestExecutionTier::kLiftoff, kWasmOrigin,
+                                 &enter_import);
+  auto& dispatcher = a.NewFunction<int32_t, int32_t>();
+  dispatcher.Build(
+      {B1(WASM_BR_TABLE(WASM_I32V_1(0), 1, BR_TARGET(0), BR_TARGET(0))),
+       WASM_IF(WASM_I32_EQ(WASM_LOCAL_GET(0), WASM_I32V_1(0)),
+               WASM_CALL_FUNCTION0(0)),
+       WASM_I32V_1(9)});
+  a.Build({WASM_CALL_FUNCTION(dispatcher.function_index(), WASM_LOCAL_GET(0))});
+  WasmRunner<int32_t, int32_t> b(TestExecutionTier::kLiftoff, kWasmOrigin,
+                                 &reenter_import);
+  b.Build({WASM_IF(WASM_LOCAL_GET(0),
+                   WASM_RETURN(WASM_CALL_FUNCTION(
+                       1, WASM_I32_SUB(WASM_LOCAL_GET(0), WASM_I32V_1(1))))),
+           WASM_CALL_FUNCTION0(0), WASM_I32V_1(0)});
+  runners.reentry = &a;
+  runners.deep_module = &b;
+  isolate->SetWasmGuestDispatchCallback(ObserveNestedGuest, EnableNestedGuests,
+                                        nullptr, AdmitDeepDispatcher);
+  // Untracked frames of another function are skipped within the bound.
+  ResetNestedGuests();
+  runners.deep_depth = 100;
+  CHECK_EQ(9, a.Call(0));
+  CHECK_EQ(size_t{2}, nested_activations.size());
+  CHECK_EQ(v8::WasmGuestParent::kResolved, nested_activations[1].state);
+  CHECK_EQ(nested_activations[0].invocation, nested_activations[1].parent);
+  CHECK_EQ(uint64_t{1}, nested_activations[1].parent_dispatch);
+  CHECK_EQ(uint64_t{0}, nested_parent_gaps);
+  // Past 128 Wasm frames the walk stops: no parent is named, never an older
+  // one, and the consumer records the unresolved gap.
+  ResetNestedGuests();
+  runners.deep_depth = 140;
+  CHECK_EQ(9, a.Call(0));
+  CHECK_EQ(size_t{2}, nested_activations.size());
+  CHECK_EQ(v8::WasmGuestParent::kUnresolved, nested_activations[1].state);
+  CHECK_EQ(uint64_t{0}, nested_activations[1].parent);
+  CHECK_EQ(uint64_t{1}, nested_parent_gaps);
+  // The outer activation began while capture was off, so it has no identity.
+  // The same dispatcher on the stack without identity is a possible parent:
+  // unresolved, not a top-level activation.
+  ResetNestedGuests();
+  runners.deep_depth = 10;
+  nested_enabled = false;
+  nested_enable_at_host = true;
+  CHECK_EQ(9, a.Call(0));
+  CHECK_EQ(size_t{1}, nested_activations.size());
+  CHECK_EQ(v8::WasmGuestParent::kUnresolved, nested_activations[0].state);
+  CHECK_EQ(uint64_t{1}, nested_parent_gaps);
+  // The next top-level activation is resolved again.
+  ResetNestedGuests();
+  CHECK_EQ(9, a.Call(1));
+  CHECK_EQ(v8::WasmGuestParent::kNone, nested_activations[0].state);
+  CHECK_EQ(uint64_t{0}, nested_failures);
+  isolate->SetWasmGuestDispatchCallback(nullptr, nullptr);
+}
