+  WasmRunner<int32_t> first(TestExecutionTier::kLiftoff),
+      second(TestExecutionTier::kLiftoff);
+  const std::initializer_list<const uint8_t> body{
+      B1(WASM_BR_TABLE(WASM_I32V_1(0), 1, BR_TARGET(0), BR_TARGET(0))),
+      WASM_I32V_1(7)};
+  first.Build(body);
+  second.Build(body);
+  auto *isolate = reinterpret_cast<v8::Isolate *>(first.isolate());
+  isolate->SetWasmGuestDispatchCallback(ObserveNativeGuest, EnableGuestCapture);
+  guest_high_local = false;
+  CHECK_EQ(7, first.Call());
+  const auto instance = guest_instance;
+  const auto bytes = guest_module_bytes;
+  CHECK_EQ(7, second.Call());
+  CHECK(bytes == guest_module_bytes);
+  CHECK_NE(instance, guest_instance);
+  isolate->SetWasmGuestDispatchCallback(nullptr, nullptr);
+}
+TEST(RebNativeGuestWeakIdentityLifetime) {
+  FlagScope<bool> sampling(&v8_flags.reb_wasm_br_table_dispatch, true);
+  FlagScope<bool> baseline(&v8_flags.liftoff_only, true);
+  FlagScope<bool> cache(&v8_flags.wasm_native_module_cache, false);
+  auto *internal = CcTest::InitIsolateOnce();
+  auto *isolate = CcTest::isolate();
+  DisableConservativeStackScanningScopeForTesting no_stack_roots(
+      internal->heap());
+  v8::Global<v8::Function> retained_export;
+  isolate->SetWasmGuestDispatchCallback(ObserveNativeGuest, EnableGuestCapture);
+  guest_high_local = false;
+  guest_calls = guest_failures = 0;
+  uint64_t previous_instance = 0;
+  // Reuse a collected identity slot without recycling its monotonic ID.
+  for (int iteration = 0; iteration < 2; ++iteration) {
+    {
+      v8::HandleScope handles(isolate);
+      // A real instantiated module, with memory, one dispatcher and export f.
+      // No JS reference to the WebAssembly.Instance wrapper escapes this IIFE.
+      auto value = CompileRun("(() => { const b = new Uint8Array(["
+                              "0,97,115,109,1,0,0,0,"
+                              "1,5,1,96,0,1,127,3,2,1,0,"
+                              "5,3,1,0,1,7,5,1,1,102,0,0,"
+                              "10,15,1,13,0,2,64,65,0,14,1,0,0,11,65,7,11]);"
+                              "return new WebAssembly.Instance(new "
+                              "WebAssembly.Module(b)).exports.f;"
+                              "})()");
+      CHECK(value->IsFunction());
+      auto function = value.As<v8::Function>();
+      retained_export.Reset(isolate, function);
+      CHECK_EQ(7, function
+                      ->Call(isolate->GetCurrentContext(),
+                             v8::Undefined(isolate), 0, nullptr)
+                      .ToLocalChecked()
+                      ->Int32Value(isolate->GetCurrentContext())
+                      .FromJust());
+    }
+    const uint64_t instance = guest_instance;
+    CHECK_NE(previous_instance, instance);
+    previous_instance = instance;
+    heap::InvokeMajorGC(internal->heap());
+    {
+      v8::HandleScope handles(isolate);
+      CHECK_EQ(7, retained_export.Get(isolate)
+                      ->Call(isolate->GetCurrentContext(),
+                             v8::Undefined(isolate), 0, nullptr)
+                      .ToLocalChecked()
+                      ->Int32Value(isolate->GetCurrentContext())
+                      .FromJust());
+      CHECK_EQ(instance, guest_instance);
+    }
+    retained_export.Reset();
+    // No reset/disable/next Wasm call is needed to release dead target state.
+    heap::InvokeMemoryReducingMajorGCs(internal->heap());
+    for (const auto &identity : internal->reb_guest_capture_state().instances) {
+      CHECK_NULL(identity.root);
+    }
+  }
+  CHECK_EQ(4, guest_calls);
+  CHECK_EQ(0, guest_failures);
+  isolate->SetWasmGuestDispatchCallback(nullptr, nullptr);
+}
