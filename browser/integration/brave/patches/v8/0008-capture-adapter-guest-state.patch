+bool GuestCaptureEnabled(Isolate* isolate) {
+  // Without the compile-time frame hooks no identity can be current.
+  if (!v8_flags.reb_wasm_guest_capture) return false;
+  auto& state = isolate->reb_guest_capture_state();
+  auto epoch = isolate->wasm_guest_epoch_callback();
+  const uint64_t generation = epoch ? epoch() : state.epoch;
+  auto callback = isolate->wasm_guest_dispatch_callback();
+  auto enabled = isolate->wasm_guest_enabled_callback();
+  const bool active = callback && enabled && enabled();
+  // Observed disable/re-enable intervals revoke all old frame identities.
+  // A selected boundary while disabled can therefore never expose a stale
+  // outer parent later, without walking/allocating in the disabled hot path.
+  if (state.epoch != generation || state.enabled != active) {
+    ResetRebGuestCapture(isolate);
+    state.epoch = generation;
+    state.enabled = active;
+  }
+  return active;
+}
+Isolate::RebGuestFrame* FindGuestFrame(Isolate* isolate, WasmFrame* frame) {
+  if (!frame->trusted_instance_data()->has_instance_object()) return nullptr;
+  auto& state = isolate->reb_guest_capture_state();
+  uint64_t instance_id = 0;
+  for (const auto& instance : state.instances) {
+    if (instance.root && *instance.root == frame->wasm_instance().ptr()) {
+      instance_id = instance.id;
+      break;
+    }
+  }
+  if (!instance_id) return nullptr;
+  for (auto& entry : state.frames) {
+    if (entry.fp == frame->fp() && entry.instance_id == instance_id)
+      return &entry;
+  }
+  return nullptr;
+}
+// Drops identities whose frames have returned. Returns false when the actual
+// Wasm stack is deeper than the bounded table can describe.
+bool PurgeReturnedGuestFrames(Isolate* isolate) {
+  auto& state = isolate->reb_guest_capture_state();
+  Address live[Isolate::RebGuestCaptureState::kFrameLimit]{};
+  size_t count = 0;
+  for (StackFrameIterator it(isolate); !it.done(); it.Advance()) {
+    if (!it.frame()->is_wasm()) continue;
+    if (count == std::size(live)) return false;
+    live[count++] = it.frame()->fp();
+  }
+  for (auto& saved : state.frames) {
+    bool found = false;
+    for (size_t i = 0; i < count; ++i) found |= saved.fp == live[i];
+    if (!found) saved = {};
+  }
+  return true;
+}
+// One walk of at most kFrameLimit Wasm frames, at the activation's first
+// selected boundary. The nearest enclosing activation that reached a selected
+// boundary is the parent; JavaScript frames between them (host reentry) are
+// skipped as in host attribution. An enclosing frame of the same dispatcher
+// function without identity (lost interval, untracked instance or deeper
+// table) could be that parent, so it makes the result unresolved instead of
+// skipping to an older activation. So do a non-Liftoff frame and the bound.
+void ResolveGuestParent(Isolate* isolate, WasmFrame* current,
+                        Isolate::RebGuestFrame* identity) {
+  ++isolate->reb_guest_capture_state().parent_walks;
+  identity->parent_invocation_id = 0;
+  identity->parent = v8::WasmGuestParent::kUnresolved;
+  const int function = current->GetInnermostFunctionIndex();
+  StackFrameIterator it(isolate);
+  while (!it.done() && it.frame()->fp() != current->fp()) it.Advance();
+  if (it.done()) return;
+  size_t depth = 0;
+  for (it.Advance(); !it.done(); it.Advance()) {
+    if (!it.frame()->is_wasm()) continue;
+    if (++depth > Isolate::RebGuestCaptureState::kFrameLimit) return;
+    auto* frame = static_cast<WasmFrame*>(it.frame());
+    if (!frame->wasm_code()->is_liftoff()) return;
+    if (const auto* ancestor = FindGuestFrame(isolate, frame)) {
+      if (!ancestor->selected_dispatch_seen) continue;
+      identity->parent_invocation_id = ancestor->invocation_id;
+      identity->parent = v8::WasmGuestParent::kResolved;
+      return;
+    }
+    if (frame->GetInnermostFunctionIndex() == function) return;
+  }
+  identity->parent = v8::WasmGuestParent::kNone;
+}
+bool IsRejectedGuestModule(const Isolate::RebGuestCaptureState& state,
+                           const NativeModule* module) {
+  for (const auto& rejected : state.rejected_modules) {
+    if (rejected.raw == module && !rejected.weak.expired()) return true;
+  }
+  return false;
+}
+void EnterGuestFrame(Isolate* isolate, WasmFrame* frame) {
+  auto& state = isolate->reb_guest_capture_state();
+  // Revoke a reused fp before every early return, including counter/depth caps.
+  for (auto& saved : state.frames) {
+    if (saved.fp == frame->fp()) saved = {};
+  }
+  if (!state.next_id || state.next_id == UINT64_MAX ||
+      !frame->trusted_instance_data()->has_instance_object()) {
+    return;
+  }
+  uint64_t instance_id = 0;
+  Isolate::RebGuestInstance* empty = nullptr;
+  for (auto& instance : state.instances) {
+    if (!instance.root && !empty) empty = &instance;
+    if (instance.root && *instance.root == frame->wasm_instance().ptr()) {
+      instance_id = instance.id;
+    }
+  }
+  if (!instance_id) {
+    if (!empty) return;
+    // Unrelated modules must not consume the bounded weak-identity budget.
+    // The embedder checks the configured dispatcher index before hashing and
+    // reports a definite module rejection, which is remembered (weakly, per
+    // capture interval) so a hot unrelated function is never re-hashed.
+    if (auto admit = isolate->wasm_guest_module_admission()) {
+      NativeModule* native_module = frame->native_module();
+      if (IsRejectedGuestModule(state, native_module)) return;
+      const auto instance = frame->trusted_instance_data();
+      const int function = frame->GetInnermostFunctionIndex();
+      if (!instance->has_native_context() || function < 0) return;
+      const auto bytes = native_module->wire_bytes();
+      v8::WasmGuestModuleAdmission decision;
+      {
+        HandleScope scope(isolate);
+        decision = admit(
+            Utils::ToLocal(direct_handle(instance->native_context(), isolate)),
+            bytes.data(), bytes.size(), static_cast<uint32_t>(function));
+      }
+      if (decision == v8::WasmGuestModuleAdmission::kRejectModule) {
+        auto& slot = state.rejected_modules[state.next_rejected_module++ %
+                                            std::size(state.rejected_modules)];
+        slot.raw = native_module;
+        slot.weak = instance->module_object()->native_module().as_shared_ptr();
+      }
+      if (decision != v8::WasmGuestModuleAdmission::kAdmit) return;
+    }
+    // Weak global handles are GC-updated identity keys, not lifetime roots.
+    // The fixed isolate slot outlives the handle; GC nulls this slot and
+    // releases its node without a callback when the instance becomes dead.
+    auto handle =
+        isolate->global_handles()->Create(frame->wasm_instance().ptr());
+    empty->root = handle.location();
+    GlobalHandles::MakeWeak(&empty->root);
+    empty->id = instance_id = state.next_id++;
+  }
+  if (state.next_id == UINT64_MAX) return;
+  // Returned frames are reclaimed lazily: the full stack walk runs only when
+  // the bounded table is full or the stack previously outgrew it.
+  if (state.stack_overflowed) {
+    if (!PurgeReturnedGuestFrames(isolate)) return;
+    state.stack_overflowed = false;
+  }
+  for (int attempt = 0; attempt < 2; ++attempt) {
+    for (auto& saved : state.frames) {
+      if (!saved.fp) {
+        saved = {frame->fp(), instance_id, state.next_id++};
+        return;
+      }
+    }
+    if (attempt == 0 && !PurgeReturnedGuestFrames(isolate)) break;
+  }
+  // Fail closed: deeper stacks than the table can describe lose all parents.
+  for (auto& saved : state.frames) saved = {};
+  state.stack_overflowed = true;
+}
+struct BorrowedGuestState {
+  WasmFrame* frame;
+  const RebGuestSiteDescriptor* site;
+};
+bool ReadGuestNumericLocal(void* raw, uint32_t index, uint64_t* bits,
+                           uint8_t* width) {
+  if (!raw || !bits || !width) return false;
+  const auto& state = *static_cast<BorrowedGuestState*>(raw);
+  if (!state.site || index >= state.site->locals.size()) return false;
+  const auto& local = state.site->locals[index];
+  if (local.bits != 32 && local.bits != 64) return false;
+  if (local.is_constant) {
+    *bits = local.bits == 32
+                ? static_cast<uint32_t>(local.offset_or_constant)
+                : static_cast<uint64_t>(int64_t{local.offset_or_constant});
+  } else {
+    if (local.offset_or_constant <= 0 ||
+        static_cast<uint64_t>(local.offset_or_constant) >
+            static_cast<uint64_t>(state.frame->wasm_code()->stack_slots()) *
+                kSystemPointerSize)
+      return false;
+    const Address address = state.frame->fp() - local.offset_or_constant;
+    *bits = local.bits == 32 ? ReadUnalignedValue<uint32_t>(address)
+                             : ReadUnalignedValue<uint64_t>(address);
+  }
+  *width = local.bits;
+  return true;
+}
+bool CopyGuestMemory(void* raw, uint32_t index, uint64_t offset,
+                     uint32_t length, uint8_t* output) {
+  if (!raw || !output || !length || length > 65536) return false;
+  const auto& state = *static_cast<BorrowedGuestState*>(raw);
+  const auto instance = state.frame->trusted_instance_data();
+  const auto* module = instance->module();
+  if (index >= module->memories.size() ||
+      module->memories[index].is_shared != SharedFlag::kNo ||
+      module->memories[index].is_memory64())
+    return false;
+  const size_t size = instance->memory_size(index);
+  if (offset > size || length > size - static_cast<size_t>(offset))
+    return false;
+  // Non-shared memory cannot grow/mutate in a synchronous no-JS/no-GC callback.
+  std::memcpy(output,
+              instance->memory_base(index) + static_cast<size_t>(offset),
+              length);
+  return true;
+}
+}  // namespace
+void ResetRebGuestCapture(Isolate* isolate) {
+  auto& state = isolate->reb_guest_capture_state();
+  for (auto& instance : state.instances) {
+    if (instance.root) GlobalHandles::Destroy(instance.root);
+    instance = {};
+  }
+  for (auto& frame : state.frames) frame = {};
+  for (auto& rejected : state.rejected_modules) rejected = {};
+  state.stack_overflowed = false;
+  // Never reset next_id: old observations cannot become current again.
+}
+bool GetCurrentRebGuestContext(Isolate* isolate,
+                               uint32_t dispatcher_function_index,
+                               v8::WasmGuestContext* result) {
+  if (!result || !GuestCaptureEnabled(isolate)) return false;
+  DisallowGarbageCollection no_gc;
+  WasmCodeRefScope code_scope;
+  uint64_t import_instance = 0;
+  uint32_t import_function = 0, import_offset = 0;
+  size_t depth = 0;
+  for (StackFrameIterator it(isolate); !it.done(); it.Advance()) {
+    if (!it.frame()->is_wasm()) continue;
+    if (++depth > 128) return false;
+    auto* frame = static_cast<WasmFrame*>(it.frame());
+    if (!frame->wasm_code()->is_liftoff()) return false;
+    auto* identity = FindGuestFrame(isolate, frame);
+    const int function = frame->GetInnermostFunctionIndex();
+    const int offset = frame->position();
+    // Never walk through an untracked invocation to borrow an older parent's
+    // identity, even if the untracked frame happens to share the same module.
+    if (!identity || function < 0 || offset < 0) return false;
+    if (!import_instance) {
+      import_instance = identity->instance_id;
+      import_function = static_cast<uint32_t>(function);
+      import_offset = static_cast<uint32_t>(offset);
+    }
+    if (identity->instance_id != import_instance) return false;
+    if (static_cast<uint32_t>(function) != dispatcher_function_index) continue;
+    // The same interpreter function may implement native calls without ever
+    // entering the guest loop. Skip only these actual, tracked activations.
+    // A selected-but-dropped inner boundary is still a mandatory barrier.
+    if (!identity->selected_dispatch_seen) continue;
+    *result = {identity->instance_id,
+               identity->invocation_id,
+               static_cast<uint32_t>(function),
+               static_cast<uint32_t>(offset),
+               import_function,
+               import_offset};
+    return true;
+  }
+  return false;
+}
+}  // namespace wasm
