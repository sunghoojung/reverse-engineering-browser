+namespace {
+bool guest_policy_replaced = false;
+v8::WasmGuestModuleAdmission DenyGuestModule(v8::Local<v8::Context>,
+                                             const uint8_t*, size_t, uint32_t) {
+  return v8::WasmGuestModuleAdmission::kRejectModule;
+}
+void ReplaceGuestPolicyFromHost(
+    const v8::FunctionCallbackInfo<v8::Value>& args) {
+  auto* isolate = args.GetIsolate();
+  v8::WasmGuestContext context{};
+  if (!guest_policy_replaced) {
+    CHECK(isolate->GetCurrentWasmGuestContext(guest_dispatcher, &context));
+    CHECK_EQ(guest_instance, context.instance_id);
+    // Replace the policy while the old dispatcher/helper activation is live.
+    // Both configurations use null epoch providers, so only setter invalidation
+    // can revoke the previously admitted identities.
+    isolate->SetWasmGuestDispatchCallback(
+        ObserveNativeGuest, EnableGuestCapture, nullptr, DenyGuestModule);
+    guest_policy_replaced = true;
+  }
+  CHECK(!isolate->GetCurrentWasmGuestContext(guest_dispatcher, &context));
+  CHECK_EQ(uint64_t{0}, context.instance_id);
+  CHECK_EQ(uint64_t{0}, context.invocation_id);
+}
