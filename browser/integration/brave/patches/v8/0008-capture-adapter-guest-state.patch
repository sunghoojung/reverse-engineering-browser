+struct RebGuestLocalDescriptor {
+  int32_t offset_or_constant;
+  uint8_t bits; // 0 (unreadable/reference), 32, or 64.
+  bool is_constant;
+};
+struct RebGuestDescriptorCharge {
+  static constexpr size_t kLimit = 64 * 1024 * 1024;
+  inline static std::atomic<size_t> total_bytes{0};
+  size_t bytes = 0;
+  ~RebGuestDescriptorCharge() {
+    total_bytes.fetch_sub(bytes, std::memory_order_relaxed);
+  }
+  static std::unique_ptr<RebGuestDescriptorCharge> Acquire(size_t bytes) {
+    if (bytes == 0)
+      return nullptr;
+    size_t current = total_bytes.load(std::memory_order_relaxed);
+    do {
+      if (bytes > kLimit || current > kLimit - bytes)
+        return nullptr;
+    } while (!total_bytes.compare_exchange_weak(current, current + bytes,
+                                                std::memory_order_relaxed));
+    auto charge = std::make_unique<RebGuestDescriptorCharge>();
+    charge->bytes = bytes;
+    return charge;
+  }
+};
