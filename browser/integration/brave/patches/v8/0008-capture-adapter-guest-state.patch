+TEST(RebNativeGuestPhysicalObserverClearsCallback) {
+  CheckGuestCallbackMutation(GuestCallbackMutation::kClear);
+}
+TEST(RebNativeGuestPhysicalObserverDisablesReplacement) {
+  CheckGuestCallbackMutation(GuestCallbackMutation::kDisabled);
+}
+TEST(RebNativeGuestPhysicalObserverReplacesPolicy) {
+  CheckGuestCallbackMutation(GuestCallbackMutation::kEnabled);
