+TEST(RebNativeGuestZeroLocalDescriptorBudget) {
+  FlagScope<bool> sampling(&v8_flags.reb_wasm_br_table_dispatch, true);
+  WasmCodeRefScope code_scope;
+  WasmRunner<int32_t> admitted(TestExecutionTier::kLiftoff);
+  admitted.Build(
+      {B1(WASM_BR_TABLE(WASM_I32V_1(0), 1, BR_TARGET(0), BR_TARGET(0))),
+       B1(WASM_BR_TABLE(WASM_I32V_1(0), 1, BR_TARGET(0), BR_TARGET(0))),
+       B1(WASM_BR_TABLE(WASM_I32V_1(0), 1, BR_TARGET(0), BR_TARGET(0))),
+       WASM_I32V_1(7)});
+  const auto &sites = admitted.builder().GetFunctionCode(0)->reb_guest_sites();
+  CHECK_EQ(size_t{3}, sites.size());
+  const size_t charge = RebGuestSiteDescriptor::StorageBudget(0);
+  CHECK_GT(charge, sizeof(RebGuestSiteDescriptor));
+  CHECK_EQ(size_t{0}, RebGuestSiteDescriptor::StorageBudget(SIZE_MAX));
+  size_t retained = sites.capacity() * sizeof(RebGuestSiteDescriptor);
+  for (const auto &site : sites) {
+    CHECK(site.locals.empty());
+    CHECK_NOT_NULL(site.budget);
+    CHECK_EQ(charge, site.budget->bytes);
+    retained += sizeof(RebGuestDescriptorCharge);
+  }
+  CHECK_LE(retained, sites.size() * charge);
+  CHECK_EQ(7, admitted.Call());
+
+  const size_t used =
+      RebGuestDescriptorCharge::total_bytes.load(std::memory_order_relaxed);
+  CHECK_LE(used + charge, RebGuestDescriptorCharge::kLimit);
+  auto reserved = RebGuestDescriptorCharge::Acquire(
+      RebGuestDescriptorCharge::kLimit - used - charge + 1);
+  CHECK_NOT_NULL(reserved);
+  WasmRunner<int32_t> denied(TestExecutionTier::kLiftoff);
+  denied.Build(
+      {B1(WASM_BR_TABLE(WASM_I32V_1(0), 1, BR_TARGET(0), BR_TARGET(0))),
+       WASM_I32V_1(9)});
+  CHECK(denied.builder().GetFunctionCode(0)->reb_guest_sites().empty());
+  // Budget denial is observational: actual Wasm execution remains intact.
+  CHECK_EQ(9, denied.Call());
+}
+
+TEST(RebNativeGuestDescriptorBudgetRejectsOverflow) {
+  CHECK(!RebGuestDescriptorCharge::Acquire(0));
+  CHECK(!RebGuestDescriptorCharge::Acquire(std::numeric_limits<size_t>::max()));
+  CHECK(!RebGuestDescriptorCharge::Acquire(64 * 1024 * 1024 + 1));
+}
