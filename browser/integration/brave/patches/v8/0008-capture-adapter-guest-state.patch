+TEST(RebNativeGuestRejectedModuleIsNotReadmitted) {
+  FlagScope<bool> sampling(&v8_flags.reb_wasm_br_table_dispatch, true);
+  FlagScope<bool> guest_frames(&v8_flags.reb_wasm_guest_capture, true);
+  WasmRunner<int32_t> r(TestExecutionTier::kLiftoff);
+  r.Build({B1(WASM_BR_TABLE(WASM_I32V_1(0), 1, BR_TARGET(0), BR_TARGET(0))),
+           WASM_I32V_1(5)});
+  auto* isolate = reinterpret_cast<v8::Isolate*>(r.isolate());
+  guest_calls = guest_failures = 0;
+  guest_admission_calls = 0;
+  // A definite rejection is decided once per module, not on every hot entry.
+  guest_admission_result = v8::WasmGuestModuleAdmission::kRejectModule;
+  isolate->SetWasmGuestDispatchCallback(ObserveNativeGuest, EnableGuestCapture,
+                                        nullptr, CountGuestAdmission);
+  for (int i = 0; i < 8; ++i) CHECK_EQ(5, r.Call());
+  CHECK_EQ(1, guest_admission_calls);
+  CHECK_EQ(0, guest_calls);
+  // A deferred decision is asked again at the next entry.
+  guest_admission_result = v8::WasmGuestModuleAdmission::kNotDispatcher;
+  isolate->SetWasmGuestDispatchCallback(ObserveNativeGuest, EnableGuestCapture,
+                                        nullptr, CountGuestAdmission);
+  guest_admission_calls = 0;
+  for (int i = 0; i < 3; ++i) CHECK_EQ(5, r.Call());
+  CHECK_EQ(3, guest_admission_calls);
+  CHECK_EQ(0, guest_calls);
+  // Unadmitted dispatches still reach the consumer without identities, so it
+  // revokes any previous parent instead of silently skipping the boundary.
+  CHECK_EQ(11, guest_failures);
+  guest_failures = 0;
+  // A replaced policy forgets old rejections and can admit the same module.
+  guest_admission_result = v8::WasmGuestModuleAdmission::kAdmit;
+  isolate->SetWasmGuestDispatchCallback(ObserveNativeGuest, EnableGuestCapture,
+                                        nullptr, CountGuestAdmission);
+  guest_admission_calls = 0;
+  CHECK_EQ(5, r.Call());
+  CHECK_EQ(1, guest_admission_calls);
+  CHECK_EQ(1, guest_calls);
+  CHECK_EQ(0, guest_failures);
+  isolate->SetWasmGuestDispatchCallback(nullptr, nullptr);
+}
