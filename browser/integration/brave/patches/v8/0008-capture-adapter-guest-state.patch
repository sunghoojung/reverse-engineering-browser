+namespace {
+uint32_t selected_ancestor_site = 0;
+uint64_t selected_outer_invocation = 0;
+bool selected_ancestor_enabled = true;
+bool selected_expect_inner = false;
+bool selected_disable_at_outer = false;
+bool selected_reenable_at_host = false;
+bool EnableSelectedAncestor() { return selected_ancestor_enabled; }
+bool SelectAncestorSite(uint32_t function, uint32_t offset) {
+  return function == 1 && offset == selected_ancestor_site;
+}
+void ObserveSelectedAncestor(v8::Local<v8::Context>, const uint8_t*, size_t,
+                             const v8::WasmGuestStateView& view) {
+  if (!SelectAncestorSite(view.function_index, view.module_byte_offset)) return;
+  uint64_t mode = 0;
+  uint8_t width = 0;
+  CHECK(view.read_numeric_local(view.accessor_context, 0, &mode, &width));
+  CHECK_EQ(32, width);
+  // Deliberately drop the selected inner sample. Engine ancestry must still
+  // return this inner activation, never borrow the retained outer observation.
+  if (mode == 3) return;
+  selected_outer_invocation = view.invocation_id;
+  CHECK_NE(uint64_t{0}, selected_outer_invocation);
+  if (selected_disable_at_outer) selected_ancestor_enabled = false;
+}
+void CheckSelectedAncestorHost(
+    const v8::FunctionCallbackInfo<v8::Value>& args) {
+  v8::WasmGuestContext context{};
+  if (selected_reenable_at_host) {
+    selected_ancestor_enabled = true;
+    CHECK(!args.GetIsolate()->GetCurrentWasmGuestContext(1, &context));
+    CHECK_EQ(uint64_t{0}, context.invocation_id);
+    return;
+  }
+  CHECK(args.GetIsolate()->GetCurrentWasmGuestContext(1, &context));
+  if (selected_expect_inner) {
+    CHECK_NE(selected_outer_invocation, context.invocation_id);
+  } else {
+    CHECK_EQ(selected_outer_invocation, context.invocation_id);
+  }
+}
