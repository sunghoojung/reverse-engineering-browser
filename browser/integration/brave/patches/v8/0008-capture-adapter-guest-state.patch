+namespace {
+thread_local int guest_admission_calls = 0;
+thread_local v8::WasmGuestModuleAdmission guest_admission_result =
+    v8::WasmGuestModuleAdmission::kRejectModule;
+v8::WasmGuestModuleAdmission CountGuestAdmission(v8::Local<v8::Context>,
+                                                 const uint8_t*, size_t,
+                                                 uint32_t) {
+  ++guest_admission_calls;
+  return guest_admission_result;
+}
