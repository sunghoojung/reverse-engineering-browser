+  uint32_t function_byte_offset;
+  std::vector<RebGuestLocalDescriptor> locals;
+  std::unique_ptr<RebGuestDescriptorCharge> budget;
+  static constexpr size_t kFunctionLimit = 8 * 1024 * 1024;
+  static size_t StorageBudget(size_t locals) {
+    // Logical allocation payload, not allocator bookkeeping/RSS. Explicit
+    // doubling below needs at most three site slots per retained site during
+    // reallocation (old + new arrays), plus its separately allocated charge.
+    constexpr size_t overhead =
+        3 * sizeof(RebGuestSiteDescriptor) + sizeof(RebGuestDescriptorCharge);
+    if (locals > (kFunctionLimit - overhead) / sizeof(RebGuestLocalDescriptor))
+      return 0;
