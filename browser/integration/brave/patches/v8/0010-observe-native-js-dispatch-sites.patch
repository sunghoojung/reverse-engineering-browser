+#ifndef V8_INTERPRETER_REB_JS_DISPATCH_H_
+#define V8_INTERPRETER_REB_JS_DISPATCH_H_
+
+#include <cstddef>
+#include <cstdint>
+
+#include "include/v8-callbacks.h"
+#include "src/common/globals.h"
+#include "src/objects/tagged.h"
+
+namespace v8::internal::interpreter {
+
+// Armed JavaScript dispatch anchors for one function. An anchor is the UTF-16
+// source position of a `switch` keyword or of the `[` that opens an indexed
+// callee, together with its shape.
+struct RebJsDispatchAnchors {
+  int positions[v8::kJsDispatchSiteLimit] = {};
+  v8::JsDispatchShape shapes[v8::kJsDispatchSiteLimit] = {};
+  size_t count = 0;
+
+  bool Contains(v8::JsDispatchShape shape, int position) const;
+  // Ignores duplicates; the bound is the site limit.
+  void Add(v8::JsDispatchShape shape, int position);
+};
+
+// REB native JavaScript dispatch capture (--reb-js-dispatch-capture). Holds
+// the per-isolate copy of the embedder's armed sites. It is used only on the
+// isolate's main thread: the flag keeps every bytecode generation there. All
+// tables are fixed-size, so neither inactive nor hot paths allocate.
+class RebJsDispatch final {
+ public:
+  static constexpr size_t kBindingLimit = 64;
+  static constexpr size_t kArmedFunctionLimit = 32;
+  static constexpr size_t kParentLimit = 256;
+  static constexpr int kFrameWalkLimit = 64;
+
+  void SetCallbacks(Isolate* isolate, const v8::JsDispatchCallbacks& callbacks);
+
+  // Pulls the embedder epoch. When it changed, refreshes the armed sites,
+  // starts a new activation range and reports sites whose function already
+  // had bytecode. Returns whether any site is armed.
+  bool Sync(Isolate* isolate);
+
+  // Adds the armed anchors of |script| inside [start, end) to |anchors|.
+  void AnchorsIn(Isolate* isolate, Tagged<Script> script, int start, int end,
+                 RebJsDispatchAnchors* anchors);
+
+  // Records bytecode generated with armed anchors. These are facts about
+  // bytecode, so an epoch change keeps them.
+  void RecordArmedFunction(int script_id, int function_literal_id,
+                           int activation_register,
+                           const RebJsDispatchAnchors& emitted);
+
+  // Runtime_RebTraceJsDispatch. Returns the activation register's next value.
+  Tagged<Object> Trace(Isolate* isolate, Tagged<Object> activation,
+                       Tagged<Object> selector, Tagged<Object> handler,
+                       Tagged<JSFunction> closure, int encoded_anchor);
+
+  // The Smi operand a trace passes: position and shape of its anchor.
+  static int EncodeAnchor(v8::JsDispatchShape shape, int position) {
+    return (position << 1) |
+           (shape == v8::JsDispatchShape::kIndexedCall ? 1 : 0);
+  }
+
+ private:
+  struct Site {
+    uint8_t source_sha256[32];
+    uint32_t source_length;
+    uint32_t anchor_offset;
+    v8::JsDispatchShape shape;
+    bool usable;
+  };
+  struct Binding {
+    int script_id;
+    uint32_t mask;
+  };
+  struct ArmedFunction {
+    int script_id;
+    int function_literal_id;
+    int activation_register;
+    RebJsDispatchAnchors anchors;
+  };
+  enum ParentFlags : uint8_t {
+    kParentRecorded = 1 << 0,
+    kParentUnknown = 1 << 1,
+    kParentSearchTruncated = 1 << 2,
+  };
+  struct Parent {
+    uint32_t id;
+    uint8_t flags;
+  };
+
+  bool Complete() const;
+  void Reset(uint64_t epoch);
+  uint32_t BindingMask(Tagged<Script> script);
+  void ReportCompiledBeforeArming(Isolate* isolate);
+  const ArmedFunction* FindArmedFunction(int script_id,
+                                         int function_literal_id) const;
