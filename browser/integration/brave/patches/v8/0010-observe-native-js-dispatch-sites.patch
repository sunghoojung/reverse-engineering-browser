+TEST(RebNativeJsDispatchParentActivation) {
+  LocalContext env;
+  v8::Isolate* isolate = env.isolate();
+  v8::HandleScope scope(isolate);
+  RebJsDispatchScope capture(isolate);
+  const std::string source =
+      "function rebInner(code) { var r = 0; for (var i = 0; i < code.length; "
+      "i++) { switch (code[i]) { case 0: r++; break; default: r--; } } "
+      "return r; }"
+      "var rebOuterOps = [function (s) { return s + rebInner([0, 0]); }, "
+      "function (s) { return s - 1; }];"
+      "function rebOuter(code) { var s = 0; for (var pc = 0; "
+      "pc < code.length; pc++) { s = rebOuterOps[code[pc]](s); } return s; }"
+      "function rebEarlyChild() { return rebInner([1]); }"
+      "function rebUndispatched(code) { var s = rebEarlyChild(); for (var pc "
+      "= 0; pc < code.length; pc++) { switch (code[pc]) { default: s++; } } "
+      "return s; }";
+  const v8::JsDispatchSite outer =
+      RebJsSite(source, RebAnchor(source, "rebOuterOps[code[pc]]", 11),
+                v8::JsDispatchShape::kIndexedCall);
+  const v8::JsDispatchSite inner =
+      RebJsSite(source, RebAnchor(source, "switch (code[i])"),
+                v8::JsDispatchShape::kSwitch);
+  const v8::JsDispatchSite undispatched =
+      RebJsSite(source, RebAnchor(source, "switch (code[pc])"),
+                v8::JsDispatchShape::kSwitch);
+  capture.Arm(1, {outer, inner, undispatched});
+  CompileRun(source.c_str());
+  CHECK_EQ(1,
+           CompileRun("rebOuter([0, 1])")->Int32Value(env.local()).FromJust());
+  CHECK_EQ(
+      0,
+      CompileRun("rebUndispatched([0])")->Int32Value(env.local()).FromJust());
+  const auto& records = capture.embedder().observations;
+  CHECK_EQ(6u, records.size());
+  const v8::JsDispatchObservation& outer_first = records[0].observation;
+  CHECK_EQ(0u, outer_first.slot);
+  CHECK(outer_first.new_activation);
+  CHECK_EQ(0u, outer_first.parent_activation_id);
+  CHECK(!outer_first.parent_unknown);
+  CHECK(!outer_first.parent_search_truncated);
+  // The inner interpreter runs under the outer handler.
+  for (size_t i = 1; i <= 2; ++i) {
+    const v8::JsDispatchObservation& child = records[i].observation;
+    CHECK_EQ(1u, child.slot);
+    CHECK_EQ(i == 1, child.new_activation);
+    CHECK_GT(child.activation_id, outer_first.activation_id);
+    CHECK_EQ(outer_first.activation_id, child.parent_activation_id);
+    CHECK(!child.parent_unknown);
+  }
+  const v8::JsDispatchObservation& outer_second = records[3].observation;
+  CHECK_EQ(0u, outer_second.slot);
+  CHECK(!outer_second.new_activation);
+  CHECK_EQ(outer_first.activation_id, outer_second.activation_id);
+  // The nearest armed frame had not dispatched yet: unknown, never a frame
+  // further out.
+  const v8::JsDispatchObservation& early_child = records[4].observation;
+  CHECK_EQ(1u, early_child.slot);
+  CHECK(early_child.new_activation);
+  CHECK_EQ(0u, early_child.parent_activation_id);
+  CHECK(early_child.parent_unknown);
+  const v8::JsDispatchObservation& late_outer = records[5].observation;
+  CHECK_EQ(2u, late_outer.slot);
+  CHECK(late_outer.new_activation);
+  CHECK_GT(late_outer.activation_id, early_child.activation_id);
+  CHECK_EQ(0u, late_outer.parent_activation_id);
+  CHECK(!late_outer.parent_unknown);
+}
