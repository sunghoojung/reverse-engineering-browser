+namespace v8::internal::interpreter {
+
+namespace {
+
+// Smi range for activation IDs. Admission is bounded per configuration by the
+// embedder, so exhausting this range is not reachable in practice.
+constexpr uint32_t kRebActivationIdLimit =
+    static_cast<uint32_t>(Smi::kMaxValue);
+
+// SHA-256 over the source as UTF-16LE code units, the key the analyzer
+// computes from the captured artifact text. A non-flat source is unbindable.
+bool RebSourceDigest(Tagged<String> source, uint8_t digest[32]) {
+  DisallowGarbageCollection no_gc;
+  String::FlatContent flat = source->GetFlatContent(no_gc);
+  if (!flat.IsFlat()) return false;
+  LITE_SHA256_CTX context;
+  SHA256_init(&context);
+  uint8_t chunk[512];
+  size_t used = 0;
+  auto append = [&](uint16_t unit) {
+    chunk[used++] = static_cast<uint8_t>(unit & 0xff);
+    chunk[used++] = static_cast<uint8_t>(unit >> 8);
+    if (used == sizeof(chunk)) {
+      SHA256_update(&context, chunk, used);
+      used = 0;
+    }
+  };
+  if (flat.IsOneByte()) {
+    for (uint8_t unit : flat.ToOneByteVector()) append(unit);
+  } else {
+    for (base::uc16 unit : flat.ToUC16Vector()) append(unit);
+  }
+  if (used != 0) SHA256_update(&context, chunk, used);
+  std::memcpy(digest, SHA256_final(&context), kSizeOfSha256Digest);
+  return true;
+}
+
+void RebClassifySelector(Tagged<Object> selector,
+                         JsDispatchObservation* observation) {
+  observation->selector_low32 = 0;
+  if (IsSmi(selector)) {
+    observation->selector_kind = JsDispatchSelectorKind::kInteger;
+    observation->selector_low32 =
+        static_cast<uint32_t>(Smi::ToInt(Cast<Smi>(selector)));
+  } else if (IsHeapNumber(selector)) {
+    const double value = Cast<HeapNumber>(selector)->value();
+    // [-2^63, 2^63) converts to int64 without overflow.
+    if (std::isfinite(value) && std::trunc(value) == value &&
+        value >= -9223372036854775808.0 && value < 9223372036854775808.0) {
+      observation->selector_kind = JsDispatchSelectorKind::kInteger;
+      observation->selector_low32 = static_cast<uint32_t>(
+          static_cast<uint64_t>(static_cast<int64_t>(value)));
+    } else {
+      observation->selector_kind = JsDispatchSelectorKind::kNumber;
+    }
+  } else if (IsString(selector)) {
+    observation->selector_kind = JsDispatchSelectorKind::kString;
+  } else if (IsSymbol(selector)) {
+    observation->selector_kind = JsDispatchSelectorKind::kSymbol;
+  } else if (IsUndefined(selector)) {
+    observation->selector_kind = JsDispatchSelectorKind::kUndefined;
+  } else if (IsNull(selector)) {
+    observation->selector_kind = JsDispatchSelectorKind::kNull;
+  } else if (IsTrue(selector) || IsFalse(selector)) {
+    observation->selector_kind = JsDispatchSelectorKind::kBoolean;
+    observation->selector_low32 = IsTrue(selector) ? 1 : 0;
+  } else if (IsBigInt(selector)) {
+    observation->selector_kind = JsDispatchSelectorKind::kBigInt;
+  } else {
+    observation->selector_kind = JsDispatchSelectorKind::kObject;
+  }
+}
+
+}  // namespace
+
+bool RebJsDispatchAnchors::Contains(JsDispatchShape shape, int position) const {
+  for (size_t i = 0; i < count; ++i) {
+    if (positions[i] == position && shapes[i] == shape) return true;
+  }
+  return false;
+}
+
+void RebJsDispatchAnchors::Add(JsDispatchShape shape, int position) {
+  if (count == kJsDispatchSiteLimit || Contains(shape, position)) return;
+  positions[count] = position;
+  shapes[count] = shape;
+  ++count;
+}
+
+void RebJsDispatch::SetCallbacks(Isolate* isolate,
+                                 const JsDispatchCallbacks& callbacks) {
+  callbacks_ = callbacks;
+  synced_ = false;
+  Reset(0);
+  Sync(isolate);
+}
+
+bool RebJsDispatch::Complete() const {
+  return callbacks_.epoch != nullptr && callbacks_.sites != nullptr &&
+         callbacks_.enabled != nullptr && callbacks_.observe != nullptr &&
+         callbacks_.status != nullptr;
+}
+
+void RebJsDispatch::Reset(uint64_t epoch) {
+  epoch_ = epoch;
+  any_armed_ = false;
+  site_count_ = 0;
+  binding_count_ = 0;
+  next_binding_ = 0;
+  activation_floor_ = next_activation_;
+  for (Parent& parent : parents_) parent = {};
+}
+
+bool RebJsDispatch::Sync(Isolate* isolate) {
+  if (!v8_flags.reb_js_dispatch_capture || !Complete()) {
+    if (any_armed_) Reset(0);
+    return false;
+  }
+  const uint64_t epoch = callbacks_.epoch();
+  if (synced_ && epoch == epoch_) return any_armed_;
+  synced_ = true;
+  Reset(epoch);
+  if (epoch == 0) return false;
+  JsDispatchSite copied[kJsDispatchSiteLimit] = {};
+  size_t count = callbacks_.sites(epoch, copied, kJsDispatchSiteLimit);
+  if (count > kJsDispatchSiteLimit) count = kJsDispatchSiteLimit;
+  for (size_t slot = 0; slot < count; ++slot) {
+    const JsDispatchSite& from = copied[slot];
+    Site& to = sites_[slot];
+    std::memcpy(to.source_sha256, from.source_sha256, sizeof(to.source_sha256));
+    to.source_length = from.source_length;
+    to.anchor_offset = from.anchor_offset;
+    to.shape = from.shape;
+    // Positions travel as Smi operands, so they must stay within a string.
+    to.usable =
+        (from.shape == JsDispatchShape::kSwitch ||
+         from.shape == JsDispatchShape::kIndexedCall) &&
+        from.source_length != 0 &&
+        from.source_length <= static_cast<uint32_t>(String::kMaxLength) &&
+        from.anchor_offset < from.source_length;
+    any_armed_ = any_armed_ || to.usable;
+  }
+  site_count_ = count;
+  if (any_armed_) ReportCompiledBeforeArming(isolate);
+  return any_armed_;
+}
+
+uint32_t RebJsDispatch::BindingMask(Tagged<Script> script) {
+  if (script->type() != Script::Type::kNormal || script->id() <= 0 ||
+      !IsString(script->source())) {
+    return 0;
+  }
+  const int script_id = script->id();
+  for (size_t i = 0; i < binding_count_; ++i) {
+    if (bindings_[i].script_id == script_id) return bindings_[i].mask;
+  }
+  Tagged<String> source = Cast<String>(script->source());
+  const uint32_t length = source->length();
+  bool length_matches = false;
+  for (size_t slot = 0; slot < site_count_; ++slot) {
+    length_matches = length_matches || (sites_[slot].usable &&
+                                        sites_[slot].source_length == length);
+  }
+  // Most scripts are rejected here without hashing or a cache entry.
+  if (!length_matches) return 0;
+  uint8_t digest[kSizeOfSha256Digest];
+  if (!RebSourceDigest(source, digest)) return 0;
+  uint32_t mask = 0;
+  for (size_t slot = 0; slot < site_count_; ++slot) {
+    const Site& site = sites_[slot];
+    if (site.usable && site.source_length == length &&
+        std::memcmp(site.source_sha256, digest, sizeof(digest)) == 0) {
+      mask |= 1u << slot;
+    }
+  }
+  // Negative results are cached too; eviction only costs a rehash.
+  bindings_[next_binding_] = {script_id, mask};
+  next_binding_ = (next_binding_ + 1) % kBindingLimit;
+  if (binding_count_ < kBindingLimit) ++binding_count_;
+  return mask;
+}
+
+void RebJsDispatch::AnchorsIn(Isolate* isolate, Tagged<Script> script,
+                              int start, int end,
+                              RebJsDispatchAnchors* anchors) {
+  if (!Sync(isolate)) return;
+  const uint32_t mask = BindingMask(script);
+  for (size_t slot = 0; slot < site_count_; ++slot) {
+    if ((mask & (1u << slot)) == 0) continue;
+    const int anchor = static_cast<int>(sites_[slot].anchor_offset);
+    if (anchor >= start && anchor < end) {
+      anchors->Add(sites_[slot].shape, anchor);
+    }
+  }
+}
+
+void RebJsDispatch::RecordArmedFunction(int script_id, int function_literal_id,
+                                        int activation_register,
+                                        const RebJsDispatchAnchors& emitted) {
+  ArmedFunction* entry = nullptr;
+  for (size_t i = 0; i < armed_function_count_; ++i) {
+    if (armed_functions_[i].script_id == script_id &&
+        armed_functions_[i].function_literal_id == function_literal_id) {
+      entry = &armed_functions_[i];
+      break;
+    }
+  }
+  if (entry == nullptr) {
+    // Oldest first. A lost entry only stops parent linking through it.
+    entry = &armed_functions_[next_armed_function_];
+    next_armed_function_ = (next_armed_function_ + 1) % kArmedFunctionLimit;
+    if (armed_function_count_ < kArmedFunctionLimit) ++armed_function_count_;
+  }
+  *entry = {script_id, function_literal_id, activation_register, emitted};
+}
+
+const RebJsDispatch::ArmedFunction* RebJsDispatch::FindArmedFunction(
+    int script_id, int function_literal_id) const {
+  for (size_t i = 0; i < armed_function_count_; ++i) {
+    if (armed_functions_[i].script_id == script_id &&
+        armed_functions_[i].function_literal_id == function_literal_id) {
+      return &armed_functions_[i];
+    }
+  }
+  return nullptr;
+}
+
+bool RebJsDispatch::CurrentlyArmed(const ArmedFunction& function,
+                                   Tagged<Script> script) {
+  const uint32_t mask = BindingMask(script);
+  for (size_t slot = 0; slot < site_count_; ++slot) {
+    if ((mask & (1u << slot)) != 0 &&
+        function.anchors.Contains(
+            sites_[slot].shape, static_cast<int>(sites_[slot].anchor_offset))) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void RebJsDispatch::ReportCompiledBeforeArming(Isolate* isolate) {
+  DisallowGarbageCollection no_gc;
+  Script::Iterator scripts(isolate);
+  for (Tagged<Script> script = scripts.Next(); !script.is_null();
+       script = scripts.Next()) {
+    const uint32_t mask = BindingMask(script);
+    if (mask == 0) continue;
+    Tagged<WeakFixedArray> infos = script->infos();
+    const uint32_t info_count = infos->ulength().value();
+    for (size_t slot = 0; slot < site_count_; ++slot) {
+      if ((mask & (1u << slot)) == 0) continue;
+      const int anchor = static_cast<int>(sites_[slot].anchor_offset);
+      // The innermost function containing the anchor. A compiled function
+      // has SharedFunctionInfos for its inner functions, so a compiled
+      // innermost function holds the anchor in its own bytecode.
+      Tagged<SharedFunctionInfo> innermost;
+      int innermost_length = 0;
+      for (uint32_t i = 0; i < info_count; ++i) {
+        Tagged<HeapObject> object;
+        if (!infos->get(i).GetHeapObject(&object) ||
+            !IsSharedFunctionInfo(object)) {
+          continue;
+        }
+        Tagged<SharedFunctionInfo> shared = Cast<SharedFunctionInfo>(object);
+        const int start = shared->StartPosition();
+        const int end = shared->EndPosition();
+        if (start <= anchor && anchor < end &&
+            (innermost.is_null() || end - start < innermost_length)) {
+          innermost = shared;
+          innermost_length = end - start;
+        }
+      }
+      if (innermost.is_null() || !innermost->is_compiled()) continue;
+      const ArmedFunction* armed = FindArmedFunction(
+          script->id(), innermost->function_literal_id(kRelaxedLoad));
+      if (armed != nullptr &&
+          armed->anchors.Contains(sites_[slot].shape, anchor)) {
+        continue;
+      }
+      callbacks_.status(epoch_, static_cast<uint32_t>(slot),
+                        JsDispatchSiteStatus::kCompiledBeforeArming,
+                        script->id());
+    }
+  }
+}
+
+bool RebJsDispatch::IsCurrentActivation(Tagged<Object> value) const {
+  if (!IsSmi(value)) return false;
+  const int id = Smi::ToInt(Cast<Smi>(value));
+  return id > 0 && static_cast<uint32_t>(id) >= activation_floor_ &&
+         static_cast<uint32_t>(id) < next_activation_;
+}
+
+void RebJsDispatch::FindParent(Isolate* isolate, Tagged<JSFunction> closure,
+                               uint32_t* parent, uint8_t* flags) {
+  JavaScriptStackFrameIterator frames(isolate);
+  // The innermost JavaScript frame is the armed function calling the runtime.
+  if (frames.done() || frames.frame()->function() != closure) {
+    *flags = static_cast<uint8_t>(*flags | kParentUnknown);
+    return;
+  }
+  frames.Advance();
+  for (int walked = 0; !frames.done(); frames.Advance()) {
+    if (++walked > kFrameWalkLimit) {
+      *flags = static_cast<uint8_t>(*flags | kParentSearchTruncated);
+      return;
+    }
+    JavaScriptFrame* frame = frames.frame();
+    // Armed functions are never optimized or inlined, so an armed activation
+    // is always an interpreter or Sparkplug frame.
+    if (!frame->is_unoptimized()) continue;
+    Tagged<SharedFunctionInfo> shared = frame->function()->shared();
+    if (!IsScript(shared->script())) continue;
+    Tagged<Script> script = Cast<Script>(shared->script());
+    const ArmedFunction* armed = FindArmedFunction(
+        script->id(), shared->function_literal_id(kRelaxedLoad));
+    if (armed == nullptr || !CurrentlyArmed(*armed, script)) continue;
+    // The nearest armed frame decides. One that has not dispatched in this
+    // configuration leaves the parent unknown rather than looking further.
+    Tagged<Object> value =
+        UnoptimizedJSFrame::cast(frame)->ReadInterpreterRegister(
+            armed->activation_register);
+    if (IsCurrentActivation(value)) {
+      *parent = static_cast<uint32_t>(Smi::ToInt(Cast<Smi>(value)));
+    } else {
+      *flags = static_cast<uint8_t>(*flags | kParentUnknown);
+    }
+    return;
+  }
+}
+
+Tagged<Object> RebJsDispatch::Trace(Isolate* isolate, Tagged<Object> activation,
+                                    Tagged<Object> selector,
+                                    Tagged<Object> handler,
+                                    Tagged<JSFunction> closure,
+                                    int encoded_anchor) {
+  if (!Sync(isolate)) return activation;
+  Tagged<SharedFunctionInfo> shared = closure->shared();
+  if (!IsScript(shared->script())) return activation;
+  Tagged<Script> script = Cast<Script>(shared->script());
+  const JsDispatchShape shape = (encoded_anchor & 1) != 0
+                                    ? JsDispatchShape::kIndexedCall
+                                    : JsDispatchShape::kSwitch;
+  const uint32_t anchor = static_cast<uint32_t>(encoded_anchor >> 1);
+  const uint32_t mask = BindingMask(script);
+  size_t slot = site_count_;
+  for (size_t i = 0; i < site_count_; ++i) {
+    if ((mask & (1u << i)) != 0 && sites_[i].anchor_offset == anchor &&
+        sites_[i].shape == shape) {
+      slot = i;
+      break;
+    }
+  }
+  // Bytecode armed by an earlier configuration keeps its call; it returns
+  // here unless the current configuration arms the same site.
+  if (slot == site_count_) return activation;
+  if (!callbacks_.enabled(epoch_, static_cast<uint32_t>(slot))) {
+    return activation;
+  }
+
+  uint32_t id = 0;
+  uint32_t parent = 0;
+  uint8_t flags = 0;
+  bool new_activation = false;
+  if (IsCurrentActivation(activation)) {
+    id = static_cast<uint32_t>(Smi::ToInt(Cast<Smi>(activation)));
+    const uint32_t index = id - activation_floor_;
+    if (index < kParentLimit &&
+        (parents_[index].flags & kParentRecorded) != 0) {
+      parent = parents_[index].id;
+      flags = parents_[index].flags;
+    } else {
+      flags = kParentUnknown;
+    }
+  } else {
+    if (next_activation_ >= kRebActivationIdLimit) return activation;
+    id = next_activation_++;
+    new_activation = true;
+    FindParent(isolate, closure, &parent, &flags);
+    const uint32_t index = id - activation_floor_;
+    if (index < kParentLimit) {
+      parents_[index] = {parent, static_cast<uint8_t>(flags | kParentRecorded)};
+    }
+  }
+
+  JsDispatchObservation observation = {};
+  observation.slot = static_cast<uint32_t>(slot);
+  observation.script_id = script->id();
+  observation.source_length = sites_[slot].source_length;
+  observation.anchor_offset = anchor;
+  observation.shape = shape;
+  RebClassifySelector(selector, &observation);
+  if (shape == JsDispatchShape::kIndexedCall && IsJSFunction(handler)) {
+    Tagged<SharedFunctionInfo> target = Cast<JSFunction>(handler)->shared();
+    if (IsScript(target->script())) {
+      const int target_script = Cast<Script>(target->script())->id();
+      const int start = target->StartPosition();
+      const int end = target->EndPosition();
+      if (target_script > 0 && start >= 0 && end > start) {
+        observation.handler_script_id = target_script;
+        observation.handler_start = static_cast<uint32_t>(start);
+        observation.handler_end = static_cast<uint32_t>(end);
+      }
+    }
+  }
+  observation.activation_id = id;
+  observation.parent_activation_id = parent;
+  observation.new_activation = new_activation;
+  observation.parent_unknown = (flags & kParentUnknown) != 0;
+  observation.parent_search_truncated = (flags & kParentSearchTruncated) != 0;
+  observation.source_sha256 = sites_[slot].source_sha256;
+
+  HandleScope scope(isolate);
+  callbacks_.observe(
+      Utils::ToLocal(direct_handle(closure->native_context(), isolate)), epoch_,
+      observation);
+  return Smi::FromInt(static_cast<int>(id));
+}
