+TEST(RebNativeJsDispatchIndexedCallHandlerSpan) {
+  LocalContext env;
+  v8::Isolate* isolate = env.isolate();
+  v8::HandleScope scope(isolate);
+  RebJsDispatchScope capture(isolate);
+  const std::string source =
+      "var rebOps = [function rebAdd(s) { return s + 1; }, "
+      "function rebDouble(s) { return s * 2; }];"
+      "function rebTable(code) { var s = 1; for (var pc = 0; "
+      "pc < code.length; pc++) { s = rebOps[code[pc]](s); "
+      "s = rebOps[code[pc]].call(null, s); } return s; }";
+  const v8::JsDispatchSite direct =
+      RebJsSite(source, RebAnchor(source, "rebOps[code[pc]](s)", 6),
+                v8::JsDispatchShape::kIndexedCall);
+  const v8::JsDispatchSite with_call =
+      RebJsSite(source, RebAnchor(source, "rebOps[code[pc]].call", 6),
+                v8::JsDispatchShape::kIndexedCall);
+  CHECK_EQ('[', source[direct.anchor_offset]);
+  CHECK_EQ('[', source[with_call.anchor_offset]);
+  capture.Arm(1, {direct, with_call});
+  CompileRun(source.c_str());
+  CHECK_EQ(12,
+           CompileRun("rebTable([0, 1])")->Int32Value(env.local()).FromJust());
+  i::DirectHandle<i::JSFunction> handlers[] = {RebFunction("rebOps[0]"),
+                                               RebFunction("rebOps[1]")};
+  const int script_id = RebScriptId(RebFunction("rebTable"));
+  const auto& records = capture.embedder().observations;
+  CHECK_EQ(4u, records.size());
+  for (size_t i = 0; i < records.size(); ++i) {
+    const uint32_t opcode = static_cast<uint32_t>(i / 2);
+    const bool is_call_form = (i % 2) != 0;
+    CheckRebDispatch(records[i], is_call_form ? 1 : 0,
+                     is_call_form ? with_call : direct, script_id);
+    const v8::JsDispatchObservation& observation = records[i].observation;
+    CHECK(observation.selector_kind == v8::JsDispatchSelectorKind::kInteger);
+    CHECK_EQ(opcode, observation.selector_low32);
+    i::Tagged<i::SharedFunctionInfo> handler = handlers[opcode]->shared();
+    CHECK_EQ(script_id, observation.handler_script_id);
+    CHECK_EQ(static_cast<uint32_t>(handler->StartPosition()),
+             observation.handler_start);
+    CHECK_EQ(static_cast<uint32_t>(handler->EndPosition()),
+             observation.handler_end);
+    CHECK_EQ(records[0].observation.activation_id, observation.activation_id);
+    CHECK_EQ(i == 0, observation.new_activation);
+  }
+  CHECK_EQ(2, RebBytecodeOf("rebTable").traces);
+}
