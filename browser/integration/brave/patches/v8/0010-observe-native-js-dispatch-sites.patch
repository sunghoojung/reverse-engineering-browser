+// The keyed member whose `[` anchors an indexed-call dispatch site: t[k](...),
+// or t[k].call(...) and t[k].apply(...). Optional chains, super, private names
+// and %reflect_apply spreads are never instrumented.
+Property* RebIndexedCallProperty(Call* expr) {
+  if (expr->is_optional_chain_link() ||
+      expr->spread_position() == Call::kHasNonFinalSpread) {
+    return nullptr;
+  }
+  Property* property = expr->expression()->AsProperty();
+  if (property == nullptr || property->is_optional_chain_link()) {
+    return nullptr;
+  }
+  switch (expr->GetCallType()) {
+    case Call::KEYED_PROPERTY_CALL:
+      return Property::GetAssignType(property) == KEYED_PROPERTY ? property
+                                                                 : nullptr;
+    case Call::NAMED_PROPERTY_CALL: {
+      const AstRawString* name =
+          property->key()->AsLiteral()->AsRawPropertyName();
+      if (!name->IsOneByteEqualTo("call") && !name->IsOneByteEqualTo("apply")) {
+        return nullptr;
+      }
+      Property* keyed = property->obj()->AsProperty();
+      if (keyed == nullptr || keyed->is_optional_chain_link() ||
+          keyed->IsPrivateReference() ||
+          Property::GetAssignType(keyed) != KEYED_PROPERTY) {
+        return nullptr;
+      }
+      return keyed;
+    }
+    default:
+      return nullptr;
+  }
+}
+
+// Whether a function directly contains an armed site, without descending
+// into inner functions, which compile separately. A function without one
+// keeps exactly its unarmed bytecode.
+class RebArmedSiteFinder final
+    : public AstTraversalVisitor<RebArmedSiteFinder> {
+ public:
+  RebArmedSiteFinder(uintptr_t stack_limit, FunctionLiteral* root,
+                     const RebJsDispatchAnchors& anchors)
+      : AstTraversalVisitor<RebArmedSiteFinder>(stack_limit, root),
+        root_(root),
+        anchors_(anchors) {}
+
+  bool VisitNode(AstNode* node) {
+    if (found_) return false;
+    if (node != root_ && node->IsFunctionLiteral()) return false;
+    if (SwitchStatement* statement = node->AsSwitchStatement()) {
+      found_ =
+          anchors_.Contains(JsDispatchShape::kSwitch, statement->position());
+    } else if (Call* call = node->AsCall()) {
+      Property* keyed = RebIndexedCallProperty(call);
+      found_ =
+          keyed != nullptr &&
+          anchors_.Contains(JsDispatchShape::kIndexedCall, keyed->position());
+    }
+    return !found_;
+  }
+
+  bool found() const { return found_; }
+
+ private:
+  FunctionLiteral* const root_;
+  const RebJsDispatchAnchors& anchors_;
+  bool found_ = false;
+};
+
