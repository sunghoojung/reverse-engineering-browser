+  bool IsCurrentActivation(Tagged<Object> value) const;
+  void FindParent(Isolate* isolate, Tagged<JSFunction> closure,
+                  uint32_t* parent, uint8_t* flags);
+
+  v8::JsDispatchCallbacks callbacks_;
+  bool synced_ = false;
+  bool any_armed_ = false;
+  uint64_t epoch_ = 0;
+  Site sites_[v8::kJsDispatchSiteLimit] = {};
+  size_t site_count_ = 0;
+  Binding bindings_[kBindingLimit] = {};
+  size_t binding_count_ = 0;
+  size_t next_binding_ = 0;
+  ArmedFunction armed_functions_[kArmedFunctionLimit] = {};
+  size_t armed_function_count_ = 0;
+  size_t next_armed_function_ = 0;
+  // Activation IDs are never reused. IDs below activation_floor_ belong to an
+  // earlier epoch, so an activation never carries a stale configuration's ID.
+  uint32_t next_activation_ = 1;
+  uint32_t activation_floor_ = 1;
+  Parent parents_[kParentLimit] = {};
