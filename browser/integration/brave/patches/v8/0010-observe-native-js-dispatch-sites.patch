+// REB native JavaScript dispatch capture. Inactive unless V8 runs with
+// --reb-js-dispatch-capture (off by default) and the embedder reports a
+// nonzero epoch. Positions are UTF-16 code-unit offsets into Script::source.
+constexpr size_t kJsDispatchSiteLimit = 8;
+
+enum class JsDispatchShape : uint8_t {
+  // SwitchStatement; the anchor is the `switch` keyword.
+  kSwitch = 1,
+  // t[k](...), t[k].call(...) or t[k].apply(...); the anchor is the `[`.
+  kIndexedCall = 2,
+};
+
+struct JsDispatchSite {
+  // SHA-256 of the script source as UTF-16LE code units.
+  uint8_t source_sha256[32];
+  uint32_t source_length;  // UTF-16 code units.
+  uint32_t anchor_offset;  // UTF-16 code units.
+  JsDispatchShape shape;
+};
+
+enum class JsDispatchSelectorKind : uint8_t {
+  kInteger = 1,  // Smi, or a Number with an integral value in int64 range.
+  kNumber = 2,   // Any other Number, including NaN and infinities.
+  kString = 3,
+  kSymbol = 4,
+  kUndefined = 5,
+  kNull = 6,
+  kBoolean = 7,
+  kBigInt = 8,
+  kObject = 9,
+};
+
+struct JsDispatchObservation {
+  // Index of the armed site, below kJsDispatchSiteLimit.
+  uint32_t slot;
+  int script_id;           // Script of the dispatching function.
+  uint32_t source_length;  // UTF-16 code units.
+  uint32_t anchor_offset;  // UTF-16 code units.
+  JsDispatchShape shape;
+  JsDispatchSelectorKind selector_kind;
+  // Integer: low 32 bits of the two's-complement value. Boolean: 0 or 1.
+  // Every other kind: 0. No string, symbol, BigInt or object content.
+  uint32_t selector_low32;
+  // Nonzero only for an indexed call whose callee is a JSFunction with a
+  // Script; then handler_start < handler_end are its SharedFunctionInfo
+  // StartPosition and EndPosition.
+  int handler_script_id;
+  uint32_t handler_start;
+  uint32_t handler_end;
+  uint32_t activation_id;         // Nonzero.
+  uint32_t parent_activation_id;  // 0 when none was found.
+  bool new_activation;            // First admitted dispatch of this activation.
+  bool parent_unknown;            // Nearest armed frame had not dispatched yet.
+  bool parent_search_truncated;   // 64-frame walk ended without an armed frame.
+  const uint8_t* source_sha256;   // 32 bytes, borrowed for the call only.
+};
+
+enum class JsDispatchSiteStatus : uint8_t {
+  // The function containing this armed anchor already had bytecode generated
+  // without it when arming began. It becomes observable after regeneration.
+  kCompiledBeforeArming = 1,
+};
+
+// Current embedder capture epoch; 0 means inactive. Must not call into V8.
+using JsDispatchEpochCallback = uint64_t (*)();
+// Copies at most capacity armed sites for epoch and returns the count (0 when
+// epoch is no longer current). Must not call into V8.
+using JsDispatchSitesCallback = size_t (*)(uint64_t epoch,
+                                           JsDispatchSite* sites,
+                                           size_t capacity);
+// Cheap admission before any frame walk or handle. Must not allocate or call
+// into V8. Embedders reject inactive, expired and budget-exhausted captures.
+using JsDispatchEnabledCallback = bool (*)(uint64_t epoch, uint32_t slot);
+// Synchronous on the isolate thread. Do not execute JS, allocate V8 heap
+// objects, retain pointers, block, or perform I/O.
+using JsDispatchObservationCallback =
+    void (*)(Local<Context> context, uint64_t epoch,
+             const JsDispatchObservation& observation);
+// Same restrictions; no context is available.
+using JsDispatchStatusCallback = void (*)(uint64_t epoch, uint32_t slot,
+                                          JsDispatchSiteStatus status,
+                                          int script_id);
+
+struct JsDispatchCallbacks {
+  JsDispatchEpochCallback epoch = nullptr;
+  JsDispatchSitesCallback sites = nullptr;
+  JsDispatchEnabledCallback enabled = nullptr;
+  JsDispatchObservationCallback observe = nullptr;
+  JsDispatchStatusCallback status = nullptr;
+};
