+TEST(RebNativeJsDispatchLateArmingAndLazyFunctions) {
+  LocalContext env;
+  v8::Isolate* isolate = env.isolate();
+  v8::HandleScope scope(isolate);
+  RebJsDispatchScope capture(isolate);
+  const std::string source =
+      "function rebEarly(code) { var r = 0; for (var i = 0; i < code.length; "
+      "i++) { switch (code[i]) { case 0: r++; break; default: r--; } } "
+      "return r; }"
+      "function rebLate(code) { var r = 0; for (var i = 0; i < code.length; "
+      "i++) { switch (code[i]) { case 0: r += 2; break; default: r -= 2; } } "
+      "return r; }"
+      "function rebOuterLazy() { function rebInnerLazy(code) { var r = 0; "
+      "for (var i = 0; i < code.length; i++) { switch (code[i]) { "
+      "case 0: r += 3; break; default: r -= 3; } } return r; } "
+      "return rebInnerLazy; }"
+      "rebEarly([0]);";
+  // Compiled while inactive: rebEarly has bytecode, the others are lazy.
+  CompileRun(source.c_str());
+  const v8::JsDispatchSite early =
+      RebJsSite(source, RebAnchor(source, "switch (code[i]) { case 0: r++"),
+                v8::JsDispatchShape::kSwitch);
+  const v8::JsDispatchSite late =
+      RebJsSite(source, RebAnchor(source, "switch (code[i]) { case 0: r += 2"),
+                v8::JsDispatchShape::kSwitch);
+  const v8::JsDispatchSite inner =
+      RebJsSite(source, RebAnchor(source, "switch (code[i]) { case 0: r += 3"),
+                v8::JsDispatchShape::kSwitch);
+  capture.Arm(1, {early, late, inner});
+  CHECK_EQ(0,
+           CompileRun("rebLate([0, 1])")->Int32Value(env.local()).FromJust());
+  CHECK_EQ(1, CompileRun("rebEarly([0])")->Int32Value(env.local()).FromJust());
+  CHECK_EQ(
+      3, CompileRun("rebOuterLazy()([0])")->Int32Value(env.local()).FromJust());
+  const int script_id = RebScriptId(RebFunction("rebEarly"));
+  const auto& statuses = capture.embedder().statuses;
+  CHECK_EQ(1u, statuses.size());
+  CHECK_EQ(0u, statuses[0].first);
+  CHECK_EQ(script_id, statuses[0].second);
+  const auto& records = capture.embedder().observations;
+  CHECK_EQ(3u, records.size());
+  CheckRebDispatch(records[0], 1, late, script_id);
+  CheckRebDispatch(records[1], 1, late, script_id);
+  CheckRebDispatch(records[2], 2, inner, script_id);
+  CHECK_EQ(0, RebBytecodeOf("rebEarly").traces);
+  CHECK_EQ(0, RebBytecodeOf("rebOuterLazy").traces);
+}
