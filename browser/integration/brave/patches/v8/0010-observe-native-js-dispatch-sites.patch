+TEST(RebNativeJsDispatchSparkplugAndNoOptimization) {
+  i::FlagScope<bool> natives(&i::v8_flags.allow_natives_syntax, true);
+  LocalContext env;
+  v8::Isolate* isolate = env.isolate();
+  i::Isolate* i_isolate = CcTest::i_isolate();
+  v8::HandleScope scope(isolate);
+  RebJsDispatchScope capture(isolate);
+  const std::string source =
+      "function rebTier(code) { var r = 0; for (var i = 0; i < code.length; "
+      "i++) { switch (code[i]) { case 0: r++; break; default: r--; } } "
+      "return r; }"
+      "rebTier([0]);";
+  capture.Arm(1, {RebJsSite(source, RebAnchor(source, "switch"),
+                            v8::JsDispatchShape::kSwitch)});
+  CompileRun(source.c_str());
+  i::DirectHandle<i::JSFunction> function = RebFunction("rebTier");
+  CHECK(function->shared()->optimization_disabled(i::CodeKind::TURBOFAN_JS));
+  CHECK(function->shared()->optimization_disabled(i::CodeKind::MAGLEV));
+  CHECK_EQ(1u, capture.embedder().observations.size());
+  CompileRun(
+      "%PrepareFunctionForOptimization(rebTier); rebTier([0]);"
+      "%OptimizeFunctionOnNextCall(rebTier); rebTier([1]);");
+  CHECK(!function->HasAttachedOptimizedCode(i_isolate));
+  CHECK_EQ(3u, capture.embedder().observations.size());
+#ifdef V8_ENABLE_SPARKPLUG
+  {
+    i::FlagScope<bool> sparkplug(&i::v8_flags.sparkplug, true);
+    i::IsCompiledScope is_compiled_scope(
+        function->shared()->is_compiled_scope(i_isolate));
+    if (i::Compiler::CompileBaseline(i_isolate, function,
+                                     i::Compiler::CLEAR_EXCEPTION,
+                                     &is_compiled_scope)) {
+      // Sparkplug compiles the trace as an ordinary runtime call.
+      CHECK(function->ActiveTierIsBaseline(i_isolate));
+      CompileRun("rebTier([0, 1])");
+      CHECK_EQ(5u, capture.embedder().observations.size());
+    }
+  }
+#endif  // V8_ENABLE_SPARKPLUG
+}
