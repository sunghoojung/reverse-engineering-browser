+TEST(RebNativeJsDispatchFlushRegenerationAndRearm) {
+  i::FlagScope<bool> flush(&i::v8_flags.flush_bytecode, true);
+#ifdef V8_ENABLE_SPARKPLUG
+  // Baseline code would keep the bytecode from being flushed.
+  i::FlagScope<bool> sparkplug(&i::v8_flags.sparkplug, false);
+  i::FlagScope<bool> always_sparkplug(&i::v8_flags.always_sparkplug, false);
+#endif  // V8_ENABLE_SPARKPLUG
+  LocalContext env;
+  v8::Isolate* isolate = env.isolate();
+  v8::HandleScope scope(isolate);
+  RebJsDispatchScope capture(isolate);
+  const std::string source =
+      "function rebFlush(code) { var r = 0; for (var i = 0; i < code.length; "
+      "i++) { switch (code[i]) { case 0: r++; break; default: r--; } } "
+      "return r; }"
+      "rebFlush([0]);";
+  const v8::JsDispatchSite site = RebJsSite(source, RebAnchor(source, "switch"),
+                                            v8::JsDispatchShape::kSwitch);
+  capture.Arm(1, {site});
+  CompileRun(source.c_str());
+  i::IndirectHandle<i::JSFunction> function = RebFunction("rebFlush");
+  CHECK_EQ(1, RebBytecodeOf("rebFlush").traces);
+  CHECK_EQ(1u, capture.embedder().observations.size());
+
+  auto flush_bytecode = [&]() {
+    i::SharedFunctionInfo::EnsureOldForTesting(function->shared());
+    i::DisableConservativeStackScanningScopeForTesting no_stack_scanning(
+        CcTest::heap());
+    i::heap::InvokeMajorGC(CcTest::heap());
+    CHECK(!function->shared()->is_compiled());
+  };
+  // Regeneration in the same configuration keeps the site armed.
+  flush_bytecode();
+  CompileRun("rebFlush([0, 1])");
+  CHECK(function->shared()->is_compiled());
+  CHECK_EQ(1, RebBytecodeOf("rebFlush").traces);
+  CHECK_EQ(3u, capture.embedder().observations.size());
+
+  // A new configuration arming the same site keeps the compiled bytecode
+  // observable and starts a new activation range.
+  const uint32_t previous =
+      capture.embedder().observations.back().observation.activation_id;
+  capture.Arm(2, {site});
+  CompileRun("rebFlush([1])");
+  CHECK_EQ(4u, capture.embedder().observations.size());
+  const RebJsDispatchRecord& rearmed = capture.embedder().observations.back();
+  CHECK_EQ(2u, rearmed.epoch);
+  CHECK(rearmed.observation.new_activation);
+  CHECK_GT(rearmed.observation.activation_id, previous);
+  CHECK(capture.embedder().statuses.empty());
+
+  // Without the site, the old call returns early and regenerated bytecode is
+  // the plain bytecode.
+  capture.Arm(3, {});
+  CompileRun("rebFlush([1])");
+  CHECK_EQ(4u, capture.embedder().observations.size());
+  flush_bytecode();
+  CompileRun("rebFlush([1])");
+  const RebBytecode regenerated = RebBytecodeOf("rebFlush");
+  CHECK_EQ(0, regenerated.traces);
+  {
+    LocalContext plain;
+    CompileRun(source.c_str());
+    CHECK(RebBytecodeOf("rebFlush").SameAs(regenerated));
+  }
+  CHECK_EQ(4u, capture.embedder().observations.size());
+}
