+  using Kind = v8::JsDispatchSelectorKind;
+  const struct {
+    Kind kind;
+    uint32_t low32;
+  } expected[] = {
+      {Kind::kInteger, 1u},          {Kind::kNumber, 0u},  {Kind::kString, 0u},
+      {Kind::kInteger, 0xffffffffu}, {Kind::kBoolean, 1u}, {Kind::kNull, 0u},
+      {Kind::kUndefined, 0u},        {Kind::kInteger, 1u}, {Kind::kSymbol, 0u},
