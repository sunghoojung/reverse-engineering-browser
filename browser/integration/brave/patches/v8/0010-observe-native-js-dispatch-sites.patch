+// REB native JavaScript dispatch capture. A fake embedder records what V8
+// reports. Site keys hash the ASCII test sources as UTF-16LE, like the
+// analyzer does for a captured artifact.
+struct RebJsDispatchRecord {
+  v8::JsDispatchObservation observation;
+  uint8_t source_sha256[32];
+  uint64_t epoch;
+};
+
+struct RebJsDispatchEmbedder {
+  uint64_t epoch = 0;
+  std::vector<v8::JsDispatchSite> sites;
+  bool enabled = true;
+  std::vector<RebJsDispatchRecord> observations;
+  std::vector<std::pair<uint32_t, int>> statuses;
+};
+
+RebJsDispatchEmbedder* reb_js_dispatch_embedder = nullptr;
+
+uint64_t RebJsDispatchEpoch() {
+  return reb_js_dispatch_embedder ? reb_js_dispatch_embedder->epoch : 0;
+}
+
+size_t RebJsDispatchSites(uint64_t epoch, v8::JsDispatchSite* sites,
+                          size_t capacity) {
+  RebJsDispatchEmbedder* embedder = reb_js_dispatch_embedder;
+  if (embedder == nullptr || epoch != embedder->epoch) return 0;
+  const size_t copied = std::min(capacity, embedder->sites.size());
+  std::copy_n(embedder->sites.begin(), copied, sites);
+  // Reports every configured site, so V8 must cap the count itself.
+  return embedder->sites.size();
+}
+
+bool RebJsDispatchEnabled(uint64_t epoch, uint32_t slot) {
+  RebJsDispatchEmbedder* embedder = reb_js_dispatch_embedder;
+  CHECK_LT(slot, v8::kJsDispatchSiteLimit);
+  return embedder != nullptr && embedder->enabled && epoch == embedder->epoch;
+}
+
+void RebJsDispatchObserve(v8::Local<v8::Context> context, uint64_t epoch,
+                          const v8::JsDispatchObservation& observation) {
+  CHECK(!context.IsEmpty());
+  CHECK_NOT_NULL(reb_js_dispatch_embedder);
+  RebJsDispatchRecord record{observation, {}, epoch};
+  std::memcpy(record.source_sha256, observation.source_sha256,
+              sizeof(record.source_sha256));
+  record.observation.source_sha256 = nullptr;
+  reb_js_dispatch_embedder->observations.push_back(record);
+}
+
+void RebJsDispatchStatus(uint64_t epoch, uint32_t slot,
+                         v8::JsDispatchSiteStatus status, int script_id) {
+  CHECK_NOT_NULL(reb_js_dispatch_embedder);
+  CHECK(status == v8::JsDispatchSiteStatus::kCompiledBeforeArming);
+  CHECK_EQ(epoch, reb_js_dispatch_embedder->epoch);
+  reb_js_dispatch_embedder->statuses.emplace_back(slot, script_id);
+}
+
+v8::JsDispatchSite RebJsSite(const std::string& source, size_t anchor,
+                             v8::JsDispatchShape shape) {
+  CHECK_LT(anchor, source.size());
+  std::vector<uint8_t> units;
+  for (char c : source) {
+    units.push_back(static_cast<uint8_t>(c));
+    units.push_back(0);
+  }
+  v8::JsDispatchSite site{};
+  i::SHA256_hash(units.data(), units.size(), site.source_sha256);
+  site.source_length = static_cast<uint32_t>(source.size());
+  site.anchor_offset = static_cast<uint32_t>(anchor);
+  site.shape = shape;
+  return site;
+}
+
+size_t RebAnchor(const std::string& source, const std::string& text,
+                 size_t offset_in_text = 0) {
+  const size_t found = source.find(text);
+  CHECK_NE(found, std::string::npos);
+  return found + offset_in_text;
+}
+
+// Turns capture mode on with the implications V8 applies at startup, and
+// installs the fake embedder. Configuration changes are pulled by V8 at the
+// next compile or trace, as from a real embedder.
+class RebJsDispatchScope final {
+ public:
+  explicit RebJsDispatchScope(v8::Isolate* isolate, bool capture = true)
+      : isolate_(isolate),
+        capture_(&i::v8_flags.reb_js_dispatch_capture, capture),
+        compilation_cache_(&i::v8_flags.compilation_cache, !capture),
+        lazy_positions_(&i::v8_flags.enable_lazy_source_positions,
+                        i::v8_flags.enable_lazy_source_positions && !capture) {
+    reb_js_dispatch_embedder = &embedder_;
+    v8::JsDispatchCallbacks callbacks;
+    callbacks.epoch = &RebJsDispatchEpoch;
+    callbacks.sites = &RebJsDispatchSites;
+    callbacks.enabled = &RebJsDispatchEnabled;
+    callbacks.observe = &RebJsDispatchObserve;
+    callbacks.status = &RebJsDispatchStatus;
+    isolate_->SetJsDispatchCallbacks(callbacks);
+  }
+  ~RebJsDispatchScope() {
+    isolate_->SetJsDispatchCallbacks({});
+    reb_js_dispatch_embedder = nullptr;
+  }
+  RebJsDispatchScope(const RebJsDispatchScope&) = delete;
+  RebJsDispatchScope& operator=(const RebJsDispatchScope&) = delete;
+
+  void Arm(uint64_t epoch, std::vector<v8::JsDispatchSite> sites) {
+    embedder_.epoch = epoch;
+    embedder_.sites = std::move(sites);
+  }
+  RebJsDispatchEmbedder& embedder() { return embedder_; }
+
+ private:
+  v8::Isolate* const isolate_;
+  i::FlagScope<bool> capture_;
+  i::FlagScope<bool> compilation_cache_;
+  i::FlagScope<bool> lazy_positions_;
+  RebJsDispatchEmbedder embedder_;
+};
+
+i::Handle<i::JSFunction> RebFunction(const char* name) {
+  return i::Cast<i::JSFunction>(v8::Utils::OpenHandle(*CompileRun(name)));
+}
+
+int RebScriptId(i::DirectHandle<i::JSFunction> function) {
+  return i::Cast<i::Script>(function->shared()->script())->id();
+}
+
+struct RebBytecode {
+  std::vector<uint8_t> bytes;
+  int register_count = 0;
+  int parameter_count = 0;
+  int constant_count = 0;
+  int handler_table_length = 0;
+  int traces = 0;
+
+  bool SameAs(const RebBytecode& other) const {
+    return bytes == other.bytes && register_count == other.register_count &&
+           parameter_count == other.parameter_count &&
+           constant_count == other.constant_count &&
+           handler_table_length == other.handler_table_length;
+  }
+};
+
+RebBytecode RebBytecodeOf(const char* name) {
+  // A local scope, so no handle keeps the bytecode alive across a later GC.
+  v8::HandleScope scope(CcTest::isolate());
+  i::Isolate* i_isolate = CcTest::i_isolate();
+  i::DirectHandle<i::JSFunction> function = RebFunction(name);
+  CHECK(function->shared()->HasBytecodeArray());
+  i::Handle<i::BytecodeArray> bytecode(
+      function->shared()->GetBytecodeArray(i_isolate), i_isolate);
+  RebBytecode result;
+  for (int offset = 0; offset < bytecode->length(); ++offset) {
+    result.bytes.push_back(bytecode->get(offset));
+  }
+  result.register_count = bytecode->register_count();
+  result.parameter_count = bytecode->parameter_count();
+  result.constant_count =
+      static_cast<int>(bytecode->constant_pool()->ulength().value());
+  result.handler_table_length =
+      static_cast<int>(bytecode->handler_table()->ulength().value());
+  for (i::interpreter::BytecodeArrayIterator it(bytecode); !it.done();
+       it.Advance()) {
+    if (it.current_bytecode() == i::interpreter::Bytecode::kCallRuntime &&
+        it.GetRuntimeIdOperand(0) == i::Runtime::kRebTraceJsDispatch) {
+      ++result.traces;
+    }
+  }
+  return result;
+}
+
+void CheckRebDispatch(const RebJsDispatchRecord& record, uint32_t slot,
+                      const v8::JsDispatchSite& site, int script_id) {
+  const v8::JsDispatchObservation& observation = record.observation;
+  CHECK_EQ(slot, observation.slot);
+  CHECK_EQ(script_id, observation.script_id);
+  CHECK_EQ(site.source_length, observation.source_length);
+  CHECK_EQ(site.anchor_offset, observation.anchor_offset);
+  CHECK(site.shape == observation.shape);
+  CHECK_EQ(0, std::memcmp(record.source_sha256, site.source_sha256,
+                          sizeof(site.source_sha256)));
+  CHECK_NE(0u, observation.activation_id);
+}
+
+const char kRebSwitchSource[] =
+    "function rebSwitch(code) { var acc = 0; for (var pc = 0; "
+    "pc < code.length; pc++) { switch (code[pc]) { case 1: acc += 1; break; "
+    "case 2: acc += 2; break; default: acc -= 1; } } return acc; }"
+    "rebSwitch([1, 2]);";
+
+}  // namespace
+
+TEST(RebNativeJsDispatchDisabledAndUnarmedBytecodeIdentity) {
+  LocalContext env;
+  v8::Isolate* isolate = env.isolate();
+  v8::HandleScope scope(isolate);
+  const std::string source = kRebSwitchSource;
+  const v8::JsDispatchSite site = RebJsSite(source, RebAnchor(source, "switch"),
+                                            v8::JsDispatchShape::kSwitch);
+  RebBytecode disabled;
+  {
+    // The flag is off: installed and armed callbacks change nothing.
+    RebJsDispatchScope capture(isolate, false);
+    capture.Arm(1, {site});
+    LocalContext context;
+    CompileRun(kRebSwitchSource);
+    disabled = RebBytecodeOf("rebSwitch");
+    CHECK_EQ(0, disabled.traces);
+    CHECK(capture.embedder().observations.empty());
+    CHECK(capture.embedder().statuses.empty());
+  }
+  {
+    RebJsDispatchScope capture(isolate);
+    {
+      // Capture mode with an inactive epoch.
+      LocalContext context;
+      CompileRun(kRebSwitchSource);
+      CHECK(RebBytecodeOf("rebSwitch").SameAs(disabled));
+    }
+    {
+      // Armed for another script of the same length: the key mismatches.
+      v8::JsDispatchSite other = site;
+      other.source_sha256[0] ^= 1;
+      capture.Arm(2, {other});
+      LocalContext context;
+      CompileRun(kRebSwitchSource);
+      CHECK(RebBytecodeOf("rebSwitch").SameAs(disabled));
+    }
+    CHECK(capture.embedder().observations.empty());
+    {
+      capture.Arm(3, {site});
+      LocalContext context;
+      CompileRun(kRebSwitchSource);
+      const RebBytecode armed = RebBytecodeOf("rebSwitch");
+      CHECK_EQ(1, armed.traces);
+      CHECK(!armed.SameAs(disabled));
+      const int script_id = RebScriptId(RebFunction("rebSwitch"));
+      const auto& records = capture.embedder().observations;
+      CHECK_EQ(2u, records.size());
+      for (const RebJsDispatchRecord& record : records) {
+        CheckRebDispatch(record, 0, site, script_id);
+        CHECK_EQ(3u, record.epoch);
+        CHECK(record.observation.selector_kind ==
+              v8::JsDispatchSelectorKind::kInteger);
+        CHECK_EQ(0, record.observation.handler_script_id);
+        CHECK_EQ(0u, record.observation.handler_start);
+        CHECK_EQ(0u, record.observation.handler_end);
+        CHECK_EQ(0u, record.observation.parent_activation_id);
+        CHECK(!record.observation.parent_unknown);
+        CHECK(!record.observation.parent_search_truncated);
+      }
+      CHECK_EQ(1u, records[0].observation.selector_low32);
+      CHECK_EQ(2u, records[1].observation.selector_low32);
+      CHECK(records[0].observation.new_activation);
+      CHECK(!records[1].observation.new_activation);
+      CHECK_EQ(records[0].observation.activation_id,
+               records[1].observation.activation_id);
+      // Copies compiled earlier in this isolate are reported, never this one.
+      for (const auto& status : capture.embedder().statuses) {
+        CHECK_EQ(0u, status.first);
+        CHECK_NE(script_id, status.second);
+      }
+    }
+  }
+}
