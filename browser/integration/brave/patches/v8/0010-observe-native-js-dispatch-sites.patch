+void BytecodeGenerator::BuildRebIndexedCallee(Property* property,
+                                              Property* keyed, Register key,
+                                              RegisterList* args,
+                                              Register callee,
+                                              Register* handler) {
+  // Mirrors VisitAndPushIntoRegisterList and VisitPropertyLoadForRegister,
+  // keeping the property key in |key| for the trace.
+  if (keyed == property) {
+    // t[k](...): the receiver is t and the handler is the callee.
+    VisitAndPushIntoRegisterList(property->obj(), args);
+    {
+      ValueResultScope result_scope(this);
+      VisitForAccumulatorValueAsPropertyKey(property->key());
+      builder()->StoreAccumulatorInRegister(key);
+      builder()->SetExpressionPosition(property);
+      BuildLoadKeyedProperty(args->last_register(),
+                             feedback_spec()->AddKeyedLoadICSlot());
+    }
+    builder()->StoreAccumulatorInRegister(callee);
+    *handler = callee;
+    return;
+  }
+  // t[k].call(...) or t[k].apply(...): the receiver is the handler t[k].
+  DCHECK_EQ(keyed, property->obj());
+  {
+    ValueResultScope result_scope(this);
+    Register object = VisitForRegisterValue(keyed->obj());
+    VisitForAccumulatorValueAsPropertyKey(keyed->key());
+    builder()->StoreAccumulatorInRegister(key);
+    builder()->SetExpressionPosition(keyed);
+    BuildLoadKeyedProperty(object, feedback_spec()->AddKeyedLoadICSlot());
+  }
+  Register receiver = register_allocator()->GrowRegisterList(args);
+  builder()->StoreAccumulatorInRegister(receiver);
+  *handler = receiver;
+  VisitPropertyLoadForRegister(args->last_register(), property, callee);
+}
+
+void BytecodeGenerator::BuildRebJsDispatchTrace(RegisterList trace,
+                                                Register handler,
+                                                JsDispatchShape shape,
+                                                int position) {
+  // trace: activation, selector (already stored), handler, closure, anchor.
+  DCHECK_EQ(5, trace.register_count());
+  builder()->MoveRegister(reb_activation_, trace[0]);
+  if (handler.is_valid()) {
+    builder()->MoveRegister(handler, trace[2]);
+  } else {
+    builder()->LoadUndefined().StoreAccumulatorInRegister(trace[2]);
+  }
+  builder()
+      ->MoveRegister(Register::function_closure(), trace[3])
+      .LoadLiteral(Smi::FromInt(RebJsDispatch::EncodeAnchor(shape, position)))
+      .StoreAccumulatorInRegister(trace[4])
+      .CallRuntime(Runtime::kRebTraceJsDispatch, trace)
+      .StoreAccumulatorInRegister(reb_activation_);
+  reb_emitted_.Add(shape, position);
+}
