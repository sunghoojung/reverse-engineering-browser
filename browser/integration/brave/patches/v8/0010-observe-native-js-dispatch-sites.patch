+void BytecodeGenerator::FindRebArmedSites(uintptr_t stack_limit) {
+  if (V8_LIKELY(!v8_flags.reb_js_dispatch_capture)) return;
+  // The arming table belongs to the main thread, and the flag keeps all
+  // JavaScript bytecode generation there.
+  if (!local_isolate_->is_main_thread() || script_.is_null()) return;
+  Isolate* isolate = local_isolate_->AsIsolate();
+  FunctionLiteral* literal = info()->literal();
+  const int start = literal->is_toplevel() ? 0 : literal->start_position();
+  const int end = literal->is_toplevel() ? kMaxInt : literal->end_position();
+  isolate->reb_js_dispatch().AnchorsIn(isolate, *script_, start, end,
+                                       &reb_armed_);
+  if (reb_armed_.count == 0) return;
+  RebArmedSiteFinder finder(stack_limit, literal, reb_armed_);
+  finder.Run();
+  if (finder.HasStackOverflow()) {
+    // The generator itself overflows on this function and reports it.
+    finder.ClearStackOverflow();
+    reb_armed_ = {};
+    return;
+  }
+  if (!finder.found()) reb_armed_ = {};
+}
