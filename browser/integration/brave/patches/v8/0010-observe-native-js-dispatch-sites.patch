+TEST(RebNativeJsDispatchRefusesCodeCache) {
+  LocalContext env;
+  v8::Isolate* isolate = env.isolate();
+  v8::HandleScope scope(isolate);
+  const std::string source =
+      "function rebCached(code) { var r = 0; for (var i = 0; i < code.length; "
+      "i++) { switch (code[i]) { case 0: r++; break; default: r--; } } "
+      "return r; }"
+      "rebCached([0]);";
+  v8::ScriptCompiler::CachedData* cache = nullptr;
+  {
+    // Produced without capture mode, like a cache written by an earlier
+    // ordinary session.
+    LocalContext context;
+    v8::ScriptOrigin origin(v8_str("reb-js-dispatch-cache.js"));
+    v8::ScriptCompiler::Source script_source(v8_str(source.c_str()), origin);
+    v8::Local<v8::Script> script =
+        v8::ScriptCompiler::Compile(context.local(), &script_source,
+                                    v8::ScriptCompiler::kEagerCompile)
+            .ToLocalChecked();
+    cache = v8::ScriptCompiler::CreateCodeCache(script->GetUnboundScript());
+    CHECK_NOT_NULL(cache);
+  }
+  RebJsDispatchScope capture(isolate);
+  capture.Arm(1, {RebJsSite(source, RebAnchor(source, "switch"),
+                            v8::JsDispatchShape::kSwitch)});
+  LocalContext context;
+  v8::ScriptOrigin origin(v8_str("reb-js-dispatch-cache.js"));
+  // The source takes ownership of the cache.
+  v8::ScriptCompiler::Source script_source(v8_str(source.c_str()), origin,
+                                           cache);
+  v8::Local<v8::Script> script =
+      v8::ScriptCompiler::Compile(context.local(), &script_source,
+                                  v8::ScriptCompiler::kConsumeCodeCache)
+          .ToLocalChecked();
+  CHECK(script_source.GetCachedData()->rejected);
+  script->Run(context.local()).ToLocalChecked();
+  CHECK_EQ(1u, capture.embedder().observations.size());
+  CHECK_EQ(1, RebBytecodeOf("rebCached").traces);
+  // Capture mode writes no cache, armed or not.
+  CHECK_NULL(v8::ScriptCompiler::CreateCodeCache(script->GetUnboundScript()));
+}
