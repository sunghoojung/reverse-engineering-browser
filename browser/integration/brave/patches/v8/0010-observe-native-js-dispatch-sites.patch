+    CHECK_EQ(0u, records[i].observation.slot);
+    CHECK_EQ(eval_site.anchor_offset, records[i].observation.anchor_offset);
+    CHECK_EQ(static_cast<uint32_t>(i), records[i].observation.selector_low32);
+  }
+  const int function_script = RebScriptId(RebFunction("rebFn"));
+  for (size_t i = 2; i < 4; ++i) {
+    CheckRebDispatch(records[i], 1, function_site, function_script);
+    CHECK_EQ(static_cast<uint32_t>(i - 2),
+             records[i].observation.selector_low32);
+  }
+  CHECK_NE(records[0].observation.script_id, function_script);
+}
