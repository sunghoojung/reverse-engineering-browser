+TEST(RebNativeJsDispatchAdmissionAndSiteCap) {
+  LocalContext env;
+  v8::Isolate* isolate = env.isolate();
+  v8::HandleScope scope(isolate);
+  RebJsDispatchScope capture(isolate);
+  const std::string kept =
+      "function rebKept(code) { var r = 0; for (var i = 0; i < code.length; "
+      "i++) { switch (code[i]) { case 0: r++; break; default: r--; } } "
+      "return r; }";
+  const std::string capped =
+      "function rebCapped(code) { var r = 0; for (var i = 0; i < code.length; "
+      "i++) { switch (code[i]) { case 0: r++; break; default: r--; } } "
+      "return r; }";
+  std::vector<v8::JsDispatchSite> sites;
+  for (size_t i = 0; i + 1 < v8::kJsDispatchSiteLimit; ++i) {
+    v8::JsDispatchSite unused{};
+    unused.source_length = 1;
+    unused.shape = v8::JsDispatchShape::kSwitch;
+    sites.push_back(unused);
+  }
+  sites.push_back(
+      RebJsSite(kept, RebAnchor(kept, "switch"), v8::JsDispatchShape::kSwitch));
+  // A ninth site is beyond the limit and never armed.
+  sites.push_back(RebJsSite(capped, RebAnchor(capped, "switch"),
+                            v8::JsDispatchShape::kSwitch));
+  capture.Arm(1, sites);
+  // Admission refused: armed bytecode, but nothing is observed.
+  capture.embedder().enabled = false;
+  CompileRun(kept.c_str());
+  CompileRun(capped.c_str());
+  CHECK_EQ(0,
+           CompileRun("rebKept([0, 1])")->Int32Value(env.local()).FromJust());
+  CHECK_EQ(1, RebBytecodeOf("rebKept").traces);
+  CHECK(capture.embedder().observations.empty());
+  capture.embedder().enabled = true;
+  CHECK_EQ(1, CompileRun("rebKept([0])")->Int32Value(env.local()).FromJust());
+  CHECK_EQ(1, CompileRun("rebCapped([0])")->Int32Value(env.local()).FromJust());
+  CHECK_EQ(0, RebBytecodeOf("rebCapped").traces);
+  const auto& records = capture.embedder().observations;
+  CHECK_EQ(1u, records.size());
+  CHECK_EQ(static_cast<uint32_t>(v8::kJsDispatchSiteLimit - 1),
+           records[0].observation.slot);
+  CHECK(records[0].observation.new_activation);
+}
