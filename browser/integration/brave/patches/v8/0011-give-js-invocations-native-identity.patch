+
+// SHA-256 over the script source as UTF-16LE code units, the key the analyzer
+// computes from the captured artifact text, exactly as for dispatch sites.
+bool RebSourceDigest(Tagged<String> source, uint8_t digest[32]) {
+  DisallowGarbageCollection no_gc;
+  String::FlatContent flat = source->GetFlatContent(no_gc);
+  if (!flat.IsFlat()) return false;
+  LITE_SHA256_CTX context;
+  SHA256_init(&context);
+  uint8_t chunk[512];
+  size_t used = 0;
+  auto append = [&](uint16_t unit) {
+    chunk[used++] = static_cast<uint8_t>(unit & 0xff);
+    chunk[used++] = static_cast<uint8_t>(unit >> 8);
+    if (used == sizeof(chunk)) {
+      SHA256_update(&context, chunk, used);
+      used = 0;
+    }
+  };
+  if (flat.IsOneByte()) {
+    for (uint8_t unit : flat.ToOneByteVector()) append(unit);
+  } else {
+    for (base::uc16 unit : flat.ToUC16Vector()) append(unit);
+  }
+  if (used != 0) SHA256_update(&context, chunk, used);
+  std::memcpy(digest, SHA256_final(&context), kSizeOfSha256Digest);
+  return true;
+}
+
+// Kind and low bits only. No string, symbol, BigInt or object content.
+v8::JsInvocationValueKind RebClassify(Tagged<Object> value, uint32_t* low32) {
+  *low32 = 0;
+  if (IsSmi(value)) {
+    *low32 = static_cast<uint32_t>(Smi::ToInt(Cast<Smi>(value)));
+    return v8::JsInvocationValueKind::kInteger;
+  }
+  if (IsHeapNumber(value)) {
+    const double number = Cast<HeapNumber>(value)->value();
+    // [-2^63, 2^63) converts to int64 without overflow.
+    if (std::isfinite(number) && std::trunc(number) == number &&
+        number >= -9223372036854775808.0 && number < 9223372036854775808.0) {
+      *low32 = static_cast<uint32_t>(
+          static_cast<uint64_t>(static_cast<int64_t>(number)));
+      return v8::JsInvocationValueKind::kInteger;
+    }
+    return v8::JsInvocationValueKind::kNumber;
+  }
+  if (IsString(value)) return v8::JsInvocationValueKind::kString;
+  if (IsSymbol(value)) return v8::JsInvocationValueKind::kSymbol;
+  if (IsUndefined(value)) return v8::JsInvocationValueKind::kUndefined;
+  if (IsNull(value)) return v8::JsInvocationValueKind::kNull;
+  if (IsTrue(value) || IsFalse(value)) {
+    *low32 = IsTrue(value) ? 1 : 0;
+    return v8::JsInvocationValueKind::kBoolean;
+  }
+  if (IsBigInt(value)) return v8::JsInvocationValueKind::kBigInt;
+  if (IsJSPromise(value)) return v8::JsInvocationValueKind::kPromise;
+  if (IsJSArray(value)) return v8::JsInvocationValueKind::kArray;
+  if (IsJSArrayBuffer(value)) return v8::JsInvocationValueKind::kArrayBuffer;
+  if (IsJSArrayBufferView(value)) {
+    return v8::JsInvocationValueKind::kArrayBufferView;
+  }
+  if (IsCallable(value)) return v8::JsInvocationValueKind::kFunction;
+  return v8::JsInvocationValueKind::kObject;
+}
+
+// Generators are resumed on behalf of whoever calls next(); constructors and
+// synthesized initializers are not page calls with a caller to return to.
+bool RebSupportedKind(FunctionKind kind) {
+  return !IsGeneratorFunction(kind) && !IsModule(kind) &&
+         !IsClassConstructor(kind) && !IsClassInitializerFunction(kind);
+}
+
+// Streams bytes into SHA-256 and the rolling hash together.
+class RebValueDigest final {
+ public:
+  RebValueDigest() { SHA256_init(&context_); }
+
+  void Add(uint8_t byte) {
+    buffer_[used_++] = byte;
+    rolling_ = rolling_ * kRebRollingBase + byte;
+    ++length_;
+    if (used_ == sizeof(buffer_)) Flush();
+  }
+  void Add(const uint8_t* bytes, size_t length) {
+    for (size_t i = 0; i < length; ++i) Add(bytes[i]);
+  }
+  size_t length() const { return length_; }
+  void Finish(v8::JsInvocationSettle* settle) {
+    Flush();
+    std::memcpy(settle->value_sha256, SHA256_final(&context_),
+                kSizeOfSha256Digest);
+    settle->rolling_hash = rolling_;
+    settle->digest_byte_length = static_cast<uint32_t>(length_);
+  }
+
+ private:
+  void Flush() {
+    if (used_ != 0) SHA256_update(&context_, buffer_, used_);
+    used_ = 0;
+  }
+
+  LITE_SHA256_CTX context_;
+  uint8_t buffer_[512];
+  size_t used_ = 0;
+  size_t length_ = 0;
+  uint64_t rolling_ = 0;
+};
