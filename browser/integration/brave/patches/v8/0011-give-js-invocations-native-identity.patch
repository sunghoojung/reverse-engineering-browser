+TEST(RebNativeJsInvocationPreservesEmbedderData) {
+  LocalContext env;
+  v8::Isolate* isolate = env.isolate();
+  v8::HandleScope scope(isolate);
+  RebJsInvocationScope capture(env);
+  const std::string source =
+      "function rebData(x) { var inside = readData(); writeData('fork');"
+      "var forked = readData(); observe(1); writeData(inside);"
+      "Promise.resolve().then(() => { rebLater = readData(); observe(2); });"
+      "return inside + '/' + forked; } var rebLater;";
+  capture.Arm(2, {RebInvocationSite(source, RebAnchor(source, "rebData(", 7))});
+  CompileRun(source.c_str());
+  isolate->SetContinuationPreservedEmbedderDataV2(v8_str("outer"));
+  CHECK(CompileRun("rebData(0)")
+            ->Equals(env.local(), v8_str("outer/fork"))
+            .FromJust());
+  // The caller continues with exactly its own value.
+  CHECK(isolate->GetContinuationPreservedEmbedderDataV2()
+            .As<v8::Value>()
+            ->Equals(env.local(), v8_str("outer"))
+            .FromJust());
+  isolate->PerformMicrotaskCheckpoint();
+  CHECK(CompileRun("rebLater")->Equals(env.local(), v8_str("outer")).FromJust());
+  const auto& observed = capture.embedder().observed;
+  CHECK_EQ(2u, observed.size());
+  // An embedder write inside running script keeps the invocation.
+  CHECK(observed[0].second.state == v8::JsInvocationContextState::kInside);
+  CHECK(observed[1].second.state == v8::JsInvocationContextState::kInside);
+  CHECK_EQ(observed[0].second.invocation_id, observed[1].second.invocation_id);
+  // A top-level write, with no JavaScript on the stack, carries none.
+  isolate->SetContinuationPreservedEmbedderDataV2(v8_str("next task"));
+  CHECK(isolate->GetCurrentJsInvocation().state ==
+        v8::JsInvocationContextState::kNone);
+  isolate->SetContinuationPreservedEmbedderDataV2(v8::Undefined(isolate));
+}
