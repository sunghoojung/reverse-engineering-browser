+TEST(RebNativeJsInvocationAdmissionAndUnsupportedKinds) {
+  LocalContext env;
+  v8::Isolate* isolate = env.isolate();
+  v8::HandleScope scope(isolate);
+  RebJsInvocationScope capture(env);
+  const std::string source =
+      "function rebAdmitted(a) { observe(1); return a; }"
+      "function* rebGenerator(a) { yield a; }"
+      "function rebEarly(a) { return a; } rebEarly(1);";
+  // rebEarly already has bytecode when arming begins.
+  CompileRun(source.c_str());
+  capture.Arm(6, {RebInvocationSite(source, RebAnchor(source, "rebAdmitted(", 11)),
+                  RebInvocationSite(source, RebAnchor(source, "rebGenerator(", 12)),
+                  RebInvocationSite(source, RebAnchor(source, "rebEarly(", 8))});
+  CompileRun(source.c_str());
+  CompileRun("rebGenerator(1).next(); rebEarly(2);");
+  bool unsupported = false;
+  bool compiled_before = false;
+  for (const auto& [slot, status] : capture.embedder().statuses) {
+    unsupported |= slot == 1 &&
+                   status == v8::JsInvocationSiteStatus::kUnsupportedFunction;
+    compiled_before |=
+        slot == 2 && status == v8::JsInvocationSiteStatus::kCompiledBeforeArming;
+  }
+  CHECK(unsupported);
+  CHECK(compiled_before);
+  CHECK_EQ(0, RebInvocationCalls("rebGenerator"));
+  // Admission refused: no ID is allocated and no invocation becomes current.
+  capture.embedder().enabled = false;
+  CompileRun("rebAdmitted(1)");
+  CHECK(capture.embedder().starts.empty());
+  CHECK(capture.embedder().observed.back().second.state ==
+        v8::JsInvocationContextState::kNone);
+  capture.embedder().enabled = true;
+  CompileRun("rebAdmitted(2)");
+  CHECK_EQ(1u, capture.embedder().starts.size());
+  CHECK_EQ(0u, capture.embedder().starts[0].slot);
+}
