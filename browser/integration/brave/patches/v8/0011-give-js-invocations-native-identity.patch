+// The site slot (at most 8) travels with the ID in one Smi-sized value.
+constexpr uint32_t kRebIdLimit = static_cast<uint32_t>(Smi::kMaxValue) >> 3;
+constexpr uint64_t kRebRollingBase = 0x100000001b3ULL;
