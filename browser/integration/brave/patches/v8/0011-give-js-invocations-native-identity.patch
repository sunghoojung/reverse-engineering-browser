+namespace v8::internal {
+class JSPromise;
+class NativeContext;
+}  // namespace v8::internal
+
+namespace v8::internal::interpreter {
+
+// How control leaves an armed function's frame. The bytecode generator passes
+// the kind as a Smi operand to Runtime_RebJsInvocationExit.
+enum RebJsInvocationExitKind : int {
+  kRebJsInvocationReturn = 1,
+  kRebJsInvocationThrow = 2,
+  kRebJsInvocationSuspend = 3,
+};
+
+// REB native JavaScript invocation identity (--reb-js-invocation-capture).
+// Holds the per-isolate copy of the embedder's armed function-entry sites and
+// the invocation counter. Used only on the isolate's main thread: the flag
+// implies --reb-js-dispatch-capture, which keeps every bytecode generation
+// there. Tables are fixed-size, so the inactive and hot paths never allocate.
+//
+// The current invocation lives in the continuation-preserved embedder data
+// slot as an internal Tuple2{embedder value, Smi invocation ID}. Promise
+// reactions and microtasks already capture and restore that slot, so a
+// continuation created during a call resumes inside it; the embedder API
+// unwraps the slot, so the embedder always sees its own value.
+class RebJsInvocation final {
+ public:
+  static constexpr size_t kBindingLimit = 64;
+  static constexpr size_t kArmedFunctionLimit = 32;
+  // Frame record slots: saved embedder data slot, signed invocation ID
+  // (negative once the synchronous extent ended), site slot, native context.
+  static constexpr int kRecordSaved = 0;
+  static constexpr int kRecordId = 1;
+  static constexpr int kRecordSlot = 2;
+  static constexpr int kRecordContext = 3;
+  static constexpr int kRecordLength = 4;
+
+  void SetCallbacks(Isolate* isolate,
+                    const v8::JsInvocationCallbacks& callbacks);
+
+  // Pulls the embedder epoch. When it changed, refreshes the armed sites,
+  // starts a new ID range and reports sites whose function already had
+  // bytecode. Returns whether any site is armed.
+  bool Sync(Isolate* isolate);
+
+  // Whether the function literal starting at |start_position| in |script| is
+  // armed. An unsupported kind is reported once per configuration and slot
+  // and never armed.
+  bool ArmedSlot(Isolate* isolate, Tagged<Script> script, int start_position,
+                 FunctionKind kind, uint32_t* slot);
+
+  // Records bytecode generated with an entry call. A fact about bytecode, so
+  // an epoch change keeps it.
+  void RecordArmedFunction(int script_id, int start_position);
+
+  // Runtime_RebJsInvocationEnter: returns the frame record, or undefined
+  // when the call was not admitted.
+  Tagged<Object> Enter(Isolate* isolate, DirectHandle<JSFunction> closure);
+  // Runtime_RebJsInvocationExit: restores the caller's context at the end of
+  // the initial synchronous extent and observes what the caller receives.
+  // Returns |value| unchanged.
+  Tagged<Object> Exit(Isolate* isolate, DirectHandle<Object> record,
+                      DirectHandle<Object> value, int kind);
+  // A watched promise settled; called from the internal reaction's handler.
+  void PromiseSettled(Isolate* isolate, uint32_t encoded, bool fulfilled,
+                      DirectHandle<Object> value);
+
+  // The invocation the running code belongs to. Never allocates or calls
+  // into JavaScript.
+  v8::JsInvocationContext Current(Isolate* isolate);
+
+  // The embedder's view of the embedder data slot: the value inside a REB
+  // wrapper, otherwise the slot itself.
+  static Tagged<Object> EmbedderData(Tagged<Object> slot);
+  // An embedder write. While a wrapper is current and JavaScript is on the
+  // stack, the new value stays inside the same invocation; a top-level write
+  // replaces the wrapper.
+  void SetEmbedderData(Isolate* isolate, DirectHandle<Object> data);
+
+ private:
+  struct Site {
+    uint8_t source_sha256[32];
+    uint32_t source_length;
+    uint32_t anchor_offset;
+    bool usable;
+  };
+  struct Binding {
+    int script_id;
+    uint32_t mask;
+  };
+  struct ArmedFunction {
+    int script_id;
+    int start_position;
+  };
+
+  bool Complete() const;
+  void Reset(uint64_t epoch);
+  uint32_t BindingMask(Tagged<Script> script);
+  bool SlotFor(Tagged<Script> script, int start_position, uint32_t* slot);
+  bool IsArmedFunction(int script_id, int start_position) const;
+  void ReportCompiledBeforeArming(Isolate* isolate);
+  void ReportStatus(uint32_t slot, v8::JsInvocationSiteStatus status,
+                    int script_id);
+  bool IsCurrentId(uint32_t id) const;
+  void Settle(Isolate* isolate, DirectHandle<NativeContext> context,
+              uint32_t id, uint32_t slot, bool fulfilled,
+              v8::JsInvocationSettleVia via, DirectHandle<Object> value);
+  void Watch(Isolate* isolate, DirectHandle<JSPromise> promise,
+             DirectHandle<NativeContext> context, uint32_t id, uint32_t slot);
+
+  v8::JsInvocationCallbacks callbacks_;
+  bool synced_ = false;
+  bool any_armed_ = false;
+  bool digests_ = false;
+  uint64_t epoch_ = 0;
+  Site sites_[v8::kJsInvocationSiteLimit] = {};
+  size_t site_count_ = 0;
+  // Statuses already reported this configuration, one bit per slot.
+  uint32_t reported_unsupported_ = 0;
+  uint32_t reported_compiled_ = 0;
+  Binding bindings_[kBindingLimit] = {};
+  size_t binding_count_ = 0;
+  size_t next_binding_ = 0;
+  ArmedFunction armed_functions_[kArmedFunctionLimit] = {};
+  size_t armed_function_count_ = 0;
+  size_t next_armed_function_ = 0;
+  // IDs are never reused. IDs below id_floor_ belong to an earlier epoch and
+  // are reported as unknown, never as a current invocation.
+  uint32_t next_id_ = 1;
+  uint32_t id_floor_ = 1;
+};
+
+}  // namespace v8::internal::interpreter
+
+#endif  // V8_INTERPRETER_REB_JS_INVOCATION_H_
