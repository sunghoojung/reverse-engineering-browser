+namespace {
+int reb_unhandled_rejections = 0;
+void RebCountRejections(v8::PromiseRejectMessage message) {
+  if (message.GetEvent() == v8::kPromiseRejectWithNoHandler) {
+    ++reb_unhandled_rejections;
+  }
+}
+}  // namespace
+
+TEST(RebNativeJsInvocationLeavesUnhandledRejectionVisible) {
+  LocalContext env;
+  v8::Isolate* isolate = env.isolate();
+  v8::HandleScope scope(isolate);
+  RebJsInvocationScope capture(env);
+  const std::string source =
+      "function rebReject() { return Promise.resolve().then(() => { "
+      "throw new Error('no'); }); }";
+  capture.Arm(4, {RebInvocationSite(source, RebAnchor(source, "rebReject(", 9))});
+  CompileRun(source.c_str());
+  reb_unhandled_rejections = 0;
+  isolate->SetPromiseRejectCallback(RebCountRejections);
+  CompileRun("rebReject();");
+  isolate->PerformMicrotaskCheckpoint();
+  // The internal reaction does not mark the promise handled.
+  CHECK_EQ(1, reb_unhandled_rejections);
+  isolate->SetPromiseRejectCallback(nullptr);
+  const auto& settles = capture.embedder().settles;
+  CHECK_EQ(1u, settles.size());
+  CHECK(settles[0].outcome == v8::JsInvocationOutcome::kRejected);
+  CHECK(settles[0].via == v8::JsInvocationSettleVia::kPromise);
+}
