+// UTF-8, with every lone surrogate encoded as U+FFFD, which is what
+// TextEncoder and a string request body send. Returns false when the encoding
+// would exceed the digest limit.
+bool RebDigestString(Isolate* isolate, DirectHandle<String> value,
+                     v8::JsInvocationSettle* settle) {
+  DirectHandle<String> flat = String::Flatten(isolate, value);
+  DisallowGarbageCollection no_gc;
+  String::FlatContent content = flat->GetFlatContent(no_gc);
+  if (!content.IsFlat()) return false;
+  const bool one_byte = content.IsOneByte();
+  const base::Vector<const uint8_t> narrow =
+      one_byte ? content.ToOneByteVector() : base::Vector<const uint8_t>();
+  const base::Vector<const base::uc16> wide =
+      one_byte ? base::Vector<const base::uc16>() : content.ToUC16Vector();
+  const size_t length = one_byte ? narrow.size() : wide.size();
+  auto unit = [&](size_t i) -> uint32_t {
+    return one_byte ? narrow[i] : wide[i];
+  };
+  RebValueDigest digest;
+  bool lossy = false;
+  for (size_t i = 0; i < length; ++i) {
+    uint32_t code = unit(i);
+    if (code >= 0xD800 && code <= 0xDBFF && i + 1 < length &&
+        unit(i + 1) >= 0xDC00 && unit(i + 1) <= 0xDFFF) {
+      code = 0x10000 + ((code - 0xD800) << 10) + (unit(i + 1) - 0xDC00);
+      ++i;
+    } else if (code >= 0xD800 && code <= 0xDFFF) {
+      code = 0xFFFD;
+      lossy = true;
+    }
+    if (code < 0x80) {
+      digest.Add(static_cast<uint8_t>(code));
+    } else if (code < 0x800) {
+      digest.Add(static_cast<uint8_t>(0xC0 | (code >> 6)));
+      digest.Add(static_cast<uint8_t>(0x80 | (code & 0x3F)));
+    } else if (code < 0x10000) {
+      digest.Add(static_cast<uint8_t>(0xE0 | (code >> 12)));
+      digest.Add(static_cast<uint8_t>(0x80 | ((code >> 6) & 0x3F)));
+      digest.Add(static_cast<uint8_t>(0x80 | (code & 0x3F)));
+    } else {
+      digest.Add(static_cast<uint8_t>(0xF0 | (code >> 18)));
+      digest.Add(static_cast<uint8_t>(0x80 | ((code >> 12) & 0x3F)));
+      digest.Add(static_cast<uint8_t>(0x80 | ((code >> 6) & 0x3F)));
+      digest.Add(static_cast<uint8_t>(0x80 | (code & 0x3F)));
+    }
+    if (digest.length() > v8::kJsInvocationDigestByteLimit) return false;
+  }
+  digest.Finish(settle);
+  settle->lossy_utf8 = lossy;
+  return true;
+}
