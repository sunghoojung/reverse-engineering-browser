+namespace {
+
+// REB native JavaScript invocation identity. A fake embedder records what V8
+// reports; sites are keyed like dispatch sites.
+struct RebJsInvocationEmbedder {
+  uint64_t epoch = 0;
+  std::vector<v8::JsInvocationSite> sites;
+  bool enabled = true;
+  bool digests = false;
+  std::vector<v8::JsInvocationStart> starts;
+  std::vector<v8::JsInvocationSettle> settles;
+  std::vector<std::pair<uint32_t, v8::JsInvocationSiteStatus>> statuses;
+  // (tag passed by script, context V8 reported at that point)
+  std::vector<std::pair<int32_t, v8::JsInvocationContext>> observed;
+};
+
+RebJsInvocationEmbedder* reb_js_invocation_embedder = nullptr;
+
+uint64_t RebJsInvocationEpoch() {
+  return reb_js_invocation_embedder ? reb_js_invocation_embedder->epoch : 0;
+}
+
+size_t RebJsInvocationSites(uint64_t epoch, v8::JsInvocationSite* sites,
+                            size_t capacity) {
+  RebJsInvocationEmbedder* embedder = reb_js_invocation_embedder;
+  if (embedder == nullptr || epoch != embedder->epoch) return 0;
+  const size_t copied = std::min(capacity, embedder->sites.size());
+  std::copy_n(embedder->sites.begin(), copied, sites);
+  return copied;
+}
+
+bool RebJsInvocationEnabled(uint64_t epoch, uint32_t slot) {
+  RebJsInvocationEmbedder* embedder = reb_js_invocation_embedder;
+  CHECK_LT(slot, v8::kJsInvocationSiteLimit);
+  return embedder != nullptr && embedder->enabled && epoch == embedder->epoch;
+}
+
+bool RebJsInvocationDigests(uint64_t epoch) {
+  return reb_js_invocation_embedder != nullptr &&
+         reb_js_invocation_embedder->digests;
+}
+
+void RebJsInvocationStarted(v8::Local<v8::Context> context, uint64_t epoch,
+                            const v8::JsInvocationStart& start) {
+  CHECK(!context.IsEmpty());
+  CHECK_NOT_NULL(reb_js_invocation_embedder);
+  CHECK_EQ(epoch, reb_js_invocation_embedder->epoch);
+  CHECK_NOT_NULL(start.source_sha256);
+  v8::JsInvocationStart copy = start;
+  copy.source_sha256 = nullptr;
+  reb_js_invocation_embedder->starts.push_back(copy);
+}
+
+void RebJsInvocationSettled(v8::Local<v8::Context> context, uint64_t epoch,
+                            const v8::JsInvocationSettle& settle) {
+  CHECK(!context.IsEmpty());
+  CHECK_NOT_NULL(reb_js_invocation_embedder);
+  reb_js_invocation_embedder->settles.push_back(settle);
+}
+
+void RebJsInvocationStatus(uint64_t epoch, uint32_t slot,
+                           v8::JsInvocationSiteStatus status, int script_id) {
+  CHECK_NOT_NULL(reb_js_invocation_embedder);
+  reb_js_invocation_embedder->statuses.emplace_back(slot, status);
+}
+
+void RebJsInvocationObserve(const v8::FunctionCallbackInfo<v8::Value>& info) {
+  CHECK_NOT_NULL(reb_js_invocation_embedder);
+  v8::Isolate* isolate = info.GetIsolate();
+  const int32_t tag =
+      info.Length() > 0
+          ? info[0]->Int32Value(isolate->GetCurrentContext()).FromJust()
+          : 0;
+  reb_js_invocation_embedder->observed.emplace_back(
+      tag, isolate->GetCurrentJsInvocation());
+}
+
+void RebJsInvocationReadData(const v8::FunctionCallbackInfo<v8::Value>& info) {
+  info.GetReturnValue().Set(
+      info.GetIsolate()->GetContinuationPreservedEmbedderDataV2().As<v8::Value>());
+}
+
+void RebJsInvocationWriteData(const v8::FunctionCallbackInfo<v8::Value>& info) {
+  info.GetIsolate()->SetContinuationPreservedEmbedderDataV2(info[0]);
+}
+
+v8::JsInvocationSite RebInvocationSite(const std::string& source,
+                                       size_t anchor) {
+  CHECK_LT(anchor, source.size());
+  std::vector<uint8_t> units;
+  for (char c : source) {
+    units.push_back(static_cast<uint8_t>(c));
+    units.push_back(0);
+  }
+  v8::JsInvocationSite site{};
+  i::SHA256_hash(units.data(), units.size(), site.source_sha256);
+  site.source_length = static_cast<uint32_t>(source.size());
+  site.anchor_offset = static_cast<uint32_t>(anchor);
+  return site;
+}
+
+class RebJsInvocationScope final {
+ public:
+  explicit RebJsInvocationScope(LocalContext& env)
+      : isolate_(env.isolate()),
+        invocation_(&i::v8_flags.reb_js_invocation_capture, true),
+        dispatch_(&i::v8_flags.reb_js_dispatch_capture, true),
+        compilation_cache_(&i::v8_flags.compilation_cache, false),
+        lazy_positions_(&i::v8_flags.enable_lazy_source_positions, false),
+        microtasks_(isolate_->GetMicrotasksPolicy()) {
+    // cctest's default policy runs queued jobs before CompileRun returns, which
+    // would settle a promise returned by the call before the test can see it
+    // pending. These tests drain the queue themselves.
+    isolate_->SetMicrotasksPolicy(v8::MicrotasksPolicy::kExplicit);
+    reb_js_invocation_embedder = &embedder_;
+    v8::JsInvocationCallbacks callbacks;
+    callbacks.epoch = &RebJsInvocationEpoch;
+    callbacks.sites = &RebJsInvocationSites;
+    callbacks.enabled = &RebJsInvocationEnabled;
+    callbacks.digests = &RebJsInvocationDigests;
+    callbacks.start = &RebJsInvocationStarted;
+    callbacks.settle = &RebJsInvocationSettled;
+    callbacks.status = &RebJsInvocationStatus;
+    isolate_->SetJsInvocationCallbacks(callbacks);
+    for (auto [name, callback] :
+         {std::pair{"observe", &RebJsInvocationObserve},
+          std::pair{"readData", &RebJsInvocationReadData},
+          std::pair{"writeData", &RebJsInvocationWriteData}}) {
+      env->Global()
+          ->Set(env.local(), v8_str(name),
+                v8::FunctionTemplate::New(isolate_, callback)
+                    ->GetFunction(env.local())
+                    .ToLocalChecked())
+          .FromJust();
+    }
+  }
+  ~RebJsInvocationScope() {
+    isolate_->SetMicrotasksPolicy(microtasks_);
+    isolate_->SetJsInvocationCallbacks({});
+    reb_js_invocation_embedder = nullptr;
+  }
+  RebJsInvocationScope(const RebJsInvocationScope&) = delete;
+  RebJsInvocationScope& operator=(const RebJsInvocationScope&) = delete;
+
+  void Arm(uint64_t epoch, std::vector<v8::JsInvocationSite> sites) {
+    embedder_.epoch = epoch;
+    embedder_.sites = std::move(sites);
+  }
+  RebJsInvocationEmbedder& embedder() { return embedder_; }
+
+ private:
+  v8::Isolate* const isolate_;
+  i::FlagScope<bool> invocation_;
+  i::FlagScope<bool> dispatch_;
+  i::FlagScope<bool> compilation_cache_;
+  i::FlagScope<bool> lazy_positions_;
+  v8::MicrotasksPolicy microtasks_;
+  RebJsInvocationEmbedder embedder_;
+};
+
+// Compiles a lazy function without calling it.
+void RebCompile(const char* name) {
+  v8::HandleScope scope(CcTest::isolate());
+  i::Isolate* i_isolate = CcTest::i_isolate();
+  i::DirectHandle<i::JSFunction> function = RebFunction(name);
+  i::IsCompiledScope is_compiled_scope;
+  CHECK(i::Compiler::Compile(i_isolate, function, i::Compiler::CLEAR_EXCEPTION,
+                             &is_compiled_scope));
+}
+
+int RebInvocationCalls(const char* name) {
+  v8::HandleScope scope(CcTest::isolate());
+  i::Isolate* i_isolate = CcTest::i_isolate();
+  i::DirectHandle<i::JSFunction> function = RebFunction(name);
+  CHECK(function->shared()->HasBytecodeArray());
+  i::Handle<i::BytecodeArray> bytecode(
+      function->shared()->GetBytecodeArray(i_isolate), i_isolate);
+  int calls = 0;
+  for (i::interpreter::BytecodeArrayIterator it(bytecode); !it.done();
+       it.Advance()) {
+    if (it.current_bytecode() == i::interpreter::Bytecode::kCallRuntime &&
+        (it.GetRuntimeIdOperand(0) == i::Runtime::kRebJsInvocationEnter ||
+         it.GetRuntimeIdOperand(0) == i::Runtime::kRebJsInvocationExit)) {
+      ++calls;
+    }
+  }
+  return calls;
+}
+
+uint64_t RebRolling(const std::string& bytes) {
+  uint64_t hash = 0;
+  for (unsigned char byte : bytes) hash = hash * 0x100000001b3ULL + byte;
+  return hash;
+}
+
+// Shaped like the page's window.hsw: a plain function returning a promise
+// whose work runs in a job registered during the call.
+const char kRebHswSource[] =
+    "function rebHsw(mode, jwt) { observe(1); return Promise.resolve()."
+    "then(function () { observe(2); return 'tok-' + jwt; }); }"
+    "function rebPlain(mode, jwt) { return Promise.resolve().then("
+    "function () { observe(3); return 'tok-' + jwt; }); }";
+
+}  // namespace
+
+TEST(RebNativeJsInvocationDisabledAndUnarmedBytecodeIdentity) {
+  LocalContext env;
+  v8::Isolate* isolate = env.isolate();
+  v8::HandleScope scope(isolate);
+  const std::string source = kRebHswSource;
+  RebBytecode plain;
+  {
+    // Flag off: the generator reads one flag and emits unarmed bytecode.
+    i::FlagScope<bool> cache(&i::v8_flags.compilation_cache, false);
+    CompileRun(source.c_str());
+    RebCompile("rebHsw");
+    plain = RebBytecodeOf("rebHsw");
+  }
+  RebBytecode off;
+  {
+    // Flag on with no armed site: byte-identical.
+    RebJsInvocationScope capture(env);
+    capture.embedder().epoch = 0;
+    CompileRun(source.c_str());
+    RebCompile("rebHsw");
+    off = RebBytecodeOf("rebHsw");
+    CHECK(off.SameAs(plain));
+    CHECK_EQ(0, RebInvocationCalls("rebHsw"));
+  }
+  {
+    RebJsInvocationScope capture(env);
+    capture.Arm(1, {RebInvocationSite(source, RebAnchor(source, "rebHsw(", 6))});
+    CompileRun(source.c_str());
+    RebCompile("rebHsw");
+    RebCompile("rebPlain");
+    // The unarmed sibling keeps exactly its unarmed bytecode.
+    CHECK_EQ(0, RebInvocationCalls("rebPlain"));
+    // Armed but not yet called: an entry and exits are emitted, nothing is
+    // reported.
+    CHECK_LT(1, RebInvocationCalls("rebHsw"));
+    CHECK(!RebBytecodeOf("rebHsw").SameAs(off));
+    CHECK(capture.embedder().starts.empty());
+    CHECK(capture.embedder().settles.empty());
+    CompileRun("rebPlain(1, 'x')");
+    isolate->PerformMicrotaskCheckpoint();
+    CHECK(capture.embedder().starts.empty());
+    CHECK(capture.embedder().settles.empty());
+    // Outside any call no invocation is current.
+    CHECK(isolate->GetCurrentJsInvocation().state ==
+          v8::JsInvocationContextState::kNone);
+  }
+}
+
+TEST(RebNativeJsInvocationArgumentsAndSynchronousSettlement) {
+  LocalContext env;
+  v8::Isolate* isolate = env.isolate();
+  v8::HandleScope scope(isolate);
+  RebJsInvocationScope capture(env);
+  const std::string source =
+      "function rebSync(mode, jwt, extra) { observe(mode); "
+      "if (mode === 2) throw new Error('boom'); return [mode, jwt]; }";
+  capture.Arm(7, {RebInvocationSite(source, RebAnchor(source, "rebSync(", 7))});
+  CompileRun(source.c_str());
+  CompileRun("rebSync(1, 'jwt', {}, 4, 5, 6, 7, 8, 9)");
+  const auto& starts = capture.embedder().starts;
+  CHECK_EQ(1u, starts.size());
+  CHECK_EQ(9u, starts[0].argument_count);
+  CHECK(starts[0].argument_kinds[0] == v8::JsInvocationValueKind::kInteger);
+  CHECK_EQ(1u, starts[0].argument_low32[0]);
+  CHECK(starts[0].argument_kinds[1] == v8::JsInvocationValueKind::kString);
+  CHECK_EQ(0u, starts[0].argument_low32[1]);
+  CHECK(starts[0].argument_kinds[2] == v8::JsInvocationValueKind::kObject);
+  CHECK_EQ(0u, starts[0].parent_invocation_id);
+  const auto& observed = capture.embedder().observed;
+  CHECK_EQ(1u, observed.size());
+  CHECK(observed[0].second.state == v8::JsInvocationContextState::kInside);
+  CHECK_EQ(starts[0].invocation_id, observed[0].second.invocation_id);
+  const auto& settles = capture.embedder().settles;
+  CHECK_EQ(1u, settles.size());
+  CHECK(settles[0].outcome == v8::JsInvocationOutcome::kFulfilled);
+  CHECK(settles[0].via == v8::JsInvocationSettleVia::kSyncReturn);
+  CHECK(settles[0].value_kind == v8::JsInvocationValueKind::kArray);
+  CHECK_EQ(2u, settles[0].value_length);
+  CHECK(settles[0].digest_state ==
+        v8::JsInvocationDigestState::kNotRequested);
+  // A throw is a synchronous rejection; the page sees the same exception.
+  CHECK(CompileRun("try { rebSync(2, 'jwt'); 'no' } catch (e) { e.message }")
+            ->Equals(env.local(), v8_str("boom"))
+            .FromJust());
+  CHECK_EQ(2u, settles.size());
+  CHECK(settles[1].outcome == v8::JsInvocationOutcome::kRejected);
+  CHECK(settles[1].via == v8::JsInvocationSettleVia::kSyncThrow);
+  CHECK(isolate->GetCurrentJsInvocation().state ==
+        v8::JsInvocationContextState::kNone);
+}
+
+TEST(RebNativeJsInvocationPromiseJobsAndDigest) {
+  LocalContext env;
+  v8::Isolate* isolate = env.isolate();
+  v8::HandleScope scope(isolate);
+  RebJsInvocationScope capture(env);
+  const std::string source = kRebHswSource;
+  capture.Arm(3, {RebInvocationSite(source, RebAnchor(source, "rebHsw(", 6))});
+  capture.embedder().digests = true;
+  CompileRun(source.c_str());
+  CompileRun("var rebResult; rebHsw(0, 'abc').then(v => rebResult = v);");
+  // The call returned a pending promise; the job it registered has not run.
+  CHECK(capture.embedder().settles.empty());
+  isolate->PerformMicrotaskCheckpoint();
+  CHECK(CompileRun("rebResult")->Equals(env.local(), v8_str("tok-abc")).FromJust());
+  const auto& starts = capture.embedder().starts;
+  const auto& observed = capture.embedder().observed;
+  CHECK_EQ(1u, starts.size());
+  CHECK_EQ(2u, observed.size());
+  // The promise job registered during the call runs inside the invocation.
+  for (const auto& [tag, context] : observed) {
+    CHECK(context.state == v8::JsInvocationContextState::kInside);
+    CHECK_EQ(starts[0].invocation_id, context.invocation_id);
+  }
+  const auto& settles = capture.embedder().settles;
+  CHECK_EQ(1u, settles.size());
+  CHECK(settles[0].via == v8::JsInvocationSettleVia::kPromise);
+  CHECK(settles[0].outcome == v8::JsInvocationOutcome::kFulfilled);
+  CHECK(settles[0].value_kind == v8::JsInvocationValueKind::kString);
+  CHECK_EQ(7u, settles[0].value_length);
+  CHECK(settles[0].digest_state == v8::JsInvocationDigestState::kPresent);
+  CHECK(settles[0].digest_encoding == v8::JsInvocationDigestEncoding::kUtf8);
+  CHECK_EQ(7u, settles[0].digest_byte_length);
+  uint8_t expected[32];
+  const std::string value = "tok-abc";
+  i::SHA256_hash(value.data(), value.size(), expected);
+  CHECK_EQ(0, std::memcmp(expected, settles[0].value_sha256, 32));
+  CHECK_EQ(RebRolling(value), settles[0].rolling_hash);
+  // A job registered outside the call is not attributed to it.
+  CompileRun("Promise.resolve().then(() => observe(9));");
+  isolate->PerformMicrotaskCheckpoint();
+  CHECK_EQ(9, observed.back().first);
+  CHECK(observed.back().second.state == v8::JsInvocationContextState::kNone);
+}
+
+TEST(RebNativeJsInvocationInterleavedAsyncCallsKeepTheirIds) {
+  LocalContext env;
+  v8::Isolate* isolate = env.isolate();
+  v8::HandleScope scope(isolate);
+  RebJsInvocationScope capture(env);
+  const std::string source =
+      "async function rebAsync(n, gate) { observe(n); await null; observe(n); "
+      "await gate; observe(n); return n; }"
+      "var rebOpen = [], rebGates = [0, 1].map(() => new Promise(r => "
+      "rebOpen.push(r)));";
+  capture.Arm(5, {RebInvocationSite(source, RebAnchor(source, "rebAsync(", 8))});
+  CompileRun(source.c_str());
+  CompileRun("rebAsync(1, rebGates[0]); rebAsync(2, rebGates[1]);");
+  // Each call returned to its caller at its first await.
+  CHECK(isolate->GetCurrentJsInvocation().state ==
+        v8::JsInvocationContextState::kNone);
+  isolate->PerformMicrotaskCheckpoint();
+  // Resolve in the opposite order from outside both invocations.
+  CompileRun("rebOpen[1](); rebOpen[0]();");
+  isolate->PerformMicrotaskCheckpoint();
+  const auto& starts = capture.embedder().starts;
+  CHECK_EQ(2u, starts.size());
+  CHECK_NE(starts[0].invocation_id, starts[1].invocation_id);
+  const auto& observed = capture.embedder().observed;
+  CHECK_EQ(6u, observed.size());
+  for (const auto& [tag, context] : observed) {
+    CHECK(context.state == v8::JsInvocationContextState::kInside);
+    CHECK_EQ(starts[tag - 1].invocation_id, context.invocation_id);
+  }
+  const auto& settles = capture.embedder().settles;
+  CHECK_EQ(2u, settles.size());
+  for (const auto& settle : settles) {
+    CHECK(settle.via == v8::JsInvocationSettleVia::kPromise);
+    CHECK(settle.value_kind == v8::JsInvocationValueKind::kInteger);
+  }
+  // The second call settled first, and each settle names its own call.
+  CHECK_EQ(starts[1].invocation_id, settles[0].invocation_id);
+  CHECK_EQ(starts[0].invocation_id, settles[1].invocation_id);
+}
