+// REB native JavaScript invocation identity. Inactive unless V8 runs with
+// --reb-js-invocation-capture (off by default) and the embedder reports a
+// nonzero epoch. A site is a function whose V8 start position (the `(` of its
+// parameter list, or the first character of an arrow head) is anchor_offset,
+// in UTF-16 code units of Script::source.
+constexpr size_t kJsInvocationSiteLimit = 8;
+constexpr size_t kJsInvocationArgumentLimit = 8;
+constexpr uint32_t kJsInvocationDigestByteLimit = 1u << 20;
+
+struct JsInvocationSite {
+  // SHA-256 of the script source as UTF-16LE code units.
+  uint8_t source_sha256[32];
+  uint32_t source_length;  // UTF-16 code units.
+  uint32_t anchor_offset;  // UTF-16 code units.
+};
+
+enum class JsInvocationValueKind : uint8_t {
+  kInteger = 1,  // Smi, or a Number with an integral value in int64 range.
+  kNumber = 2,
+  kString = 3,
+  kSymbol = 4,
+  kUndefined = 5,
+  kNull = 6,
+  kBoolean = 7,
+  kBigInt = 8,
+  kObject = 9,
+  kFunction = 10,
+  kArray = 11,
+  kArrayBuffer = 12,
+  kArrayBufferView = 13,  // A typed array or DataView.
+  kPromise = 14,
+};
+
+struct JsInvocationStart {
+  uint32_t slot;  // Index of the armed site, below kJsInvocationSiteLimit.
+  int script_id;
+  uint32_t source_length;
+  uint32_t anchor_offset;
+  uint32_t invocation_id;         // Nonzero, never reused in this isolate.
+  uint32_t parent_invocation_id;  // The invocation current at entry, or 0.
+  bool parent_unknown;  // Entered under an older configuration's invocation.
+  uint32_t argument_count;  // Actual arguments, excluding the receiver.
+  // The first min(argument_count, kJsInvocationArgumentLimit) arguments:
+  // a kind, and for an integer its low 32 bits, for a boolean 0 or 1. No
+  // other argument or receiver content is read.
+  JsInvocationValueKind argument_kinds[kJsInvocationArgumentLimit];
+  uint32_t argument_low32[kJsInvocationArgumentLimit];
+  const uint8_t* source_sha256;  // 32 bytes, borrowed for the call only.
+};
+
+enum class JsInvocationOutcome : uint8_t { kFulfilled = 1, kRejected = 2 };
+enum class JsInvocationSettleVia : uint8_t {
+  kSyncReturn = 1,  // The call returned a value that is not a promise.
+  kSyncThrow = 2,   // An exception left the call's frame.
+  kPromise = 3,     // The native promise the caller received settled.
+};
+enum class JsInvocationDigestState : uint8_t {
+  kNotRequested = 0,   // The configuration does not enable value digests.
+  kPresent = 1,
+  kNotDigestible = 2,  // A rejection, or a kind with no byte encoding.
+  kTooLarge = 3,       // Over kJsInvocationDigestByteLimit encoded bytes.
+  kUnavailable = 4,    // Detached, shared or variable-length bytes.
+};
+enum class JsInvocationDigestEncoding : uint8_t {
+  kNone = 0,
+  kUtf8 = 1,   // Strings; a lone surrogate is encoded as U+FFFD.
+  kBytes = 2,  // An ArrayBuffer, or the bytes a view covers.
+};
+
+struct JsInvocationSettle {
+  uint32_t slot;
+  uint32_t invocation_id;
+  JsInvocationOutcome outcome;
+  JsInvocationSettleVia via;
+  JsInvocationValueKind value_kind;
+  // UTF-16 length of a string, element count of an array, byte length of
+  // available bytes; otherwise 0.
+  uint32_t value_length;
+  JsInvocationDigestState digest_state;
+  JsInvocationDigestEncoding digest_encoding;
+  bool lossy_utf8;
+  // With kPresent only: the encoded bytes' length, their 64-bit polynomial
+  // rolling hash (h = h * 0x100000001b3 + byte) and their SHA-256.
+  uint32_t digest_byte_length;
+  uint64_t rolling_hash;
+  uint8_t value_sha256[32];
+};
+
+enum class JsInvocationSiteStatus : uint8_t {
+  // The armed function already had bytecode without its entry call.
+  kCompiledBeforeArming = 1,
+  // The armed function is a generator, constructor or initializer.
+  kUnsupportedFunction = 2,
+};
+
+enum class JsInvocationContextState : uint8_t {
+  kNotObserved = 0,  // Invocation capture is not active.
+  kNone = 1,         // No invocation is current.
+  kInside = 2,       // invocation_id is current.
+  kUnknown = 3,      // A context from an older configuration.
+};
+
+struct JsInvocationContext {
+  JsInvocationContextState state;
+  uint32_t invocation_id;  // Nonzero only for kInside.
+};
+
+// Current embedder capture epoch; 0 means inactive. Must not call into V8.
+using JsInvocationEpochCallback = uint64_t (*)();
+// Copies at most capacity armed sites for epoch and returns the count. Must
+// not call into V8.
+using JsInvocationSitesCallback = size_t (*)(uint64_t epoch,
+                                             JsInvocationSite* sites,
+                                             size_t capacity);
+// Admission for a new invocation, before any allocation. Must not allocate
+// or call into V8.
+using JsInvocationEnabledCallback = bool (*)(uint64_t epoch, uint32_t slot);
+// Whether epoch enables value digests, a sensitive capture path. Must not
+// call into V8.
+using JsInvocationDigestsCallback = bool (*)(uint64_t epoch);
+// Synchronous on the isolate thread. Do not execute JS, allocate V8 heap
+// objects, retain pointers, block, or perform I/O.
+using JsInvocationStartCallback = void (*)(Local<Context> context,
+                                           uint64_t epoch,
+                                           const JsInvocationStart& start);
+// Same restrictions. The context is the armed function's for a synchronous
+// settlement and the internal reaction's for a promise.
+using JsInvocationSettleCallback = void (*)(Local<Context> context,
+                                            uint64_t epoch,
+                                            const JsInvocationSettle& settle);
+// Same restrictions; no context is available.
+using JsInvocationStatusCallback = void (*)(uint64_t epoch, uint32_t slot,
+                                            JsInvocationSiteStatus status,
+                                            int script_id);
+
+struct JsInvocationCallbacks {
+  JsInvocationEpochCallback epoch = nullptr;
+  JsInvocationSitesCallback sites = nullptr;
+  JsInvocationEnabledCallback enabled = nullptr;
+  JsInvocationDigestsCallback digests = nullptr;
+  JsInvocationStartCallback start = nullptr;
+  JsInvocationSettleCallback settle = nullptr;
+  JsInvocationStatusCallback status = nullptr;
+};
+
