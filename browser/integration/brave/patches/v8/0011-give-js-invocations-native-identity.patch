+void RebJsInvocation::SetCallbacks(Isolate* isolate,
+                                   const v8::JsInvocationCallbacks& callbacks) {
+  callbacks_ = callbacks;
+  synced_ = false;
+  Reset(0);
+  Sync(isolate);
+}
+
+bool RebJsInvocation::Complete() const {
+  return callbacks_.epoch != nullptr && callbacks_.sites != nullptr &&
+         callbacks_.enabled != nullptr && callbacks_.digests != nullptr &&
+         callbacks_.start != nullptr && callbacks_.settle != nullptr &&
+         callbacks_.status != nullptr;
+}
+
+void RebJsInvocation::Reset(uint64_t epoch) {
+  epoch_ = epoch;
+  any_armed_ = false;
+  digests_ = false;
+  site_count_ = 0;
+  binding_count_ = 0;
+  next_binding_ = 0;
+  reported_unsupported_ = 0;
+  reported_compiled_ = 0;
+  id_floor_ = next_id_;
+}
+
+bool RebJsInvocation::Sync(Isolate* isolate) {
+#if defined(V8_ENABLE_CONTINUATION_PRESERVED_EMBEDDER_DATA)
+  if (!v8_flags.reb_js_invocation_capture || !Complete()) {
+    if (any_armed_) Reset(0);
+    return false;
+  }
+  const uint64_t epoch = callbacks_.epoch();
+  if (synced_ && epoch == epoch_) return any_armed_;
+  synced_ = true;
+  Reset(epoch);
+  if (epoch == 0) return false;
+  v8::JsInvocationSite copied[v8::kJsInvocationSiteLimit] = {};
+  size_t count = callbacks_.sites(epoch, copied, v8::kJsInvocationSiteLimit);
+  if (count > v8::kJsInvocationSiteLimit) count = v8::kJsInvocationSiteLimit;
+  for (size_t slot = 0; slot < count; ++slot) {
+    const v8::JsInvocationSite& from = copied[slot];
+    Site& to = sites_[slot];
+    std::memcpy(to.source_sha256, from.source_sha256,
+                sizeof(to.source_sha256));
+    to.source_length = from.source_length;
+    to.anchor_offset = from.anchor_offset;
+    to.usable = from.source_length != 0 &&
+                from.source_length <= static_cast<uint32_t>(String::kMaxLength) &&
+                from.anchor_offset < from.source_length;
+    any_armed_ = any_armed_ || to.usable;
+  }
+  site_count_ = count;
+  digests_ = callbacks_.digests(epoch);
+  if (any_armed_) ReportCompiledBeforeArming(isolate);
+  return any_armed_;
+#else
+  // Without continuation-preserved embedder data no continuation can carry an
+  // invocation, so nothing is ever armed.
+  return false;
+#endif
+}
+
+uint32_t RebJsInvocation::BindingMask(Tagged<Script> script) {
+  if (script->type() != Script::Type::kNormal || script->id() <= 0 ||
+      !IsString(script->source())) {
+    return 0;
+  }
+  const int script_id = script->id();
+  for (size_t i = 0; i < binding_count_; ++i) {
+    if (bindings_[i].script_id == script_id) return bindings_[i].mask;
+  }
+  Tagged<String> source = Cast<String>(script->source());
+  const uint32_t length = source->length();
+  bool length_matches = false;
+  for (size_t slot = 0; slot < site_count_; ++slot) {
+    length_matches = length_matches || (sites_[slot].usable &&
+                                        sites_[slot].source_length == length);
+  }
+  // Most scripts are rejected here without hashing or a cache entry.
+  if (!length_matches) return 0;
+  uint8_t digest[kSizeOfSha256Digest];
+  if (!RebSourceDigest(source, digest)) return 0;
+  uint32_t mask = 0;
+  for (size_t slot = 0; slot < site_count_; ++slot) {
+    const Site& site = sites_[slot];
+    if (site.usable && site.source_length == length &&
+        std::memcmp(site.source_sha256, digest, sizeof(digest)) == 0) {
+      mask |= 1u << slot;
+    }
+  }
+  // Negative results are cached too; eviction only costs a rehash.
+  bindings_[next_binding_] = {script_id, mask};
+  next_binding_ = (next_binding_ + 1) % kBindingLimit;
+  if (binding_count_ < kBindingLimit) ++binding_count_;
+  return mask;
+}
+
+bool RebJsInvocation::SlotFor(Tagged<Script> script, int start_position,
+                              uint32_t* slot) {
+  const uint32_t mask = BindingMask(script);
+  for (size_t i = 0; i < site_count_; ++i) {
+    if ((mask & (1u << i)) != 0 &&
+        sites_[i].anchor_offset == static_cast<uint32_t>(start_position)) {
+      *slot = static_cast<uint32_t>(i);
+      return true;
+    }
+  }
+  return false;
+}
+
+void RebJsInvocation::ReportStatus(uint32_t slot,
+                                   v8::JsInvocationSiteStatus status,
+                                   int script_id) {
+  uint32_t* reported =
+      status == v8::JsInvocationSiteStatus::kUnsupportedFunction
+          ? &reported_unsupported_
+          : &reported_compiled_;
+  if ((*reported & (1u << slot)) != 0) return;
+  *reported |= 1u << slot;
+  callbacks_.status(epoch_, slot, status, script_id);
+}
+
+bool RebJsInvocation::ArmedSlot(Isolate* isolate, Tagged<Script> script,
+                                int start_position, FunctionKind kind,
+                                uint32_t* slot) {
+  if (!Sync(isolate) || !SlotFor(script, start_position, slot)) return false;
+  if (!RebSupportedKind(kind)) {
+    ReportStatus(*slot, v8::JsInvocationSiteStatus::kUnsupportedFunction,
+                 script->id());
+    return false;
+  }
+  return true;
+}
+
+void RebJsInvocation::RecordArmedFunction(int script_id, int start_position) {
+  if (IsArmedFunction(script_id, start_position)) return;
+  // Oldest first. A lost entry can only repeat a compiled-before-arming
+  // status for a function that is in fact armed; it never arms anything.
+  armed_functions_[next_armed_function_] = {script_id, start_position};
+  next_armed_function_ = (next_armed_function_ + 1) % kArmedFunctionLimit;
+  if (armed_function_count_ < kArmedFunctionLimit) ++armed_function_count_;
+}
+
+bool RebJsInvocation::IsArmedFunction(int script_id,
+                                      int start_position) const {
+  for (size_t i = 0; i < armed_function_count_; ++i) {
+    if (armed_functions_[i].script_id == script_id &&
+        armed_functions_[i].start_position == start_position) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void RebJsInvocation::ReportCompiledBeforeArming(Isolate* isolate) {
+  DisallowGarbageCollection no_gc;
+  Script::Iterator scripts(isolate);
+  for (Tagged<Script> script = scripts.Next(); !script.is_null();
+       script = scripts.Next()) {
+    const uint32_t mask = BindingMask(script);
+    if (mask == 0) continue;
+    Tagged<WeakFixedArray> infos = script->infos();
+    const uint32_t info_count = infos->ulength().value();
+    for (size_t slot = 0; slot < site_count_; ++slot) {
+      if ((mask & (1u << slot)) == 0) continue;
+      const int anchor = static_cast<int>(sites_[slot].anchor_offset);
+      for (uint32_t i = 0; i < info_count; ++i) {
+        Tagged<HeapObject> object;
+        if (!infos->get(i).GetHeapObject(&object) ||
+            !IsSharedFunctionInfo(object)) {
+          continue;
+        }
+        Tagged<SharedFunctionInfo> shared = Cast<SharedFunctionInfo>(object);
+        if (shared->StartPosition() != anchor) continue;
+        if (!RebSupportedKind(shared->kind())) {
+          ReportStatus(static_cast<uint32_t>(slot),
+                       v8::JsInvocationSiteStatus::kUnsupportedFunction,
+                       script->id());
+        } else if (shared->is_compiled() &&
+                   !IsArmedFunction(script->id(), anchor)) {
+          ReportStatus(static_cast<uint32_t>(slot),
+                       v8::JsInvocationSiteStatus::kCompiledBeforeArming,
+                       script->id());
+        }
+        break;
+      }
+    }
+  }
+}
+
+bool RebJsInvocation::IsCurrentId(uint32_t id) const {
+  return id != 0 && id >= id_floor_ && id < next_id_;
+}
+
+Tagged<Object> RebJsInvocation::Enter(Isolate* isolate,
+                                      DirectHandle<JSFunction> closure) {
+  ReadOnlyRoots roots(isolate);
+  if (!Sync(isolate)) return roots.undefined_value();
+  Tagged<SharedFunctionInfo> shared = closure->shared();
+  if (!IsScript(shared->script())) return roots.undefined_value();
+  Tagged<Script> script = Cast<Script>(shared->script());
+  uint32_t slot = 0;
+  // Bytecode armed by an earlier configuration keeps its call; it returns
+  // here unless the current configuration arms the same function.
+  if (!SlotFor(script, shared->StartPosition(), &slot) ||
+      !callbacks_.enabled(epoch_, slot) || next_id_ >= kRebIdLimit) {
+    return roots.undefined_value();
+  }
+
+  v8::JsInvocationStart start = {};
+  start.slot = slot;
+  start.script_id = script->id();
+  start.source_length = sites_[slot].source_length;
+  start.anchor_offset = sites_[slot].anchor_offset;
+  start.source_sha256 = sites_[slot].source_sha256;
+  {
+    // The armed frame is the innermost JavaScript frame: this runtime call
+    // is its first bytecode after the generator prologue.
+    JavaScriptStackFrameIterator frames(isolate);
+    if (!frames.done() && frames.frame()->function() == *closure) {
+      JavaScriptFrame* frame = frames.frame();
+      start.argument_count = frame->GetActualArgumentCount();
+      const uint32_t described =
+          std::min<uint32_t>(start.argument_count,
+                             static_cast<uint32_t>(v8::kJsInvocationArgumentLimit));
+      for (uint32_t i = 0; i < described; ++i) {
+        start.argument_kinds[i] = RebClassify(
+            frame->GetParameter(static_cast<int>(i)), &start.argument_low32[i]);
+      }
+    }
+  }
+
+  Tagged<Object> saved_slot =
+      isolate->isolate_data()->continuation_preserved_embedder_data();
+  if (IsRebWrapper(saved_slot)) {
+    Tagged<Object> parent = Cast<Tuple2>(saved_slot)->value2();
+    if (IsSmi(parent) && Smi::ToInt(parent) > 0 &&
+        IsCurrentId(static_cast<uint32_t>(Smi::ToInt(parent)))) {
+      start.parent_invocation_id = static_cast<uint32_t>(Smi::ToInt(parent));
+    } else {
+      start.parent_unknown = true;
+    }
+  }
+
+  const uint32_t id = next_id_++;
+  start.invocation_id = id;
+  HandleScope scope(isolate);
+  DirectHandle<Object> saved(saved_slot, isolate);
+  DirectHandle<Object> embedder(EmbedderData(saved_slot), isolate);
+  DirectHandle<NativeContext> context(closure->native_context(), isolate);
+  DirectHandle<Object> id_smi(Smi::FromInt(static_cast<int>(id)), isolate);
+  DirectHandle<Tuple2> wrapper =
+      isolate->factory()->NewTuple2(embedder, id_smi, AllocationType::kYoung);
+  DirectHandle<FixedArray> record =
+      isolate->factory()->NewFixedArray(kRecordLength);
+  record->set(kRecordSaved, *saved);
+  record->set(kRecordId, Smi::FromInt(static_cast<int>(id)));
+  record->set(kRecordSlot, Smi::FromInt(static_cast<int>(slot)));
+  record->set(kRecordContext, *context);
+  isolate->isolate_data()->set_continuation_preserved_embedder_data(*wrapper);
+  callbacks_.start(Utils::ToLocal(context), epoch_, start);
+  return *record;
+}
+
+Tagged<Object> RebJsInvocation::Exit(Isolate* isolate,
+                                     DirectHandle<Object> record_object,
+                                     DirectHandle<Object> value, int kind) {
+  if (!IsFixedArray(*record_object)) return *value;
+  DirectHandle<FixedArray> record = Cast<FixedArray>(record_object);
+  // length() is a SafeHeapObjectSize on this pin, not an int.
+  if (record->length().value() != static_cast<uint32_t>(kRecordLength) ||
+      !IsSmi(record->get(kRecordId)) ||
+      !IsSmi(record->get(kRecordSlot)) ||
+      !IsNativeContext(record->get(kRecordContext))) {
+    return *value;
+  }
+  const int signed_id = Smi::ToInt(record->get(kRecordId));
+  // A resumed async body runs inside the job that restored its context; only
+  // the initial synchronous extent owns the caller's slot.
+  if (signed_id <= 0) return *value;
+  isolate->isolate_data()->set_continuation_preserved_embedder_data(
+      record->get(kRecordSaved));
+  record->set(kRecordId, Smi::FromInt(-signed_id));
+
+  const uint32_t id = static_cast<uint32_t>(signed_id);
+  const uint32_t slot = static_cast<uint32_t>(Smi::ToInt(record->get(kRecordSlot)));
+  // ToLocal yields a Context only for a NativeContext handle.
+  DirectHandle<NativeContext> context(
+      Cast<NativeContext>(record->get(kRecordContext)), isolate);
+  if (kind == kRebJsInvocationThrow) {
+    Settle(isolate, context, id, slot, false,
+           v8::JsInvocationSettleVia::kSyncThrow, value);
+  } else if (IsJSPromise(*value)) {
+    DirectHandle<JSPromise> promise = Cast<JSPromise>(value);
+    switch (promise->status()) {
+      case v8::Promise::kPending:
+        Watch(isolate, promise, context, id, slot);
+        break;
+      case v8::Promise::kFulfilled:
+      case v8::Promise::kRejected: {
+        DirectHandle<Object> result(promise->result(), isolate);
+        Settle(isolate, context, id, slot,
+               promise->status() == v8::Promise::kFulfilled,
+               v8::JsInvocationSettleVia::kPromise, result);
+        break;
+      }
+    }
+  } else {
+    // A non-promise value, including a thenable: nothing calls its then.
+    Settle(isolate, context, id, slot, true,
+           v8::JsInvocationSettleVia::kSyncReturn, value);
+  }
+  return *value;
+}
+
+void RebJsInvocation::Watch(Isolate* isolate, DirectHandle<JSPromise> promise,
+                            DirectHandle<NativeContext> context, uint32_t id,
+                            uint32_t slot) {
+  if (!Sync(isolate) || !IsCurrentId(id)) return;
+  v8::Isolate* v8_isolate = reinterpret_cast<v8::Isolate*>(isolate);
+  v8::Local<v8::Context> local_context = Utils::ToLocal(context);
+  v8::Local<v8::Value> data =
+      v8::Integer::NewFromUnsigned(v8_isolate, (id << 3) | slot);
+  v8::Local<v8::Function> fulfilled;
+  v8::Local<v8::Function> rejected;
+  if (!v8::Function::New(local_context, OnWatchedFulfilled, data, 1,
+                         v8::ConstructorBehavior::kThrow,
+                         v8::SideEffectType::kHasNoSideEffect)
+           .ToLocal(&fulfilled) ||
+      !v8::Function::New(local_context, OnWatchedRejected, data, 1,
+                         v8::ConstructorBehavior::kThrow,
+                         v8::SideEffectType::kHasNoSideEffect)
+           .ToLocal(&rejected) ||
+      promise->status() != v8::Promise::kPending) {
+    return;
+  }
+  // Appended directly rather than through PerformPromiseThen: has_handler is
+  // untouched, so unhandled rejection is reported to the page as before; no
+  // then, species or getter runs; and with an undefined capability, as for
+  // await, the job has no result promise.
+  DirectHandle<PromiseReaction> reaction = Cast<PromiseReaction>(
+      isolate->factory()->NewStruct(PROMISE_REACTION_TYPE));
+  Tagged<UnionOf<Smi, PromiseReaction>> next =
+      Cast<UnionOf<Smi, PromiseReaction>>(promise->reactions());
+  reaction->set_next(next);
+  Tagged<JSFunction> on_rejected =
+      Cast<JSFunction>(*Utils::OpenDirectHandle(*rejected));
+  Tagged<JSFunction> on_fulfilled =
+      Cast<JSFunction>(*Utils::OpenDirectHandle(*fulfilled));
+  reaction->set_reject_handler(on_rejected);
+  reaction->set_fulfill_handler(on_fulfilled);
+  reaction->set_promise_or_capability(ReadOnlyRoots(isolate).undefined_value());
+#if defined(V8_ENABLE_CONTINUATION_PRESERVED_EMBEDDER_DATA)
+  reaction->set_continuation_preserved_embedder_data(
+      ReadOnlyRoots(isolate).undefined_value());
+#endif
+  promise->set_reactions_or_result(*reaction);
+}
+
+void RebJsInvocation::PromiseSettled(Isolate* isolate, uint32_t encoded,
+                                     bool fulfilled,
+                                     DirectHandle<Object> value) {
+  HandleScope scope(isolate);
+  DirectHandle<NativeContext> context = isolate->native_context();
+  Settle(isolate, context, encoded >> 3, encoded & 7, fulfilled,
+         v8::JsInvocationSettleVia::kPromise, value);
+}
+
+void RebJsInvocation::Settle(Isolate* isolate,
+                             DirectHandle<NativeContext> context, uint32_t id,
+                             uint32_t slot, bool fulfilled,
+                             v8::JsInvocationSettleVia via,
+                             DirectHandle<Object> value) {
+  // An invocation of an earlier configuration is never reported under the
+  // current one.
+  if (!Sync(isolate) || !IsCurrentId(id) || slot >= site_count_) return;
+  v8::JsInvocationSettle settle = {};
+  settle.slot = slot;
+  settle.invocation_id = id;
+  settle.outcome = fulfilled ? v8::JsInvocationOutcome::kFulfilled
+                             : v8::JsInvocationOutcome::kRejected;
+  settle.via = via;
+  uint32_t ignored_low32 = 0;
+  settle.value_kind = RebClassify(*value, &ignored_low32);
+  const uint8_t* bytes = nullptr;
+  size_t byte_length = 0;
+  bool bytes_available = false;
+  switch (settle.value_kind) {
+    case v8::JsInvocationValueKind::kString:
+      settle.value_length = Cast<String>(*value)->length();
+      break;
+    case v8::JsInvocationValueKind::kArray: {
+      Tagged<Object> length = Cast<JSArray>(*value)->length();
+      settle.value_length =
+          IsSmi(length) ? static_cast<uint32_t>(Smi::ToInt(length))
+                        : static_cast<uint32_t>(Cast<HeapNumber>(length)->value());
+      break;
+    }
+    case v8::JsInvocationValueKind::kArrayBuffer: {
+      Tagged<JSArrayBuffer> buffer = Cast<JSArrayBuffer>(*value);
+      bytes_available = !buffer->was_detached() && !buffer->is_shared() &&
+                        !buffer->is_resizable_by_js();
+      if (bytes_available) {
+        bytes = static_cast<const uint8_t*>(buffer->backing_store());
+        byte_length = buffer->byte_length();
+      }
+      break;
+    }
+    case v8::JsInvocationValueKind::kArrayBufferView: {
+      Tagged<JSArrayBufferView> view = Cast<JSArrayBufferView>(*value);
+      bytes_available = !view->WasDetached() && !view->IsVariableLength() &&
+                        !view->buffer()->is_shared();
+      if (bytes_available) {
+        bytes = static_cast<const uint8_t*>(view->buffer()->backing_store());
+        if (bytes != nullptr) bytes += view->byte_offset();
+        byte_length = view->byte_length();
+      }
+      break;
+    }
+    default:
+      break;
+  }
+  const bool raw = settle.value_kind == v8::JsInvocationValueKind::kArrayBuffer ||
+                   settle.value_kind == v8::JsInvocationValueKind::kArrayBufferView;
+  if (raw && bytes_available) {
+    settle.value_length =
+        static_cast<uint32_t>(std::min<size_t>(byte_length, UINT32_MAX));
+  }
+
+  if (!digests_) {
+    settle.digest_state = v8::JsInvocationDigestState::kNotRequested;
+  } else if (!fulfilled ||
+             (settle.value_kind != v8::JsInvocationValueKind::kString && !raw)) {
+    settle.digest_state = v8::JsInvocationDigestState::kNotDigestible;
+  } else if (settle.value_kind == v8::JsInvocationValueKind::kString) {
+    if (RebDigestString(isolate, Cast<String>(value), &settle)) {
+      settle.digest_state = v8::JsInvocationDigestState::kPresent;
+      settle.digest_encoding = v8::JsInvocationDigestEncoding::kUtf8;
+    } else {
+      settle.digest_state = v8::JsInvocationDigestState::kTooLarge;
+      settle.lossy_utf8 = false;
+    }
+  } else if (!bytes_available) {
+    settle.digest_state = v8::JsInvocationDigestState::kUnavailable;
+  } else if (byte_length > v8::kJsInvocationDigestByteLimit) {
+    settle.digest_state = v8::JsInvocationDigestState::kTooLarge;
+  } else {
+    RebValueDigest digest;
+    if (byte_length != 0) digest.Add(bytes, byte_length);
+    digest.Finish(&settle);
+    settle.digest_state = v8::JsInvocationDigestState::kPresent;
+    settle.digest_encoding = v8::JsInvocationDigestEncoding::kBytes;
+  }
+  callbacks_.settle(Utils::ToLocal(context), epoch_, settle);
+}
+
+v8::JsInvocationContext RebJsInvocation::Current(Isolate* isolate) {
+  v8::JsInvocationContext result = {
+      v8::JsInvocationContextState::kNotObserved, 0};
+#if defined(V8_ENABLE_CONTINUATION_PRESERVED_EMBEDDER_DATA)
+  if (!v8_flags.reb_js_invocation_capture || !Complete() || !synced_ ||
+      epoch_ == 0) {
+    return result;
+  }
+  Tagged<Object> slot =
+      isolate->isolate_data()->continuation_preserved_embedder_data();
+  // A configuration change since the last sync leaves any wrapper
+  // unattributable until V8 syncs again; it is never reported as current.
+  if (callbacks_.epoch() != epoch_) {
+    if (IsRebWrapper(slot)) {
+      result.state = v8::JsInvocationContextState::kUnknown;
+    }
+    return result;
+  }
+  if (!IsRebWrapper(slot)) {
+    result.state = v8::JsInvocationContextState::kNone;
+    return result;
+  }
+  Tagged<Object> id = Cast<Tuple2>(slot)->value2();
+  if (IsSmi(id) && Smi::ToInt(id) > 0 &&
+      IsCurrentId(static_cast<uint32_t>(Smi::ToInt(id)))) {
+    result.state = v8::JsInvocationContextState::kInside;
+    result.invocation_id = static_cast<uint32_t>(Smi::ToInt(id));
+  } else {
+    result.state = v8::JsInvocationContextState::kUnknown;
+  }
+#endif
+  return result;
+}
+
+// static
+Tagged<Object> RebJsInvocation::EmbedderData(Tagged<Object> slot) {
+  return IsRebWrapper(slot) ? Cast<Tuple2>(slot)->value1() : slot;
+}
+
+void RebJsInvocation::SetEmbedderData(Isolate* isolate,
+                                      DirectHandle<Object> data) {
+  Tagged<Object> current =
+      isolate->isolate_data()->continuation_preserved_embedder_data();
+  // Without a current wrapper, or at a top-level task boundary with no
+  // JavaScript on the stack, the embedder's write replaces the slot.
+  if (V8_LIKELY(!IsRebWrapper(current)) ||
+      isolate->js_entry_sp() == kNullAddress) {
+    isolate->isolate_data()->set_continuation_preserved_embedder_data(*data);
+    return;
+  }
+  // A write inside running script (Blink forks task-state variables there)
+  // keeps the invocation of the synchronous extent it happens in.
+  HandleScope scope(isolate);
+  DirectHandle<Object> id(Cast<Tuple2>(current)->value2(), isolate);
+  DirectHandle<Tuple2> wrapper =
+      isolate->factory()->NewTuple2(data, id, AllocationType::kYoung);
+  isolate->isolate_data()->set_continuation_preserved_embedder_data(*wrapper);
+}
+
+}  // namespace v8::internal::interpreter
