+// Emitted only at the entry of an armed function under
+// --reb-js-invocation-capture: (closure). Returns the frame record, or
+// undefined when the call was not admitted. Never throws or runs JavaScript.
+RUNTIME_FUNCTION(Runtime_RebJsInvocationEnter) {
+  HandleScope scope(isolate);
+  DCHECK_EQ(1, args.length());
+  if (!IsJSFunction(args[0])) return ReadOnlyRoots(isolate).undefined_value();
+  return isolate->reb_js_invocation().Enter(isolate, args.at<JSFunction>(0));
+}
+
+// Emitted before every Return of an armed function, before every suspension
+// of an armed async function, and in its whole-body rethrowing handler:
+// (record, value, kind). Returns value. Never throws or runs JavaScript.
+RUNTIME_FUNCTION(Runtime_RebJsInvocationExit) {
+  HandleScope scope(isolate);
+  DCHECK_EQ(3, args.length());
+  DirectHandle<Object> value = args.at(1);
+  if (!IsSmi(args[2])) return *value;
+  return isolate->reb_js_invocation().Exit(isolate, args.at(0), value,
+                                           Smi::ToInt(args[2]));
+}
