+void OnWatchedPromise(const v8::FunctionCallbackInfo<v8::Value>& info,
+                      bool fulfilled) {
+  Isolate* isolate = reinterpret_cast<Isolate*>(info.GetIsolate());
+  v8::Local<v8::Value> data = info.Data();
+  if (data.IsEmpty() || !data->IsUint32()) return;
+  const uint32_t encoded = data.As<v8::Uint32>()->Value();
+  DirectHandle<Object> value = isolate->factory()->undefined_value();
+  if (info.Length() > 0) value = Utils::OpenDirectHandle(*info[0]);
+  isolate->reb_js_invocation().PromiseSettled(isolate, encoded, fulfilled,
+                                              value);
+}
+
+void OnWatchedFulfilled(const v8::FunctionCallbackInfo<v8::Value>& info) {
+  OnWatchedPromise(info, true);
+}
+
+void OnWatchedRejected(const v8::FunctionCallbackInfo<v8::Value>& info) {
+  OnWatchedPromise(info, false);
+}
