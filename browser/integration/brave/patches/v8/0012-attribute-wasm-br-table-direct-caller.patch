+namespace {
+struct RebCallerObservation {
+  uint32_t count = 0;
+  uint32_t function_index = 0;
+  v8::WasmDirectCaller caller = v8::WasmDirectCaller::kUnknown;
+  uint32_t caller_function_index = 0;
+};
+thread_local RebCallerObservation reb_caller_observation;
+
+void ObserveRebBrTableCaller(v8::Local<v8::Context> context, const uint8_t* bytes,
+                             size_t size, uint32_t function_index,
+                             uint32_t module_byte_offset, uint32_t,
+                             uint32_t, v8::WasmDirectCaller caller,
+                             uint32_t caller_function_index) {
+  CHECK(!context.IsEmpty());
+  CHECK_LT(module_byte_offset, size);
+  CHECK_EQ(kExprBrTable, bytes[module_byte_offset]);
+  auto& seen = reb_caller_observation;
+  ++seen.count;
+  seen.function_index = function_index;
+  seen.caller = caller;
+  seen.caller_function_index = caller_function_index;
+}
+}  // namespace
+
+TEST(RebNativeBrTableDirectCaller) {
+  FlagScope<bool> sampling(&v8_flags.reb_wasm_br_table_dispatch, true);
+  // The host called the export that contains the br_table. Unknown is not
+  // function index 0.
+  {
+    WasmRunner<int32_t, int32_t> r(TestExecutionTier::kLiftoff);
+    r.Build({B1(B1(WASM_BR_TABLE(WASM_LOCAL_GET(0), 0, BR_TARGET(0)))),
+             WASM_I32V_1(3)});
+    auto* api = reinterpret_cast<v8::Isolate*>(r.isolate());
+    reb_caller_observation = {};
+    api->SetWasmBrTableDispatchCallback(&ObserveRebBrTableCaller);
+    CHECK_EQ(3, r.Call(0));
+    api->SetWasmBrTableDispatchCallback(nullptr);
+    CHECK_EQ(1, reb_caller_observation.count);
+    CHECK_EQ(r.function_index(), reb_caller_observation.function_index);
+    CHECK(reb_caller_observation.caller == v8::WasmDirectCaller::kUnknown);
+    CHECK_EQ(0, reb_caller_observation.caller_function_index);
+  }
+  // Function 0 calls function 1. The br_table in function 1 names function 0
+  // from this stack only. Index 0 is that function, not the unknown sentinel.
+  {
+    WasmRunner<int32_t> r(TestExecutionTier::kLiftoff);
+    WasmFunctionCompiler& callee = r.NewFunction<int32_t, int32_t>();
+    callee.Build({B1(B1(WASM_BR_TABLE(WASM_LOCAL_GET(0), 0, BR_TARGET(0)))),
+                  WASM_I32V_1(5)});
+    r.Build({WASM_RETURN(WASM_CALL_FUNCTION(callee.function_index(),
+                                            WASM_I32V_1(0)))});
+    CHECK_EQ(0, r.function_index());
+    CHECK_NE(callee.function_index(), r.function_index());
+    auto* api = reinterpret_cast<v8::Isolate*>(r.isolate());
+    reb_caller_observation = {};
+    api->SetWasmBrTableDispatchCallback(&ObserveRebBrTableCaller);
+    CHECK_EQ(5, r.Call());
+    api->SetWasmBrTableDispatchCallback(nullptr);
+    CHECK_EQ(1, reb_caller_observation.count);
+    CHECK_EQ(callee.function_index(), reb_caller_observation.function_index);
+    CHECK(reb_caller_observation.caller ==
+          v8::WasmDirectCaller::kSameInstance);
+    CHECK_EQ(r.function_index(), reb_caller_observation.caller_function_index);
+  }
+  // return_call replaces the caller's frame. The record names the frame that
+  // is live (the host), not the function that executed the return_call.
+  {
+    WasmRunner<int32_t> r(TestExecutionTier::kLiftoff);
+    WasmFunctionCompiler& callee = r.NewFunction<int32_t>();
+    callee.Build({B1(B1(WASM_BR_TABLE(WASM_I32V_1(0), 0, BR_TARGET(0)))),
+                  WASM_I32V_1(11)});
+    r.Build({WASM_RETURN_CALL_FUNCTION0(callee.function_index())});
+    CHECK_NE(callee.function_index(), r.function_index());
+    auto* api = reinterpret_cast<v8::Isolate*>(r.isolate());
+    reb_caller_observation = {};
+    api->SetWasmBrTableDispatchCallback(&ObserveRebBrTableCaller);
+    CHECK_EQ(11, r.Call());
+    api->SetWasmBrTableDispatchCallback(nullptr);
+    CHECK_EQ(1, reb_caller_observation.count);
+    CHECK_EQ(callee.function_index(), reb_caller_observation.function_index);
+    CHECK(reb_caller_observation.caller == v8::WasmDirectCaller::kUnknown);
+    CHECK_EQ(0, reb_caller_observation.caller_function_index);
+  }
+  // A later call on this same isolate must not keep the previous activation's
+  // caller. Both runners share CcTest's isolate; nothing is stored globally.
+  {
+    WasmRunner<int32_t, int32_t> r(TestExecutionTier::kLiftoff);
+    r.Build({B1(B1(WASM_BR_TABLE(WASM_LOCAL_GET(0), 0, BR_TARGET(0)))),
+             WASM_I32V_1(8)});
+    auto* api = reinterpret_cast<v8::Isolate*>(r.isolate());
+    reb_caller_observation = {};
+    api->SetWasmBrTableDispatchCallback(&ObserveRebBrTableCaller);
+    CHECK_EQ(8, r.Call(0));
+    api->SetWasmBrTableDispatchCallback(nullptr);
+    CHECK_EQ(1, reb_caller_observation.count);
+    CHECK(reb_caller_observation.caller == v8::WasmDirectCaller::kUnknown);
+    CHECK_EQ(0, reb_caller_observation.caller_function_index);
+  }
+}
