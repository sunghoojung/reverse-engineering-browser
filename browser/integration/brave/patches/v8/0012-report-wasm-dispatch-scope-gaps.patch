+
+#ifndef V8_WASM_REB_WASM_DISPATCH_SCOPE_H_
+#define V8_WASM_REB_WASM_DISPATCH_SCOPE_H_
+
+#include <atomic>
+#include <cstdint>
+
+#include "src/execution/isolate.h"
+#include "src/flags/flags.h"
+
+namespace v8::internal::wasm {
+
+enum class RebDispatchStream : uint8_t {
+  kBrTable = 1,
+  kCallIndirect = 2,
+  kBoth = 3,
+};
+
+// Remembered when the reporting thread has no current isolate, then delivered
+// by DrainRebWasmDispatchScope. These are not observations.
+constexpr uint8_t kPendingJitlessBr = 1;
+constexpr uint8_t kPendingJitlessIndirect = 2;
+constexpr uint8_t kPendingLeftBr = 4;
+constexpr uint8_t kPendingLeftIndirect = 8;
+
+inline std::atomic<v8::WasmDispatchScopeCallback>&
+RebWasmDispatchScopeCallback() {
+  static std::atomic<v8::WasmDispatchScopeCallback> callback{nullptr};
+  return callback;
+}
+
+inline std::atomic<uint8_t>& RebWasmDispatchScopePendingBits() {
+  static std::atomic<uint8_t> bits{0};
+  return bits;
+}
+
+inline void SetRebWasmDispatchScopeCallback(
+    v8::WasmDispatchScopeCallback callback) {
+  RebWasmDispatchScopeCallback().store(callback, std::memory_order_release);
+}
+
+inline uint8_t RebDispatchScopeBits(v8::WasmDispatchScope scope,
+                                    RebDispatchStream streams) {
+  const bool br = streams == RebDispatchStream::kBrTable ||
+                  streams == RebDispatchStream::kBoth;
+  const bool indirect = streams == RebDispatchStream::kCallIndirect ||
+                        streams == RebDispatchStream::kBoth;
+  uint8_t bits = 0;
+  if (scope == v8::WasmDispatchScope::kJitless) {
+    if (br && v8_flags.reb_wasm_br_table_dispatch) bits |= kPendingJitlessBr;
+    if (indirect && v8_flags.reb_wasm_call_indirect_dispatch) {
+      bits |= kPendingJitlessIndirect;
+    }
+  } else if (scope == v8::WasmDispatchScope::kLeftLiftoff) {
+    if (br && v8_flags.reb_wasm_br_table_dispatch) bits |= kPendingLeftBr;
+    if (indirect && v8_flags.reb_wasm_call_indirect_dispatch) {
+      bits |= kPendingLeftIndirect;
+    }
+  }
+  return bits;
+}
+
+inline void DrainRebWasmDispatchScope() {
+  auto callback = RebWasmDispatchScopeCallback().load(std::memory_order_acquire);
+  if (callback == nullptr) return;
+  const uint8_t bits =
+      RebWasmDispatchScopePendingBits().exchange(0, std::memory_order_acq_rel);
+  if (bits & kPendingJitlessBr) {
+    callback(v8::WasmDispatchScope::kJitless, false);
+  }
+  if (bits & kPendingJitlessIndirect) {
+    callback(v8::WasmDispatchScope::kJitless, true);
+  }
+  if (bits & kPendingLeftBr) {
+    callback(v8::WasmDispatchScope::kLeftLiftoff, false);
+  }
+  if (bits & kPendingLeftIndirect) {
+    callback(v8::WasmDispatchScope::kLeftLiftoff, true);
+  }
+}
+
+// No function index, offset, or selector. Flag-off adds no bits. A null
+// isolate only remembers the notice; the embedder is not called off-thread.
+inline void NotifyRebWasmDispatchScope(Isolate* isolate,
+                                       v8::WasmDispatchScope scope,
+                                       RebDispatchStream streams) {
+  const uint8_t bits = RebDispatchScopeBits(scope, streams);
+  if (bits == 0) return;
+  RebWasmDispatchScopePendingBits().fetch_or(bits, std::memory_order_release);
+  if (isolate == nullptr) return;
+  if (RebWasmDispatchScopeCallback().load(std::memory_order_acquire) ==
+      nullptr) {
+    return;
+  }
+  DrainRebWasmDispatchScope();
+}
+
+}  // namespace v8::internal::wasm
+
+#endif  // V8_WASM_REB_WASM_DISPATCH_SCOPE_H_
