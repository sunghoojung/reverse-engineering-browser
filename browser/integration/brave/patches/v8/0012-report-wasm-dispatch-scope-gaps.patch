+namespace {
+// Called only after allocation_mutex_ is released. A TurboFan wasm function
+// left Liftoff. Jitless publication is the same kind of notice. Neither reads
+// a selector or invents a sample. No current isolate only remembers it.
+void NoteRebWasmDispatchForPublishedCode(WasmCode* code) {
+  if (code == nullptr || code->kind() != WasmCode::kWasmFunction) return;
+  Isolate* isolate = Isolate::TryGetCurrent();
+  if (v8_flags.jitless || v8_flags.wasm_jitless) {
+    NotifyRebWasmDispatchScope(isolate, v8::WasmDispatchScope::kJitless,
+                               RebDispatchStream::kBoth);
+  }
+  if (code->is_turbofan()) {
+    NotifyRebWasmDispatchScope(isolate, v8::WasmDispatchScope::kLeftLiftoff,
+                               RebDispatchStream::kBoth);
+  }
+}
+}  // namespace
+
+WasmCode* NativeModule::PublishCode(UnpublishedWasmCode unpublished_code) {
+  TRACE_EVENT(TRACE_DISABLED_BY_DEFAULT("v8.wasm.detailed"),
+              "wasm.PublishCode");
+  WasmCode* code;
+  {
+    base::RecursiveMutexGuard lock(&allocation_mutex_);
+    code = PublishCodeLocked(std::move(unpublished_code.code),
+                             unpublished_code.assumptions.get());
+  }
+  NoteRebWasmDispatchForPublishedCode(code);
+  return code;
+}
+
+std::vector<WasmCode*> NativeModule::PublishCode(
+    base::Vector<UnpublishedWasmCode> unpublished_codes) {
+  TRACE_EVENT(TRACE_DISABLED_BY_DEFAULT("v8.wasm.detailed"), "wasm.PublishCode",
+              "number", unpublished_codes.size());
+  std::vector<WasmCode*> published_code;
+  {
+    base::RecursiveMutexGuard lock(&allocation_mutex_);
+    // The published code is put into the top-most surrounding {WasmCodeRefScope}.
+    for (auto& unpublished_code : unpublished_codes) {
+      WasmCode* code = PublishCodeLocked(std::move(unpublished_code.code),
+                                         unpublished_code.assumptions.get());
+      if (code == nullptr) {
+        // There were invalid assumptions in the code.
+        DCHECK_NOT_NULL(unpublished_code.assumptions);
+        continue;
+      }
+      published_code.push_back(code);
+    }
+  }
+  for (WasmCode* code : published_code) {
+    NoteRebWasmDispatchForPublishedCode(code);
+  }
+  return published_code;
+}
 
