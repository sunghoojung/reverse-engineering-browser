+// Named Wasm traps only. Anything else, including a non-trap Wasm message,
+// is not an execution outcome. reason 0 is a Wasm trap this record does not
+// name; it is not a stand-in for a signature mismatch.
+bool RebWasmTrapReason(MessageTemplate message, uint8_t* reason,
+                       uint8_t* bounds) {
+  *reason = 0;
+  *bounds = 0;
+  switch (message) {
+    case MessageTemplate::kWasmTrapFuncSigMismatch:
+      *reason = 1;
+      return true;
+    case MessageTemplate::kWasmTrapUnreachable:
+      *reason = 2;
+      return true;
+    case MessageTemplate::kWasmTrapTableOutOfBounds:
+      *reason = 3;
+      *bounds = 1;
+      return true;
+    case MessageTemplate::kWasmTrapMemOutOfBounds:
+      *reason = 3;
+      *bounds = 2;
+      return true;
+    case MessageTemplate::kWasmTrapDataSegmentOutOfBounds:
+      *reason = 3;
+      *bounds = 3;
+      return true;
+    case MessageTemplate::kWasmTrapElementSegmentOutOfBounds:
+      *reason = 3;
+      *bounds = 4;
+      return true;
+    case MessageTemplate::kWasmTrapArrayOutOfBounds:
+      *reason = 3;
+      *bounds = 5;
+      return true;
+    case MessageTemplate::kWasmTrapStringOffsetOutOfBounds:
+      *reason = 3;
+      *bounds = 6;
+      return true;
+    case MessageTemplate::kWasmTrapNullFunc:
+      *reason = 4;
+      return true;
+    case MessageTemplate::kWasmTrapRebInterrupt:
+      *reason = 5;
+      return true;
+    case MessageTemplate::kWasmTrapUnalignedAccess:
+    case MessageTemplate::kWasmTrapDivByZero:
+    case MessageTemplate::kWasmTrapDivUnrepresentable:
+    case MessageTemplate::kWasmTrapRemByZero:
+    case MessageTemplate::kWasmTrapFloatUnrepresentable:
+    case MessageTemplate::kWasmTrapMultiReturnLengthMismatch:
+    case MessageTemplate::kWasmTrapJSTypeError:
+    case MessageTemplate::kWasmTrapRethrowNull:
+    case MessageTemplate::kWasmTrapNullDereference:
+    case MessageTemplate::kWasmTrapIllegalCast:
+    case MessageTemplate::kWasmTrapArrayTooLarge:
+    case MessageTemplate::kWasmTrapStringInvalidUtf8:
+    case MessageTemplate::kWasmTrapStringInvalidWtf8:
+    case MessageTemplate::kWasmTrapResume:
+    case MessageTemplate::kWasmTrapSuspend:
+    case MessageTemplate::kWasmTrapSwitch:
+    case MessageTemplate::kWasmTrapStringIsolatedSurrogate:
+      return true;
+    default:
+      return false;
+  }
+}
+
+void ReportRebWasmTrap(Isolate* isolate, MessageTemplate message) {
+  uint8_t reason = 0;
+  uint8_t bounds = 0;
+  if (!RebWasmTrapReason(message, &reason, &bounds)) return;
+  auto callback = isolate->wasm_execution_trap_callback();
+  if (callback == nullptr) return;
+  bool function_known = false;
+  uint32_t function_index = 0;
+  bool offset_known = false;
+  uint32_t module_offset = 0;
+  const uint8_t* bytes = nullptr;
+  size_t size = 0;
+  HandleScope scope(isolate);
+  v8::Local<v8::Context> context;
+  {
+    wasm::WasmCodeRefScope code_scope;
+    for (StackFrameIterator it(isolate); !it.done(); it.Advance()) {
+      if (RebSkipExecutionFrame(it.frame()->type())) continue;
+      if (!it.frame()->is_wasm()) break;
+#ifdef V8_ENABLE_DRUMBRAKE
+      if (it.frame()->is_wasm_interpreter_entry()) break;
+#endif
+      auto* frame = WasmFrame::cast(it.frame());
+      auto* code = frame->wasm_code();
+      if (code == nullptr || !code->is_liftoff()) break;
+      const int index = code->index();
+      auto instance = frame->trusted_instance_data();
+      const auto* module = instance->module();
+      if (index < 0 ||
+          static_cast<uint32_t>(index) >= module->functions.size() ||
+          static_cast<uint32_t>(index) >= 16u * 1024u * 1024u) {
+        break;
+      }
+      function_known = true;
+      function_index = static_cast<uint32_t>(index);
+      const auto& function = module->functions[function_index];
+      auto wire = frame->native_module()->wire_bytes();
+      if (frame->pc() >= code->instruction_start()) {
+        const auto raw = frame->pc() - code->instruction_start();
+        if (raw <= static_cast<Address>(kMaxInt)) {
+          SourcePosition pos =
+              code->GetSourcePositionBefore(static_cast<int>(raw));
+          // Position 0 is the prologue stack check, not an instruction.
+          // An inlined position is not this frame's body offset.
+          if (!pos.isInlined() && pos.ScriptOffset() > 0) {
+            const auto script = static_cast<uint32_t>(pos.ScriptOffset());
+            if (script < function.code.length()) {
+              const auto sum =
+                  static_cast<uint64_t>(function.code.offset()) + script;
+              if (sum >= 8 && sum < wire.size() &&
+                  sum < 16ull * 1024ull * 1024ull) {
+                offset_known = true;
+                module_offset = static_cast<uint32_t>(sum);
+              }
+            }
+          }
+        }
+      }
+      if (!wire.empty()) {
+        bytes = wire.data();
+        size = wire.size();
+      }
+      if (instance->has_native_context()) {
+        // ToLocal needs the NativeContext returned by native_context().
+        context = Utils::ToLocal(
+            direct_handle(instance->native_context(), isolate));
+      }
+      break;
+    }
+  }
+  callback(context, bytes, size, reason, bounds, function_known, function_index,
+           offset_known, module_offset);
+}
