+namespace {
+void CompileInvalidModuleUnderJitless() {
+  // TryAllocate DCHECK(!v8_flags.jitless). A module that fails decoding still
+  // enters SyncCompile, which notifies before decode and never allocates code.
+  // Desktop wasm_jitless is readonly false, so this does not execute Wasm.
+  ErrorThrower thrower(CcTest::i_isolate(), "reb-jitless-scope");
+  const uint8_t raw[] = {0x00};
+  auto compiled = GetWasmEngine()->SyncCompile(
+      CcTest::i_isolate(), WasmEnabledFeatures::None(), {}, &thrower,
+      base::OwnedCopyOf(raw));
+  CHECK(compiled.is_null());
+  CHECK(thrower.error());
+  thrower.Reset();
+}
+}  // namespace
