+namespace {
+struct RebScopeNotices {
+  int br_jitless = 0;
+  int br_left = 0;
+  int indirect_jitless = 0;
+  int indirect_left = 0;
+};
+thread_local RebScopeNotices reb_scope_notices;
+
+void ObserveRebScope(v8::WasmDispatchScope scope, bool call_indirect) {
+  if (scope == v8::WasmDispatchScope::kJitless) {
+    if (call_indirect) {
+      ++reb_scope_notices.indirect_jitless;
+    } else {
+      ++reb_scope_notices.br_jitless;
+    }
+  } else if (scope == v8::WasmDispatchScope::kLeftLiftoff) {
+    if (call_indirect) {
+      ++reb_scope_notices.indirect_left;
+    } else {
+      ++reb_scope_notices.br_left;
+    }
+  }
+}
+}  // namespace
+
