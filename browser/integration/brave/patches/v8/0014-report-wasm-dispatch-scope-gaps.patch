+TEST(RebNativeCallIndirectLeftLiftoff) {
+  FlagScope<bool> sampling(&v8_flags.reb_wasm_call_indirect_dispatch, true);
+  TestSignatures sigs;
+  WasmRunner<int32_t, int32_t> r(TestExecutionTier::kTurbofan);
+  auto* api = reinterpret_cast<v8::Isolate*>(r.isolate());
+  api->SetWasmDispatchScopeCallback(&ObserveRebScope);
+  api->SetWasmCallIndirectDispatchCallback(&ObserveRebCallIndirect);
+  v8::Isolate::DrainRebWasmDispatchScope();
+  reb_scope_notices = {};
+  reb_indirect_observation = {};
+  WasmFunctionCompiler& add = r.NewFunction(sigs.i_ii());
+  add.Build({WASM_I32_ADD(WASM_LOCAL_GET(0), WASM_LOCAL_GET(1))});
+  add.SetSigIndex(ModuleTypeIndex{1});
+  r.builder().AddSignature(sigs.f_ff());
+  r.builder().AddSignature(sigs.i_ii());
+  uint16_t entries[] = {static_cast<uint16_t>(add.function_index())};
+  r.builder().AddIndirectFunctionTable(entries, arraysize(entries));
+  r.Build({WASM_CALL_INDIRECT(1, WASM_I32V_2(66), WASM_I32V_1(22),
+                              WASM_LOCAL_GET(0))});
+  CHECK_LT(0, reb_scope_notices.indirect_left);
+  CHECK_EQ(0, reb_scope_notices.br_left);
+  CHECK_EQ(0, reb_scope_notices.indirect_jitless);
+  CHECK_EQ(0, reb_indirect_observation.count);
+  CHECK_EQ(88, r.Call(0));
+  CHECK_EQ(0, reb_indirect_observation.count);
+  api->SetWasmCallIndirectDispatchCallback(nullptr);
+  api->SetWasmDispatchScopeCallback(nullptr);
+}
