+TEST(RebNativeBrTableJitlessUnsupported) {
+  CcTest::InitializeVM();
+  auto* api = CcTest::isolate();
+  v8::HandleScope handles(api);
+  auto context = v8::Context::New(api);
+  v8::Context::Scope context_scope(context);
+  FlagScope<bool> sampling(&v8_flags.reb_wasm_br_table_dispatch, true);
+  FlagScope<bool> indirect(&v8_flags.reb_wasm_call_indirect_dispatch, true);
+  FlagScope<bool> jitless(&v8_flags.jitless, true);
+  CHECK(v8::Isolate::IsRebWasmJitless());
+  CHECK(v8::Isolate::IsRebWasmBrTableDispatch());
+  CHECK(v8::Isolate::IsRebWasmCallIndirectDispatch());
+  api->SetWasmDispatchScopeCallback(&ObserveRebScope);
+  api->SetWasmBrTableDispatchCallback(&ObserveRebBrTable);
+  api->SetWasmCallIndirectDispatchCallback(&ObserveRebCallIndirect);
+  v8::Isolate::DrainRebWasmDispatchScope();
+  reb_scope_notices = {};
+  reb_dispatch_observation = {};
+  reb_indirect_observation = {};
+  CompileInvalidModuleUnderJitless();
+  CHECK_EQ(1, reb_scope_notices.br_jitless);
+  CHECK_EQ(1, reb_scope_notices.indirect_jitless);
+  CHECK_EQ(0, reb_scope_notices.br_left);
+  CHECK_EQ(0, reb_scope_notices.indirect_left);
+  CHECK_EQ(0, reb_dispatch_observation.count);
+  CHECK_EQ(0, reb_indirect_observation.count);
+  // Bits from a notice the embedder could not admit collapse to one delivery.
+  reb_scope_notices = {};
+  v8::Isolate::RememberRebWasmDispatchScope(v8::WasmDispatchScope::kLeftLiftoff,
+                                           false);
+  v8::Isolate::RememberRebWasmDispatchScope(v8::WasmDispatchScope::kLeftLiftoff,
+                                           false);
+  v8::Isolate::DrainRebWasmDispatchScope();
+  CHECK_EQ(1, reb_scope_notices.br_left);
+  CHECK_EQ(0, reb_scope_notices.indirect_left);
+  CHECK_EQ(0, reb_scope_notices.br_jitless);
+  v8::Isolate::DrainRebWasmDispatchScope();
+  CHECK_EQ(1, reb_scope_notices.br_left);
+  api->SetWasmBrTableDispatchCallback(nullptr);
+  api->SetWasmCallIndirectDispatchCallback(nullptr);
+  api->SetWasmDispatchScopeCallback(nullptr);
+}
