+  WasmRunner<int32_t, int32_t> r(TestExecutionTier::kTurbofan);
+  auto* api = reinterpret_cast<v8::Isolate*>(r.isolate());
+  api->SetWasmDispatchScopeCallback(&ObserveRebScope);
+  api->SetWasmBrTableDispatchCallback(&ObserveRebBrTable);
+  v8::Isolate::DrainRebWasmDispatchScope();
+  reb_scope_notices = {};
+  reb_dispatch_observation = {};
+  r.Build({B1(WASM_BR_TABLE(WASM_LOCAL_GET(0), 1, BR_TARGET(0), BR_TARGET(0))),
+           WASM_I32V_2(93)});
+  CHECK_LT(0, reb_scope_notices.br_left);
+  CHECK_EQ(0, reb_scope_notices.br_jitless);
+  CHECK_EQ(0, reb_scope_notices.indirect_left);
+  CHECK_EQ(0, reb_dispatch_observation.count);
+  CHECK_EQ(93, r.Call(0));
+  CHECK_EQ(0, reb_dispatch_observation.count);
+  api->SetWasmBrTableDispatchCallback(nullptr);
