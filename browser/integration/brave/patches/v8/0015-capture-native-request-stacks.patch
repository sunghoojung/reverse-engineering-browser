+// REB request initiator stacks (include/v8-native-stack.h). Visits the frames
+// StackFrameBuilder visits for DevTools and the await chain
+// CaptureSimpleStackTrace appends, writing identities into the embedder's
+// buffer instead of allocating StackFrameInfo objects.
+class NativeStackBuilder {
+ public:
+  NativeStackBuilder(Isolate* isolate, v8::NativeStackCapture& capture,
+                     const v8::NativeStackCallbacks& callbacks)
+      : isolate_(isolate),
+        capture_(capture),
+        callbacks_(callbacks),
+        half_(capture.sync_capacity / 2) {}
+
+  bool Visit(FrameSummary& summary) {
+    if (!summary.is_subject_to_debugging()) return true;
+    v8::NativeStackFrame frame{};
+    if (summary.IsJavaScript()) {
+      const FrameSummary::JavaScriptFrameSummary& js = summary.AsJavaScript();
+      summary.EnsureSourcePositionsAvailable();
+      Tagged<SharedFunctionInfo> shared = js.function()->shared();
+      frame.kind = v8::NativeStackFrameKind::kJavaScript;
+      frame.flags = static_cast<uint8_t>((js.is_constructor() ? 1 : 0) |
+                                         (shared->is_toplevel() ? 2 : 0));
+      frame.position = Unsigned(summary.SourcePosition());
+      frame.detail = Unsigned(shared->StartPosition());
+    } else {
+#if V8_ENABLE_WEBASSEMBLY
+      frame.kind = v8::NativeStackFrameKind::kWasm;
+      frame.position = Unsigned(summary.SourcePosition());
+      frame.detail = WasmFunctionIndex(summary);
+#else
+      return true;
+#endif  // V8_ENABLE_WEBASSEMBLY
+    }
+    Handle<Script> script = Cast<Script>(summary.script());
+    frame.script_id = Unsigned(script->id());
+    NoteScript(script, summary.native_context());
+    const uint32_t index = capture_.total_depth++;
+    capture_.frames[index < half_ ? index : half_ + (index - half_) % half_] =
+        frame;
+    return true;
+  }
+
+  bool Full() const { return capture_.async_frames >= capture_.async_capacity; }
+
+  void AppendAsyncFrame(DirectHandle<JSGeneratorObject> generator_object) {
+    DirectHandle<JSFunction> function(generator_object->function(), isolate_);
+    DirectHandle<SharedFunctionInfo> shared(function->shared(), isolate_);
+    if (!shared->IsSubjectToDebugging() || !IsScript(shared->script()) ||
+        !function->native_context()->HasSameSecurityTokenAs(
+            isolate_->raw_native_context())) {
+      return;
+    }
+    SharedFunctionInfo::EnsureSourcePositionsAvailable(isolate_, shared);
+    v8::NativeStackFrame frame{};
+    frame.kind = v8::NativeStackFrameKind::kAwait;
+    frame.flags = static_cast<uint8_t>(shared->is_toplevel() ? 2 : 0);
+    frame.position = Unsigned(shared->GetBytecodeArray(isolate_)->SourcePosition(
+        GetGeneratorBytecodeOffset(generator_object)));
+    frame.detail = Unsigned(shared->StartPosition());
+    Handle<Script> script(Cast<Script>(shared->script()), isolate_);
+    frame.script_id = Unsigned(script->id());
+    NoteScript(script, direct_handle(function->native_context(), isolate_));
+    AppendAsync(frame);
+  }
+
+  void AppendPromiseCombinatorFrame(DirectHandle<JSFunction> element_function,
+                                    DirectHandle<JSFunction> combinator) {
+    Tagged<NativeContext> context = combinator->native_context();
+    if (!context->HasSameSecurityTokenAs(isolate_->raw_native_context())) {
+      return;
+    }
+    v8::NativeStackFrame frame{};
+    frame.kind = v8::NativeStackFrameKind::kPromiseCombinator;
+    frame.combinator = *combinator == context->promise_all()           ? 1
+                       : *combinator == context->promise_all_settled() ? 2
+                       : *combinator == context->promise_any()         ? 3
+                                                                       : 0;
+    if (frame.combinator == 0) return;
+    // The promise index lives in the element function's hash field, as
+    // CallSiteBuilder::AppendPromiseCombinatorFrame reads it.
+    frame.position = Unsigned(
+        Smi::ToInt(Cast<JSReceiver>(element_function)->GetIdentityHash()) - 1);
+    AppendAsync(frame);
+  }
+
+  void Finish() {
+    const uint32_t capacity = 2 * half_;
+    if (capture_.total_depth <= capacity) {
+      capture_.recorded = capture_.total_depth;
+      return;
+    }
+    v8::NativeStackFrame* ring = capture_.frames + half_;
+    std::rotate(ring, ring + (capture_.total_depth - half_) % half_,
+                ring + half_);
+    capture_.recorded = capacity;
+    capture_.omitted = capture_.total_depth - capacity;
+  }
+
+  void DescribeScripts() {
+    for (size_t i = 0; i < script_count_; ++i) {
+      Handle<Script> script = scripts_[i];
+      v8::NativeStackScript out{};
+      out.script_id = script->id();
+      out.is_eval = script->has_eval_origin();
+      out.line_offset = script->line_offset();
+      out.column_offset = script->column_offset();
+      out.context = Utils::ToLocal(contexts_[i]);
+      out.name = Utils::ToLocal(direct_handle(script->name(), isolate_));
+#if V8_ENABLE_WEBASSEMBLY
+      if (script->type() == Script::Type::kWasm) {
+        out.is_wasm = true;
+        // Keeps the wire bytes alive for the callback.
+        auto module = script->wasm_native_module();
+        base::Vector<const uint8_t> bytes = module->wire_bytes();
+        out.wire_bytes = bytes.begin();
+        out.wire_bytes_size = bytes.size();
+        callbacks_.script(callbacks_.data, out);
+        continue;
+      }
+#endif  // V8_ENABLE_WEBASSEMBLY
+      if (IsString(script->source())) {
+        out.source = Utils::ToLocal(
+            direct_handle(Cast<String>(script->source()), isolate_));
+      }
+      callbacks_.script(callbacks_.data, out);
+    }
+  }
+
+ private:
+  static uint32_t Unsigned(int value) {
+    return value < 0 ? 0 : static_cast<uint32_t>(value);
+  }
+
+#if V8_ENABLE_WEBASSEMBLY
+  static uint32_t WasmFunctionIndex(const FrameSummary& summary) {
+    if (summary.IsWasm()) return summary.AsWasm().function_index();
+    if (summary.IsWasmInlined()) return summary.AsWasmInlined().function_index();
+#if V8_ENABLE_DRUMBRAKE
+    if (summary.IsWasmInterpreted()) {
+      return summary.AsWasmInterpreted().function_index();
+    }
+#endif  // V8_ENABLE_DRUMBRAKE
+    return 0;
+  }
+#endif  // V8_ENABLE_WEBASSEMBLY
+
+  void AppendAsync(const v8::NativeStackFrame& frame) {
+    capture_.frames[capture_.sync_capacity + capture_.async_frames++] = frame;
+  }
+
+  // Asks once per distinct script per capture; the embedder answers from its
+  // own table without calling into V8.
+  void NoteScript(Handle<Script> script, DirectHandle<NativeContext> context) {
+    const int id = script->id();
+    for (size_t i = 0; i < script_count_; ++i) {
+      if (scripts_[i]->id() == id) return;
+    }
+    if (script_count_ == scripts_.size() ||
+        !callbacks_.script_needed(callbacks_.data, id)) {
+      return;
+    }
+    scripts_[script_count_] = script;
+    contexts_[script_count_] = handle(*context, isolate_);
+    ++script_count_;
+  }
+
+  Isolate* isolate_;
+  v8::NativeStackCapture& capture_;
+  const v8::NativeStackCallbacks& callbacks_;
+  const uint32_t half_;
+  std::array<Handle<Script>, 64> scripts_;
+  std::array<Handle<NativeContext>, 64> contexts_;
+  size_t script_count_ = 0;
+};
+
+bool CaptureNativeStack(Isolate* isolate, v8::NativeStackCapture& capture,
+                        const v8::NativeStackCallbacks& callbacks) {
+  if (!v8_flags.reb_request_stacks || !capture.frames ||
+      capture.sync_capacity < 2 || capture.sync_capacity % 2 != 0 ||
+      !callbacks.script_needed || !callbacks.frames || !callbacks.script ||
+      isolate->context().is_null()) {
+    return false;
+  }
+  HandleScope scope(isolate);
+#if V8_ENABLE_WEBASSEMBLY
+  wasm::WasmCodeRefScope code_ref_scope;
+#endif  // V8_ENABLE_WEBASSEMBLY
+  capture.total_depth = capture.recorded = capture.omitted = 0;
+  capture.async_frames = 0;
+  capture.async_truncated = false;
+  NativeStackBuilder builder(isolate, capture, callbacks);
+  VisitStack(isolate, &builder);
+  builder.Finish();
+  if (v8_flags.async_stack_traces && capture.recorded > 0) {
+    DirectHandle<JSPromise> promise;
+    if (TryGetCurrentTaskPromise(isolate).ToHandle(&promise)) {
+      CaptureAsyncStackTrace(isolate, promise, &builder);
+    }
+    capture.async_truncated = builder.Full();
+  }
+  callbacks.frames(callbacks.data, capture);
+  builder.DescribeScripts();
+  return true;
+}
+
 }  // namespace
 
 MaybeDirectHandle<JSObject> Isolate::CaptureAndSetErrorStack(
@@ -8739,4 +8948,16 @@ void Isolate::PrintNumberStringCacheStats(const char* comment,
 }
 
 }  // namespace internal
+
+bool IsNativeStackCaptureEnabled() {
+  return internal::v8_flags.reb_request_stacks;
+}
+
+bool CaptureNativeStack(Isolate* isolate, NativeStackCapture& capture,
+                        const NativeStackCallbacks& callbacks) {
+  return isolate && internal::CaptureNativeStack(
+                        reinterpret_cast<internal::Isolate*>(isolate), capture,
+                        callbacks);
+}
+
 }  // namespace v8
