+// License, v. 2.0. If a copy of the MPL was not distributed with this file,
+// You can obtain one at https://mozilla.org/MPL/2.0/.
+
+#ifndef INCLUDE_V8_NATIVE_STACK_H_
+#define INCLUDE_V8_NATIVE_STACK_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include "v8-context.h"
+#include "v8-local-handle.h"
+#include "v8-primitive.h"
+#include "v8config.h"
+
+namespace v8 {
+
+class Isolate;
+
+// REB request initiator stacks. Inactive unless V8 runs with
+// --reb-request-stacks (off by default). Frames are identities only: no
+// strings or values are read from the stack.
+enum class NativeStackFrameKind : uint8_t {
+  kJavaScript = 1,
+  kWasm = 2,
+  kAwait = 3,
+  kPromiseCombinator = 4,
+};
+
+struct NativeStackFrame {
+  NativeStackFrameKind kind;
+  uint8_t flags;  // 1: constructor call, 2: top-level script code.
+  uint16_t combinator;  // 1 Promise.all, 2 allSettled, 3 any; else 0.
+  uint32_t script_id;   // 0 only for a promise combinator.
+  // UTF-16 source position, Wasm module byte offset, or promise index.
+  uint32_t position;
+  // Function start position, Wasm function index, or 0.
+  uint32_t detail;
+};
+
+struct NativeStackCapture {
+  // sync_capacity synchronous frames, then async_capacity async frames.
+  // sync_capacity must be even: a deeper stack keeps the innermost and the
+  // outermost half, in order, in frames[0, sync_capacity).
+  NativeStackFrame* frames = nullptr;
+  uint32_t sync_capacity = 0;
+  uint32_t async_capacity = 0;
+  // Outputs. Synchronous frames are innermost first in frames[0, recorded);
+  // async frames are in chain order at frames[sync_capacity, +async_frames).
+  uint32_t total_depth = 0;
+  uint32_t recorded = 0;
+  uint32_t omitted = 0;
+  uint32_t async_frames = 0;
+  bool async_truncated = false;
+};
+
+// One script a recorded frame names, described at most once per capture.
+struct NativeStackScript {
+  int script_id;
+  bool is_wasm;
+  bool is_eval;
+  int line_offset;
+  int column_offset;
+  Local<Context> context;  // The realm of the frame that named it.
+  Local<Value> name;       // Script name or URL; may be undefined.
+  Local<String> source;    // JavaScript only; may be empty.
+  const uint8_t* wire_bytes;  // Wasm only, borrowed for the call.
+  size_t wire_bytes_size;
+};
+
+// All three run synchronously on the isolate thread with JavaScript execution
+// disallowed and must not call back into JavaScript.
+struct NativeStackCallbacks {
+  void* data = nullptr;
+  // Whether the embedder still needs a description of script_id. Must not
+  // call into V8 or allocate.
+  bool (*script_needed)(void* data, int script_id) = nullptr;
+  // The completed capture, before any script description.
+  void (*frames)(void* data, const NativeStackCapture& capture) = nullptr;
+  void (*script)(void* data, const NativeStackScript& script) = nullptr;
+};
+
+V8_EXPORT bool IsNativeStackCaptureEnabled();
+
+// Walks the current stack as DevTools' detailed stack trace sees it (frames
+// subject to debugging in the current security origin, Wasm included), then
+// the await chain Error.stack would append. Returns false without walking when
+// the flag is off, the arguments are invalid or no context is entered.
+V8_EXPORT bool CaptureNativeStack(Isolate* isolate,
+                                  NativeStackCapture& capture,
+                                  const NativeStackCallbacks& callbacks);
+
+}  // namespace v8
+
+#endif  // INCLUDE_V8_NATIVE_STACK_H_
