 // static
+// static
+void Compiler::ObserveCompiledScript(Isolate* isolate,
+                                     DirectHandle<SharedFunctionInfo> shared,
+                                     Tagged<Context> realm,
+                                     v8::CompiledScriptKind kind) {
+  const v8::CompiledScriptCallback callback =
+      isolate->compiled_script_callback();
+  const v8::CompiledScriptEnabledCallback enabled =
+      isolate->compiled_script_enabled_callback();
+  if (callback == nullptr || enabled == nullptr || !enabled() ||
+      realm.is_null() || !IsScript(shared->script())) {
+    return;
+  }
+  HandleScope scope(isolate);
+  DirectHandle<Script> script(Cast<Script>(shared->script()), isolate);
+  if (script->type() != Script::Type::kNormal || !IsString(script->source())) {
+    return;
+  }
+  v8::CompiledScript compiled;
+  compiled.kind = kind;
+  compiled.script_id = script->id();
+  compiled.line_offset = script->line_offset();
+  compiled.column_offset = script->column_offset();
+  compiled.context =
+      Utils::ToLocal(direct_handle(realm->native_context(), isolate));
+  compiled.source =
+      Utils::ToLocal(direct_handle(Cast<String>(script->source()), isolate));
+  if (IsString(script->name())) {
+    compiled.name =
+        Utils::ToLocal(direct_handle(Cast<String>(script->name()), isolate));
+  }
+  if ((kind == v8::CompiledScriptKind::kEval ||
+       kind == v8::CompiledScriptKind::kFunctionConstructor) &&
+      script->has_eval_from_shared()) {
+    // With no JavaScript on the stack, eval_from_shared is the empty function
+    // of the native context, whose script is not a normal one.
+    Tagged<Object> creator = script->eval_from_shared()->script();
+    if (IsScript(creator) &&
+        Cast<Script>(creator)->type() == Script::Type::kNormal) {
+      compiled.creator_script_id = Cast<Script>(creator)->id();
+      compiled.creator_position = Script::GetEvalPosition(isolate, script);
+    }
+  }
+  callback(compiled);
+}
