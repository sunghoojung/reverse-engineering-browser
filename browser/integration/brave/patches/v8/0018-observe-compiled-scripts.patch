+TEST(RebNativeCompiledScriptCodeCacheConsumer) {
+  LocalContext env;
+  v8::Isolate* isolate = env.isolate();
+  v8::HandleScope scope(isolate);
+  const char* text = "function rebCached() { return 6; } rebCached();";
+  v8::ScriptOrigin origin(v8_str("cached.js"));
+  v8::ScriptCompiler::CachedData* cache;
+  {
+    v8::ScriptCompiler::Source source(v8_str(text), origin);
+    Local<v8::Script> script =
+        v8::ScriptCompiler::Compile(env.local(), &source).ToLocalChecked();
+    cache = v8::ScriptCompiler::CreateCodeCache(script->GetUnboundScript());
+  }
+  RebCompiledScriptScope capture(isolate);
+  v8::ScriptCompiler::Source source(v8_str(text), origin, cache);
+  CHECK(!v8::ScriptCompiler::Compile(env.local(), &source,
+                                     v8::ScriptCompiler::kConsumeCodeCache)
+             .IsEmpty());
+  CHECK_EQ(1u, reb_compiled_scripts.size());
+  CHECK_EQ(std::string(text), reb_compiled_scripts[0].source);
+}
