+// How a script reached the compiler.
+enum class CompiledScriptKind : uint8_t {
+  kScript = 1,
+  kModule = 2,
+  // ScriptCompiler::CompileFunction, such as an inline event handler.
+  kFunction = 3,
+  kEval = 4,
+  // Function and its generator and async variants.
+  kFunctionConstructor = 5,
+};
+
+// One compile that succeeded. Handles are borrowed and valid only during the
+// callback, which must not run JavaScript. This never enables Inspector.
+struct CompiledScript {
+  CompiledScriptKind kind = CompiledScriptKind::kScript;
+  int script_id = 0;
+  int line_offset = 0;
+  int column_offset = 0;
+  // The realm the script compiled for.
+  Local<Context> context;
+  Local<String> source;
+  // Empty when the embedder gave the script no name.
+  Local<String> name;
+  // kEval and kFunctionConstructor only. The script running the call, or zero
+  // when no JavaScript was running, and the UTF-16 offset of the call in it.
+  int creator_script_id = 0;
+  int creator_position = 0;
+};
+
+using CompiledScriptEnabledCallback = bool (*)();
+using CompiledScriptCallback = void (*)(const CompiledScript& script);
+
 enum class RuntimeBufferKind {
   kArrayBuffer,
   kUint8Array,
