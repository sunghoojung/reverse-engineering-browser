+namespace {
+
+struct RebCompiledScriptRecord {
+  v8::CompiledScriptKind kind;
+  int script_id;
+  int line_offset;
+  int column_offset;
+  std::string source;
+  std::string name;
+  int creator_script_id;
+  int creator_position;
+};
+
+std::vector<RebCompiledScriptRecord> reb_compiled_scripts;
+bool reb_compiled_scripts_enabled = false;
+
+std::string RebUtf8(v8::Isolate* isolate, v8::Local<v8::String> value) {
+  if (value.IsEmpty()) return {};
+  v8::String::Utf8Value utf8(isolate, value);
+  return std::string(*utf8, utf8.length());
+}
+
+void RebRecordCompiledScript(const v8::CompiledScript& script) {
+  v8::Isolate* isolate = v8::Isolate::GetCurrent();
+  reb_compiled_scripts.push_back(
+      {script.kind, script.script_id, script.line_offset, script.column_offset,
+       RebUtf8(isolate, script.source), RebUtf8(isolate, script.name),
+       script.creator_script_id, script.creator_position});
+}
+
+class RebCompiledScriptScope {
+ public:
+  explicit RebCompiledScriptScope(v8::Isolate* isolate, bool enabled = true)
+      : isolate_(isolate) {
+    reb_compiled_scripts.clear();
+    reb_compiled_scripts_enabled = enabled;
+    isolate_->SetCompiledScriptCallback(
+        RebRecordCompiledScript, [] { return reb_compiled_scripts_enabled; });
+  }
+  ~RebCompiledScriptScope() {
+    isolate_->SetCompiledScriptCallback(nullptr, nullptr);
+  }
+
+ private:
+  v8::Isolate* isolate_;
+};
+
+const RebCompiledScriptRecord& RebCompiledScriptWithSource(
+    const std::string& source) {
+  for (const RebCompiledScriptRecord& record : reb_compiled_scripts) {
+    if (record.source == source) return record;
+  }
+  FATAL("No compiled script record has source: %s", source.c_str());
+}
+
+}  // namespace
+
+TEST(RebNativeCompiledScriptEvalNeedsNoCodeGenerationPolicy) {
+  LocalContext env;
+  v8::Isolate* isolate = env.isolate();
+  v8::HandleScope scope(isolate);
+  RebCompiledScriptScope capture(isolate);
+  CHECK(env.local()->IsCodeGenerationFromStringsAllowed());
+  const std::string outer = "eval('1 + 1'); (0, eval)('2 + 2');";
+  CHECK_EQ(4, CompileRun(outer.c_str())->Int32Value(env.local()).FromJust());
+  const RebCompiledScriptRecord& top = RebCompiledScriptWithSource(outer);
+  CHECK_EQ(v8::CompiledScriptKind::kScript, top.kind);
+  CHECK_EQ(0, top.creator_script_id);
+
+  const RebCompiledScriptRecord& direct = RebCompiledScriptWithSource("1 + 1");
+  CHECK_EQ(v8::CompiledScriptKind::kEval, direct.kind);
+  CHECK_EQ(top.script_id, direct.creator_script_id);
+  CHECK_EQ(static_cast<int>(outer.find("eval")), direct.creator_position);
+
+  // V8 stores the indirect caller as a bytecode offset; it must be translated.
+  const RebCompiledScriptRecord& indirect =
+      RebCompiledScriptWithSource("2 + 2");
+  CHECK_EQ(v8::CompiledScriptKind::kEval, indirect.kind);
+  CHECK_EQ(top.script_id, indirect.creator_script_id);
+  CHECK_GE(indirect.creator_position,
+           static_cast<int>(outer.find("(0, eval)")));
+  CHECK_LT(indirect.creator_position, static_cast<int>(outer.size()));
+}
+
+TEST(RebNativeCompiledScriptFunctionConstructor) {
+  LocalContext env;
+  v8::Isolate* isolate = env.isolate();
+  v8::HandleScope scope(isolate);
+  RebCompiledScriptScope capture(isolate);
+  const std::string outer = "new Function('a', 'return a + 1')(2);";
+  CHECK_EQ(3, CompileRun(outer.c_str())->Int32Value(env.local()).FromJust());
+  const RebCompiledScriptRecord& top = RebCompiledScriptWithSource(outer);
+  // The record's source is what V8 compiled, the synthesized wrapper.
+  const RebCompiledScriptRecord& constructed = RebCompiledScriptWithSource(
+      "(function anonymous(a\n) {\nreturn a + 1\n})");
+  CHECK_EQ(v8::CompiledScriptKind::kFunctionConstructor, constructed.kind);
+  CHECK_EQ(top.script_id, constructed.creator_script_id);
+  CHECK_GE(constructed.creator_position, 0);
+  CHECK_LT(constructed.creator_position, static_cast<int>(outer.size()));
+}
+
+TEST(RebNativeCompiledScriptNestedEvalChains) {
+  LocalContext env;
+  v8::Isolate* isolate = env.isolate();
+  v8::HandleScope scope(isolate);
+  RebCompiledScriptScope capture(isolate);
+  const std::string middle = "eval('3 + 3');";
+  const std::string outer = "eval(\"" + middle + "\");";
+  CHECK_EQ(6, CompileRun(outer.c_str())->Int32Value(env.local()).FromJust());
+  const RebCompiledScriptRecord& top = RebCompiledScriptWithSource(outer);
+  const RebCompiledScriptRecord& first = RebCompiledScriptWithSource(middle);
+  const RebCompiledScriptRecord& inner = RebCompiledScriptWithSource("3 + 3");
+  CHECK_EQ(top.script_id, first.creator_script_id);
+  CHECK_EQ(first.script_id, inner.creator_script_id);
+  CHECK_EQ(static_cast<int>(middle.find("eval")), inner.creator_position);
+}
+
+TEST(RebNativeCompiledScriptEvalCacheHitKeepsScriptId) {
+  LocalContext env;
+  v8::Isolate* isolate = env.isolate();
+  v8::HandleScope scope(isolate);
+  RebCompiledScriptScope capture(isolate);
+  CompileRun("for (var i = 0; i < 5; i++) eval('4 + 4');");
+  std::vector<int> script_ids;
+  for (const RebCompiledScriptRecord& record : reb_compiled_scripts) {
+    if (record.source == "4 + 4") script_ids.push_back(record.script_id);
+  }
+  CHECK_EQ(5u, script_ids.size());
+  CHECK_EQ(script_ids[3], script_ids[4]);
+}
