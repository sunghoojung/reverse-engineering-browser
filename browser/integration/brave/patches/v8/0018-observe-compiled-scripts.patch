+TEST(RebNativeCompiledScriptStreaming) {
+  LocalContext env;
+  v8::Isolate* isolate = env.isolate();
+  v8::HandleScope scope(isolate);
+  RebCompiledScriptScope capture(isolate);
+  // The helper expects 13 as the script's value and, for a module, in Result.
+  const char* chunks[] = {"globalThis.Result = 13; ", "13;", nullptr};
+  RunStreamingTest(chunks, v8::ScriptType::kClassic);
+  const RebCompiledScriptRecord& classic =
+      RebCompiledScriptWithSource("globalThis.Result = 13; 13;");
+  CHECK_EQ(v8::CompiledScriptKind::kScript, classic.kind);
+  reb_compiled_scripts.clear();
+  RunStreamingTest(chunks, v8::ScriptType::kModule);
+  const RebCompiledScriptRecord& module =
+      RebCompiledScriptWithSource("globalThis.Result = 13; 13;");
+  CHECK_EQ(v8::CompiledScriptKind::kModule, module.kind);
+}
+
+TEST(RebNativeCompiledScriptDisabledRunsNothing) {
+  LocalContext env;
+  v8::Isolate* isolate = env.isolate();
+  v8::HandleScope scope(isolate);
+  {
+    RebCompiledScriptScope capture(isolate, false);
+    CompileRun("eval('7 + 7'); new Function('return 1')();");
+    CHECK(reb_compiled_scripts.empty());
+  }
+  reb_compiled_scripts.clear();
+  CompileRun("eval('8 + 8');");
+  CHECK(reb_compiled_scripts.empty());
