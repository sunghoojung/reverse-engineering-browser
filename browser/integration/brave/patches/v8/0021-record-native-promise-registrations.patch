+// REB promise registrations. Inactive unless V8 runs with --reb-promise-stacks
+// (off by default). V8 tags each user .then, .catch, .finally and await with
+// the async task ID DevTools' async stacks use and reports it here as well as
+// to the inspector's delegate, which keeps its own slot. The debugger is never
+// activated. Every callback runs on the isolate thread and must not call into
+// JavaScript.
+enum class NativePromiseRegistration : uint8_t {
+  kThen = 1,
+  kCatch = 2,
+  kFinally = 3,
+  kAwait = 4,
+};
+
+struct NativePromiseCallbacks {
+  // Whether registrations are recorded now. Must not call into V8 or
+  // allocate; false skips the frame scan and the task ID.
+  bool (*active)() = nullptr;
+  // A registration: its stack is the current one, so CaptureNativeStack may
+  // be called. The ID is V8's 26-bit async task ID, which wraps.
+  void (*registered)(uint32_t task_id, NativePromiseRegistration kind) = nullptr;
+  // The reaction for an ID V8 assigned starts and finishes.
+  void (*will_handle)(uint32_t task_id) = nullptr;
+  void (*did_handle)(uint32_t task_id) = nullptr;
+};
+
+V8_EXPORT bool IsNativePromiseStackCaptureEnabled();
+
+// Installs callbacks that outlive the isolate. Does nothing when the flag is
+// off or a callback is missing. Isolate thread only.
+V8_EXPORT void SetNativePromiseCallbacks(Isolate* isolate,
+                                         const NativePromiseCallbacks* callbacks);
+
 }  // namespace v8
 
 #endif  // INCLUDE_V8_NATIVE_STACK_H_
