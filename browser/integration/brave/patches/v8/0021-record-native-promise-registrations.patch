+  return internal::v8_flags.reb_promise_stacks;
+}
+
+void SetNativePromiseCallbacks(Isolate* isolate,
+                               const NativePromiseCallbacks* callbacks) {
+  if (!isolate || !internal::v8_flags.reb_promise_stacks || !callbacks ||
+      !callbacks->active || !callbacks->registered ||
+      !callbacks->will_handle || !callbacks->did_handle) {
+    return;
+  }
+  reinterpret_cast<internal::Isolate*>(isolate)->set_reb_promise_callbacks(
+      callbacks);
+}
