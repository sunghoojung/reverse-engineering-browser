@@ -123,7 +123,16 @@ TF_BUILTIN(TypedArrayConstructor, TypedArrayBuiltinsAssembler) {
   TNode<JSAny> result =
       CallBuiltin<JSAny>(Builtin::kCreateTypedArray, context, target,
                          new_target, arg1, arg2, arg3);
+  // Isolate::runtime_buffer_gate_open: while the embedder's capture is
+  // inactive a construction costs two loads, not a runtime call.
+  Label capture(this, Label::kDeferred), done(this);
+  const TNode<RawPtrT> gate = Load<RawPtrT>(
+      ExternalConstant(ExternalReference::address_of_runtime_buffer_gate()));
+  Branch(Word32Equal(Load<Uint8T>(gate), Int32Constant(0)), &done, &capture);
+  BIND(&capture);
   CallRuntime(Runtime::kRebCaptureRuntimeBuffer, context, result);
+  Goto(&done);
+  BIND(&done);
   args.PopAndReturn(result);
 
   BIND(&throwtypeerror);
