+#ifndef INCLUDE_V8_NATIVE_RUNTIME_BUFFER_H_
+#define INCLUDE_V8_NATIVE_RUNTIME_BUFFER_H_
+
+#include <stdint.h>
+
+#include <atomic>
+
+#include "v8config.h"
+
+namespace v8 {
+
+// REB runtime buffer capture: the gate in front of
+// Isolate::SetRuntimeBufferCallback. Process-wide, for every isolate. While
+// the byte `gate` points to is 0, a supported construction loads it and makes
+// no runtime call or callback. Null, the default, calls on every
+// construction. The byte must outlive V8.
+V8_EXPORT void SetRuntimeBufferCallbackGate(const std::atomic<uint8_t>* gate);
+
+}  // namespace v8
+
+#endif  // INCLUDE_V8_NATIVE_RUNTIME_BUFFER_H_
