+  // Process-wide, so TypedArrayConstructor reads it with two loads and no
+  // isolate. A supported construction calls runtime_buffer_callback only
+  // while the byte it points to is nonzero. Until an embedder installs its
+  // own, it points to a constant 1.
+  static void set_runtime_buffer_gate(const std::atomic<uint8_t>* gate) {
+    runtime_buffer_gate_.store(gate ? gate : &kRuntimeBufferGateOpen,
+                               std::memory_order_relaxed);
+  }
+  static bool runtime_buffer_gate_open() {
+    return runtime_buffer_gate_.load(std::memory_order_relaxed)
+               ->load(std::memory_order_relaxed) != 0;
+  }
+  static Address runtime_buffer_gate_address() {
+    return reinterpret_cast<Address>(&runtime_buffer_gate_);
+  }
+
   Address javascript_execution_assert_address() {
     return reinterpret_cast<Address>(&javascript_execution_assert_);
   }
