 void ReportRebWasmTrap(Isolate* isolate, MessageTemplate message) {
+  // Only Liftoff code compiled under these flags enters a host call for the
+  // embedder to close, so without them a trap walks no stack.
+  if (!v8_flags.reb_wasm_br_table_dispatch &&
+      !v8_flags.reb_wasm_call_indirect_dispatch) {
+    return;
+  }
   uint8_t reason = 0;
   uint8_t bounds = 0;
   if (!RebWasmTrapReason(message, &reason, &bounds)) return;
