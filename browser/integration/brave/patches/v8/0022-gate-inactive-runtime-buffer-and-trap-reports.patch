   const v8::NativePromiseCallbacks* reb_promise_callbacks_ = nullptr;
+  static const std::atomic<uint8_t> kRuntimeBufferGateOpen;
+  // Builtins load it as a raw pointer.
+  static std::atomic<const std::atomic<uint8_t>*> runtime_buffer_gate_;
+  static_assert(sizeof(runtime_buffer_gate_) == sizeof(Address) &&
+                std::atomic<const std::atomic<uint8_t>*>::is_always_lock_free);
