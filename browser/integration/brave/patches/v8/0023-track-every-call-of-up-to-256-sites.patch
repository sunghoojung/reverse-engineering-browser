+// An armed function stays linkable however many functions were armed after
+// it, and an activation keeps its parent on later dispatches however many
+// activations came before it.
+TEST(RebNativeJsDispatchParentsAcrossManyFunctionsAndActivations) {
+  LocalContext env;
+  v8::Isolate* isolate = env.isolate();
+  v8::HandleScope scope(isolate);
+  RebJsDispatchScope capture(isolate);
+  constexpr size_t kOthers = 40;
+  constexpr int kCalls = 300;
+  std::string source =
+      "function rebManyInner(code) { var r = 0; for (var i = 0; i < "
+      "code.length; i++) { switch (code[i]) { default: r++; } } return r; }"
+      "var rebManyOps = [function (s) { return s + rebManyInner([0, 0]); }];"
+      "function rebManyOuter(code) { var s = 0; for (var pc = 0; "
+      "pc < code.length; pc++) { s = rebManyOps[code[pc]](s); } return s; }";
+  for (size_t n = 0; n < kOthers; ++n) {
+    source += "function rebManyOther" + std::to_string(n) +
+              "(x) { switch (x) { default: return 1; } }";
+  }
+  std::vector<v8::JsDispatchSite> sites{
+      RebJsSite(source, RebAnchor(source, "rebManyOps[code[pc]]", 10),
+                v8::JsDispatchShape::kIndexedCall),
+      RebJsSite(source, RebAnchor(source, "switch (code[i])"),
+                v8::JsDispatchShape::kSwitch)};
+  for (size_t n = 0; n < kOthers; ++n) {
+    const std::string head =
+        "function rebManyOther" + std::to_string(n) + "(x) { ";
+    sites.push_back(RebJsSite(source, RebAnchor(source, head, head.size()),
+                              v8::JsDispatchShape::kSwitch));
+  }
+  capture.Arm(1, sites);
+  CompileRun(source.c_str());
+  // The outer function's bytecode is made first, then every other armed
+  // function's.
+  CHECK_EQ(0,
+           CompileRun("rebManyOuter([])")->Int32Value(env.local()).FromJust());
+  for (size_t n = 0; n < kOthers; ++n) {
+    const std::string call = "rebManyOther" + std::to_string(n) + "(0)";
+    CHECK_EQ(1, CompileRun(call.c_str())->Int32Value(env.local()).FromJust());
+  }
+  CHECK_EQ(2 * kCalls,
+           CompileRun("rebManyOuter(new Array(300).fill(0))")
+               ->Int32Value(env.local())
+               .FromJust());
+  const auto& records = capture.embedder().observations;
+  CHECK_EQ(kOthers + 3 * kCalls, records.size());
+  const v8::JsDispatchObservation& outer = records[kOthers].observation;
+  CHECK_EQ(0u, outer.slot);
+  CHECK(outer.new_activation);
+  size_t inner = 0;
+  for (size_t i = kOthers; i < records.size(); ++i) {
+    const v8::JsDispatchObservation& record = records[i].observation;
+    if (record.slot == 0) {
+      CHECK_EQ(outer.activation_id, record.activation_id);
+      continue;
+    }
+    CHECK_EQ(1u, record.slot);
+    CHECK_EQ(inner % 2 == 0, record.new_activation);
+    CHECK_EQ(outer.activation_id, record.parent_activation_id);
+    CHECK(!record.parent_unknown);
+    ++inner;
+  }
+  CHECK_EQ(static_cast<size_t>(2 * kCalls), inner);
+}
