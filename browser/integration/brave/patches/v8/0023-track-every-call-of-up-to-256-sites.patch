+    const auto entry = functions_.find(Key(script_id, function));
+    return entry == functions_.end() ? nullptr : &entry->second;
+  }
+  void Record(Isolate* isolate, int script_id, int function, Value value) {
+    functions_.insert_or_assign(Key(script_id, function), std::move(value));
