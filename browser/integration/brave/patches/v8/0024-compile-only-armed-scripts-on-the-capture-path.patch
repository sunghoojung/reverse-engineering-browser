+  uint8_t digest[kSizeOfSha256Digest];
+  if (!RebSourceDigest(*flat, digest)) return false;
+  return (dispatch_length && dispatch.NamesDigest(length, digest)) ||
+         (invocation_length && invocation.NamesDigest(length, digest));
