+bool RebArmsSource(Isolate* isolate, DirectHandle<String> source) {
+  if (V8_LIKELY(!v8_flags.reb_js_dispatch_capture)) return false;
+  RebJsDispatch& dispatch = isolate->reb_js_dispatch();
+  RebJsInvocation& invocation = isolate->reb_js_invocation();
