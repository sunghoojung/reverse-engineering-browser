+// A revision of the same configuration disarms, arms and re-arms sites while
+// a call started under the first revision is still in flight. That call keeps
+// its ID, stays current in its continuation and settles; a slot keeps its
+// site, and a function compiled before its revision armed it is reported.
+TEST(RebNativeJsInvocationRevisionKeepsCallsInFlight) {
+  LocalContext env;
+  v8::Isolate* isolate = env.isolate();
+  v8::HandleScope scope(isolate);
+  RebJsInvocationScope capture(env);
+  const std::string source =
+      "async function rebAsync(n, gate) { observe(n); await gate; observe(n); "
+      "return n; }"
+      "function rebLater(n) { observe(n); return n; }"
+      "function rebEarly() { return 0; }"
+      "var rebOpen = [], rebGate = new Promise(r => rebOpen.push(r));";
+  const v8::JsInvocationSite async_site =
+      RebInvocationSite(source, RebAnchor(source, "rebAsync(", 8));
+  const v8::JsInvocationSite later_site =
+      RebInvocationSite(source, RebAnchor(source, "rebLater(", 8));
+  const v8::JsInvocationSite early_site =
+      RebInvocationSite(source, RebAnchor(source, "rebEarly(", 8));
+  v8::JsInvocationSite disarmed = async_site;
+  disarmed.source_length = 0;
+  capture.Arm(5, {async_site});
+  CompileRun(source.c_str());
+  CompileRun("rebAsync(1, rebGate); rebEarly();");
+  isolate->PerformMicrotaskCheckpoint();
+  auto& embedder = capture.embedder();
+  CHECK_EQ(1u, embedder.starts.size());
+  const uint32_t first = embedder.starts[0].invocation_id;
+
+  // Revision 1: slot 0 disarmed, rebLater (not compiled yet) and rebEarly
+  // (already compiled) appended.
+  embedder.sites = {disarmed, later_site, early_site};
+  embedder.revision = 1;
+  CompileRun("rebLater(2); rebAsync(3, null);");
+  isolate->PerformMicrotaskCheckpoint();
+  CHECK_EQ(2u, embedder.starts.size());
+  CHECK_EQ(1u, embedder.starts[1].slot);
+  CHECK_GT(embedder.starts[1].invocation_id, first);
+  CHECK_EQ(1u, embedder.statuses.size());
+  CHECK_EQ(2u, embedder.statuses[0].first);
+  CHECK(embedder.statuses[0].second ==
+        v8::JsInvocationSiteStatus::kCompiledBeforeArming);
+
+  // The first call resumes inside its own invocation and settles.
+  CompileRun("rebOpen[0]();");
+  isolate->PerformMicrotaskCheckpoint();
+  bool settled_first = false;
+  for (const auto& settle : embedder.settles) {
+    if (settle.invocation_id != first) continue;
+    CHECK(!settled_first);
+    settled_first = true;
+    CHECK_EQ(0u, settle.slot);
+    CHECK(settle.via == v8::JsInvocationSettleVia::kPromise);
+  }
+  CHECK(settled_first);
+  int inside_first = 0;
+  for (const auto& [tag, context] : embedder.observed) {
+    if (tag == 1) {
+      CHECK(context.state == v8::JsInvocationContextState::kInside);
+      CHECK_EQ(first, context.invocation_id);
+      ++inside_first;
+    } else if (tag == 3) {
+      // Armed bytecode of a disarmed slot records nothing.
+      CHECK(context.state == v8::JsInvocationContextState::kNone);
+    }
+  }
+  CHECK_EQ(2, inside_first);
+
+  // Revision 2 re-arms slot 0: its armed bytecode records again unrecompiled.
+  embedder.sites = {async_site, later_site, early_site};
+  embedder.revision = 2;
+  CompileRun("rebAsync(4, null);");
+  isolate->PerformMicrotaskCheckpoint();
+  CHECK_EQ(3u, embedder.starts.size());
+  CHECK_EQ(0u, embedder.starts[2].slot);
+  CHECK_EQ(1u, embedder.statuses.size());
+}
