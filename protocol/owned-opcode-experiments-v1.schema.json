{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reb.local/protocol/owned-opcode-experiments-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "scope",
    "records"
  ],
  "properties": {
    "schema": {
      "const": "reb-owned-opcode-experiments-v1"
    },
    "scope": {
      "const": "Only the listed owned fixture, opcode, and explicit inputs are tested; results do not generalize."
    },
    "records": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "left",
        "right"
      ],
      "properties": {
        "left": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "maxLength": 20
        },
        "right": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "maxLength": 20
        }
      }
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "value",
        "next_pc",
        "branch_taken"
      ],
      "properties": {
        "operation": {
          "enum": [
            "constant",
            "add_modulo_2_64",
            "load",
            "store",
            "branch_zero",
            "branch_nonzero",
            "jump",
            "halt",
            "unknown"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "maxLength": 20
        },
        "next_pc": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "maxLength": 20
        },
        "branch_taken": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_id",
        "fixture",
        "workspace_digest",
        "source_artifact_sha256",
        "interpreter_artifact_id",
        "finding_id",
        "opcode",
        "effect_id",
        "inputs",
        "expected"
      ],
      "properties": {
        "command_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_:-]{1,128}$"
        },
        "fixture": {
          "enum": [
            "register",
            "stack"
          ]
        },
        "workspace_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_artifact_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "interpreter_artifact_id": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "maxLength": 20
        },
        "finding_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_:-]{1,128}$"
        },
        "opcode": {
          "enum": [
            2,
            7
          ]
        },
        "effect_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_:-]{1,128}$"
        },
        "inputs": {
          "$ref": "#/$defs/inputs"
        },
        "expected": {
          "$ref": "#/$defs/expectation"
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend_instance_id",
        "session_id",
        "run_id",
        "run_generation",
        "invocation_id",
        "record_sequence",
        "build_id",
        "program_sha256",
        "opcode",
        "handler_index",
        "pc_before",
        "instruction_pointer_units",
        "inputs",
        "effect"
      ],
      "properties": {
        "backend_instance_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_:-]{1,128}$"
        },
        "session_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_:-]{1,128}$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_:-]{1,128}$"
        },
        "run_generation": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "maxLength": 20
        },
        "invocation_id": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "maxLength": 20
        },
        "record_sequence": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "maxLength": 20
        },
        "build_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "program_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "opcode": {
          "enum": [
            2,
            7
          ]
        },
        "handler_index": {
          "enum": [
            2,
            7
          ]
        },
        "pc_before": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "maxLength": 20
        },
        "instruction_pointer_units": {
          "const": "instruction-index"
        },
        "inputs": {
          "$ref": "#/$defs/inputs"
        },
        "effect": {
          "$ref": "#/$defs/expectation"
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "effect_digest",
        "fixture_revision",
        "status",
        "independent",
        "observed",
        "reason"
      ],
      "properties": {
        "request": {
          "$ref": "#/$defs/request"
        },
        "effect_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "fixture_revision": {
          "const": 1
        },
        "status": {
          "enum": [
            "pending",
            "confirmed",
            "mismatch",
            "unsupported",
            "unknown"
          ]
        },
        "independent": {
          "anyOf": [
            {
              "$ref": "#/$defs/expectation"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed": {
          "anyOf": [
            {
              "$ref": "#/$defs/observation"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "enum": [
            "execution-not-yet-complete",
            "completion-unverified",
            "fixed-owned-inputs-only",
            "agreement-for-listed-inputs-only",
            "expected-or-observed-effect-differs",
            "native-execution-or-disposal-unconfirmed"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "confirmed",
                  "mismatch"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "observed": {
                "$ref": "#/$defs/observation"
              },
              "independent": {
                "$ref": "#/$defs/expectation"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "unsupported"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "observed": {
                "type": "null"
              },
              "independent": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "pending",
                  "unknown"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "observed": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
