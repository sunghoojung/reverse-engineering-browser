{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://origin-trace.local/protocol/vm-analysis-v1.schema.json",
  "title": "Origin Trace VM Analysis Document v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "document_kind", "producer", "profile", "profile_digest", "inputs", "input_coverage", "results", "mixed_findings", "summary", "document_digest"],
  "properties": {
    "contract_version": {"const": 1},
    "document_kind": {"const": "vm-analysis"},
    "capture_mode": {"enum": ["native-stealth", "cdp-attached", "unknown"]},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"const": "origin-trace-vm-detector"},
        "version": {"type": "string", "minLength": 1, "maxLength": 32}
      }
    },
    "profile": {"$ref": "#/$defs/profile"},
    "profile_digest": {"$ref": "#/$defs/digest"},
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_manifest_digest", "event_store_digest"],
      "properties": {
        "artifact_manifest_digest": {"$ref": "#/$defs/digest"},
        "event_store_digest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "capture_provenance_digest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}
      }
    },
    "input_coverage": {"$ref": "#/$defs/coverage"},
    "results": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/result"}},
    "mixed_findings": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/mixedFinding"}},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analyzed_artifacts", "candidate_count", "likely_vm_count", "failed_count", "mixed_count"],
      "properties": {
        "analyzed_artifacts": {"type": "integer", "minimum": 0},
        "candidate_count": {"type": "integer", "minimum": 0},
        "likely_vm_count": {"type": "integer", "minimum": 0},
        "failed_count": {"type": "integer", "minimum": 0},
        "mixed_count": {"type": "integer", "minimum": 0}
      }
    },
    "document_digest": {"$ref": "#/$defs/digest"},
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "request_id", "root_event", "edge_semantics"],
      "properties": {
        "kind": {"const": "request"},
        "request_id": {"$ref": "#/$defs/nonzeroUint64"},
        "root_event": {"$ref": "#/$defs/exactEventReference"},
        "edge_semantics": {"const": "exact-captured-response-body"}
      },
      "description": "Optional exact native request projection metadata outside the stored document digest. Only results with a matching exact_request_links request_id and full root_event are retained; mixed_findings is empty. related_request_ids remains correlation only and is not used for this projection."
    }
  },
  "$defs": {
    "dispatchClassification": {"description": "Analyzer interpretation of stored artifact bytes. Each site states how control picks the next handler, where the selector value comes from, and whether the dispatch repeats in a selector-advancing loop. confidence is always structural. It never rewrites captured evidence and never raises a VM tier.", "type": "object", "additionalProperties": false, "required": ["classification_version", "site_count", "omitted_site_count", "role_counts", "kind_counts", "sites"], "properties": {"classification_version": {"const": 1}, "site_count": {"type": "integer", "minimum": 0, "maximum": 4294967295}, "omitted_site_count": {"type": "integer", "minimum": 0, "maximum": 4294967295}, "role_counts": {"type": "object", "additionalProperties": false, "required": ["interpreter-candidate", "multiplexer", "other"], "properties": {"interpreter-candidate": {"type": "integer", "minimum": 0}, "multiplexer": {"type": "integer", "minimum": 0}, "other": {"type": "integer", "minimum": 0}}}, "kind_counts": {"type": "object", "additionalProperties": false, "required": ["switch_on_value", "handler_table", "compare_chain", "export_per_role", "threaded"], "properties": {"switch_on_value": {"type": "integer", "minimum": 0}, "handler_table": {"type": "integer", "minimum": 0}, "compare_chain": {"type": "integer", "minimum": 0}, "export_per_role": {"type": "integer", "minimum": 0}, "threaded": {"type": "integer", "minimum": 0}}}, "sites": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/dispatchClassificationSite"}}}},
    "dispatchClassificationSite": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "dispatch_kind", "selector_source", "repeats", "role", "confidence", "instruction", "location", "selector", "arm_count", "loop", "buffer_kind", "table"], "properties": {"artifact_id": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)$", "maxLength": 20}, "dispatch_kind": {"enum": ["switch_on_value", "handler_table", "compare_chain", "export_per_role", "threaded", "unknown"]}, "selector_source": {"enum": ["cursor_index", "cursor_pointer", "frame_slot", "call_argument", "handler_address", "constant", "unknown"]}, "repeats": {"enum": ["loop", "once", "unknown"]}, "role": {"enum": ["interpreter-candidate", "multiplexer", "other"], "description": "Derived from the three axes. interpreter-candidate: repeats=loop with cursor_index, cursor_pointer or frame_slot on switch_on_value, handler_table or compare_chain. multiplexer: repeats=once with call_argument on the same kinds; its arms or constants are routing labels and no guest opcode is claimed. other: everything else."}, "confidence": {"const": "structural"}, "instruction": {"enum": ["br_table", "call_indirect", "return_call_indirect", "i32.eq ladder", "export", "switch", "indexed call", "if ladder", "self call"]}, "location": {"type": "object", "additionalProperties": false, "required": ["function_index", "function_body_offset", "byte_offset", "byte_size", "line", "column"], "properties": {"function_index": {"type": ["integer", "null"], "minimum": 0, "maximum": 4294967295, "description": "Wasm function index (imports first); null for JavaScript and module-level records."}, "function_body_offset": {"type": ["integer", "null"], "minimum": 0, "description": "Wasm code entry offset, or JavaScript function region start."}, "byte_offset": {"type": "integer", "minimum": 0, "description": "Artifact byte offset of the dispatch instruction or first comparison."}, "byte_size": {"type": "integer", "minimum": 1}, "line": {"type": ["integer", "null"], "minimum": 1, "description": "JavaScript one-based line; null for Wasm."}, "column": {"type": ["integer", "null"], "minimum": 1, "description": "JavaScript one-based character column; null for Wasm."}}}, "selector": {"type": "object", "additionalProperties": false, "required": ["expression", "byte_offset"], "properties": {"expression": {"type": "string", "minLength": 1, "maxLength": 160, "description": "Bounded rendering of the instructions or source expression that produced the selector. Inert text."}, "byte_offset": {"type": ["integer", "null"], "minimum": 0, "description": "Offset of the closest producing write or load, when it is not the dispatch itself."}}}, "arm_count": {"type": ["integer", "null"], "minimum": 0, "maximum": 4294967295, "description": "br_table explicit arms, JavaScript case labels, comparisons in a ladder, type-matching table slots, or exported functions."}, "loop": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["byte_offset", "byte_size"], "properties": {"byte_offset": {"type": "integer", "minimum": 0}, "byte_size": {"type": "integer", "minimum": 1}}}], "description": "The selector-advancing loop for repeats=loop, otherwise the innermost enclosing loop; null outside loops."}, "buffer_kind": {"enum": ["string", "typed-array", "array", "unknown", null], "description": "JavaScript cursor buffers only. string flags a tokenizer-shaped loop; it adds no other claim."}, "table": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["table_index", "type_index", "populated_slot_count", "matching_slot_count", "matching_slots"], "properties": {"table_index": {"type": "integer", "minimum": 0, "maximum": 4294967295}, "type_index": {"type": "integer", "minimum": 0, "maximum": 4294967295}, "populated_slot_count": {"type": ["integer", "null"], "minimum": 0}, "matching_slot_count": {"type": ["integer", "null"], "minimum": 0}, "matching_slots": {"anyOf": [{"type": "null"}, {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 4294967295}}], "description": "Real table slot indexes, after evaluated element offsets, whose function signature equals the call's type. A prefix of at most 32. Null when the table layout is unknown."}}}]}}},
    "dispatchInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ranking_version",
        "site_count",
        "br_table_count",
        "call_indirect_count",
        "omitted_site_count",
        "selected_byte_offset",
        "candidates"
      ],
      "properties": {
        "ranking_version": {
          "const": 1
        },
        "site_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "br_table_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "call_indirect_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "omitted_site_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "selected_byte_offset": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "candidates": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/dispatchSite"
          }
        }
      }
    },
    "dispatchSite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "function_index",
        "byte_offset",
        "function_body_offset",
        "loop_depth",
        "structural_score",
        "byte_size",
        "function_body_size",
        "arm_count",
        "unique_target_count",
        "element_fanout",
        "ip_like",
        "classification",
        "evidence_class"
      ],
      "properties": {
        "kind": {
          "enum": [
            "br_table",
            "call_indirect"
          ]
        },
        "function_index": {
          "type": "integer",
          "minimum": 0
        },
        "byte_offset": {
          "type": "integer",
          "minimum": 0
        },
        "function_body_offset": {
          "type": "integer",
          "minimum": 0
        },
        "loop_depth": {
          "type": "integer",
          "minimum": 0
        },
        "structural_score": {
          "type": "integer",
          "minimum": 0
        },
        "byte_size": {
          "type": "integer",
          "minimum": 1
        },
        "function_body_size": {
          "type": "integer",
          "minimum": 1
        },
        "arm_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4294967295
        },
        "unique_target_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 4294967295
        },
        "element_fanout": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 4294967295
        },
        "ip_like": {
          "type": "boolean"
        },
        "classification": {
          "enum": [
            "cff-helper-candidate",
            "dispatch-candidate",
            "indirect-handler-candidate"
          ]
        },
        "evidence_class": {
          "enum": [
            "handler-table-candidate",
            "call-indirect-table",
            "cff-helper"
          ]
        }
      }
    },
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "eventReference": {"type": "object", "additionalProperties": false, "required": ["session_id", "process_id", "sequence_number"], "properties": {"session_id": {"allOf": [{"$ref": "#/$defs/uint64"}, {"not": {"const": "0"}}]}, "process_id": {"type": "integer", "minimum": 1, "maximum": 4294967295}, "sequence_number": {"allOf": [{"$ref": "#/$defs/uint64"}, {"not": {"const": "0"}}]}}},
    "nonzeroUint64": {"type": "string", "minLength": 1, "maxLength": 20, "pattern": "^(?:[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-4]|18446744073709551615)$", "not": {"pattern": "[^0-9]"}, "description": "Canonical decimal integer from 1 through 18446744073709551615; keep as a string."},
    "exactEventReference": {"type": "object", "additionalProperties": false, "required": ["session_id", "process_id", "sequence_number"], "properties": {"session_id": {"$ref": "#/$defs/nonzeroUint64"}, "process_id": {"type": "integer", "minimum": 1, "maximum": 4294967295}, "sequence_number": {"$ref": "#/$defs/nonzeroUint64"}}},
    "exactRequestLink": {"type": "object", "additionalProperties": false, "required": ["request_id", "root_event", "response_event", "capture_event", "relation"], "properties": {"request_id": {"$ref": "#/$defs/nonzeroUint64"}, "root_event": {"$ref": "#/$defs/exactEventReference"}, "response_event": {"$ref": "#/$defs/exactEventReference"}, "capture_event": {"$ref": "#/$defs/exactEventReference"}, "relation": {"const": "captured-response-body"}}, "description": "Explicit native request-start to response-start to acknowledged artifact-capture chain. All event references share a session and process, with strictly increasing sequence numbers, checked by the producer and consumer. No URL, timestamp, CDP identifier, or related_request_ids heuristic establishes this relation."},
    "findingId": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
    "uint64": {"type": "string", "minLength": 1, "maxLength": 20, "pattern": "^(?:0|[1-9][0-9]*)$"},
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "candidate_threshold", "likely_vm_threshold", "likely_vm_required_families", "rule_weights", "limits"],
      "properties": {
        "profile_id": {"const": "anti-bot-vm-detection-v1"},
        "runtime_evidence_version": {"const": 2, "description": "Identity-aware retained runtime relevance; independent of structural VM scoring."},
        "runtime_rule_weights": {"type": "object", "additionalProperties": false, "required": ["antibot.runtime-canvas-webgl", "antibot.runtime-navigator-device", "antibot.runtime-web-audio"], "properties": {"antibot.runtime-canvas-webgl": {"type": "integer", "minimum": 0, "maximum": 100}, "antibot.runtime-navigator-device": {"type": "integer", "minimum": 0, "maximum": 100}, "antibot.runtime-web-audio": {"type": "integer", "minimum": 0, "maximum": 100}}},
        "javascript_scoring_version": {"type": "integer", "const": 2, "description": "Version 2 scores same-length comment/literal-masked JavaScript regions. Absent in earlier v1 documents."},
        "javascript_likely_vm_requires_handlers": {"const": true, "description": "Present in producer 1.3.0 and later: JavaScript likely-vm requires recovered static handlers in addition to the structural score. Absent in historical profiles."},
        "candidate_threshold": {"type": "integer", "minimum": 0},
        "likely_vm_threshold": {"type": "integer", "minimum": 0},
        "likely_vm_required_families": {"type": "integer", "minimum": 1},
        "rule_weights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["js.dispatch-loop", "js.instruction-pointer", "js.indexed-bytecode-read", "js.state-effects", "js.handler-selection", "js.bounded-exit", "wasm.dispatch-loop", "wasm.instruction-pointer", "wasm.linear-memory", "wasm.handler-table", "wasm.bytecode-region", "wasm.bounded-exit"],
          "properties": {
            "js.dispatch-loop": {"type": "integer", "minimum": 0},
            "js.instruction-pointer": {"type": "integer", "minimum": 0},
            "js.indexed-bytecode-read": {"type": "integer", "minimum": 0},
            "js.state-effects": {"type": "integer", "minimum": 0},
            "js.handler-selection": {"type": "integer", "minimum": 0},
            "js.bounded-exit": {"type": "integer", "minimum": 0},
            "wasm.dispatch-loop": {"type": "integer", "minimum": 0},
            "wasm.instruction-pointer": {"type": "integer", "minimum": 0},
            "wasm.linear-memory": {"type": "integer", "minimum": 0},
            "wasm.handler-table": {"type": "integer", "minimum": 0},
            "wasm.bytecode-region": {"type": "integer", "minimum": 0},
            "wasm.bounded-exit": {"type": "integer", "minimum": 0}
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_artifact_bytes", "max_js_matches_per_rule", "max_js_function_regions", "max_js_region_work_bytes", "max_wasm_sections", "max_wasm_section_bytes", "max_graph_edges", "max_bytecode_snapshot_bytes", "max_manifest_line_bytes", "max_event_line_bytes", "max_artifact_records", "max_event_records", "max_wasm_functions", "max_wasm_instructions"],
          "properties": {
            "max_artifact_bytes": {"type": "integer", "minimum": 1},
            "max_js_matches_per_rule": {"type": "integer", "minimum": 1},
            "max_js_function_regions": {"type": "integer", "minimum": 1},
            "max_js_region_work_bytes": {"type": "integer", "minimum": 1},
            "max_wasm_sections": {"type": "integer", "minimum": 1},
            "max_wasm_section_bytes": {"type": "integer", "minimum": 1},
            "max_graph_edges": {"type": "integer", "minimum": 1},
            "max_bytecode_snapshot_bytes": {"type": "integer", "minimum": 1},
            "max_manifest_line_bytes": {"type": "integer", "minimum": 1},
            "max_event_line_bytes": {"type": "integer", "minimum": 1},
            "max_artifact_records": {"type": "integer", "minimum": 1},
            "max_event_records": {"type": "integer", "minimum": 1},
            "max_wasm_functions": {"type": "integer", "minimum": 1},
            "max_wasm_instructions": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["byte_offset", "byte_size"],
      "properties": {
        "byte_offset": {"type": "integer", "minimum": 0},
        "byte_size": {"type": "integer", "minimum": 1},
        "function_index": {"type": "integer", "minimum": 0},
        "function_body_offset": {"type": "integer", "minimum": 0},
        "function_body_size": {"type": "integer", "minimum": 1}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "weight", "detail"],
      "anyOf": [{"required": ["coordinate"]}, {"required": ["event"]}],
      "properties": {
        "rule_id": {"type": "string", "minLength": 1},
        "family": {"type": "string", "minLength": 1},
        "weight": {"type": "integer", "minimum": 0},
        "coordinate": {"$ref": "#/$defs/coordinate"},
        "detail": {"type": "string", "minLength": 1},
        "match_count": {"type": "integer", "minimum": 1},
        "matches_truncated": {"type": "boolean"},
        "function_region": {"$ref": "#/$defs/coordinate"},
        "event": {"$ref": "#/$defs/eventReference"},
        "event_sequence": {"$ref": "#/$defs/uint64"},
        "state": {"enum": ["observed", "correlated"]}
      }
    },
    "omission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": {"type": "string", "minLength": 1},
        "detail": {"type": "string", "minLength": 1},
        "line": {"type": "integer", "minimum": 0},
        "observed_bytes": {"type": "integer", "minimum": 0},
        "total_bytes": {"type": "integer", "minimum": 0},
        "observed_records": {"type": "integer", "minimum": 0},
        "omitted_records": {"type": "integer", "minimum": 0}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complete", "omissions"],
      "properties": {
        "complete": {"type": "boolean"},
        "observed_bytes": {"type": "integer", "minimum": 0},
        "total_bytes": {"type": "integer", "minimum": 0},
        "omissions": {"type": "array", "items": {"$ref": "#/$defs/omission"}},
        "residual_unknowns": {"type": "array", "items": {"type": "string"}}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason"],
      "properties": {
        "state": {"enum": ["observed", "inferred", "correlated", "unknown"]},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "graphEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "state", "reason"],
      "properties": {
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "state": {"enum": ["observed", "inferred", "correlated", "unknown"]},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "graphNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["artifact", "vm-candidate", "browser-signal", "request"]},
        "label": {"type": "string"},
        "event": {"$ref": "#/$defs/eventReference"},
        "event_sequence": {"$ref": "#/$defs/uint64"},
        "request_id": {"$ref": "#/$defs/uint64"}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_sha256", "runtime", "status", "coverage"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/uint64"},
        "artifact_sha256": {"$ref": "#/$defs/digest"},
        "runtime": {"enum": ["javascript", "webassembly", "unknown"]},
        "status": {"enum": ["complete", "partial", "failed"]},
        "finding_id": {"$ref": "#/$defs/findingId"},
        "tier": {"enum": ["none", "candidate", "likely-vm"]},
        "vm_score": {"type": "integer", "minimum": 0},
        "vm_threshold": {"type": "integer", "minimum": 0},
        "required_family_count": {"type": "integer", "minimum": 1},
        "evidence_families": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "observations": {"type": "array", "items": {"$ref": "#/$defs/observation"}},
        "anti_bot_score": {"type": "integer", "minimum": 0, "maximum": 100},
        "anti_bot_observations": {"type": "array", "items": {"$ref": "#/$defs/observation"}},
        "related_request_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/uint64"}},
        "exact_request_links": {"type": "array", "maxItems": 1, "items": {"$ref": "#/$defs/exactRequestLink"}, "description": "Optional exact captured response-body linkage, present in producer 1.4.0 and later. Empty or absent means no exact link is established; this does not establish execution or causation."},
        "graph": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nodes", "edges"],
          "properties": {
            "nodes": {"type": "array", "items": {"$ref": "#/$defs/graphNode"}},
            "edges": {"type": "array", "items": {"$ref": "#/$defs/graphEdge"}}
          }
        },
        "coverage": {"$ref": "#/$defs/coverage"},
        "frontend": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "replacement_character_count": {"type": "integer", "minimum": 0},
            "section_count": {"type": "integer", "minimum": 0},
            "code_section_count": {"type": "integer", "minimum": 0},
            "data_section_count": {"type": "integer", "minimum": 0},
            "decoded_function_count": {"type": "integer", "minimum": 0},
            "imported_function_count": {"type": "integer", "minimum": 0},
            "decoded_instruction_count": {"type": "integer", "minimum": 0},
            "dispatch_inventory": {"$ref": "#/$defs/dispatchInventory"},
            "dispatch_classification": {"$ref": "#/$defs/dispatchClassification", "description": "Present in producer 1.6.0 and later: structural dispatch-site classification, contract vm-dispatch-classification-v1. Interpretation only."}
          }
        },
        "bytecode_snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact_id", "snapshot_hex", "unavailable_reason"],
          "properties": {
            "artifact_id": {"$ref": "#/$defs/uint64"},
            "producer": {
              "type": "object", "additionalProperties": false,
              "required": ["kind", "byte_offset"],
              "properties": {"kind": {"const": "static-initializer"}, "byte_offset": {"type": "integer", "minimum": 0}}
            },
            "consumer": {
              "type": "object", "additionalProperties": false,
              "required": ["kind", "status"],
              "properties": {"kind": {"const": "indexed-read"}, "status": {"const": "inferred"}}
            },
            "sha256": {"$ref": "#/$defs/digest"},
            "original_byte_count": {"type": "integer", "minimum": 0},
            "snapshot_byte_count": {"type": "integer", "minimum": 0},
            "snapshot_hex": {"anyOf": [{"type": "string", "pattern": "^(?:[0-9a-f]{2})*$"}, {"type": "null"}]},
            "truncated": {"type": "boolean"},
            "unavailable_reason": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}
          }
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {"code": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "failed"}}, "required": ["status"]},
          "then": {"required": ["error"]},
          "else": {"required": ["finding_id", "tier", "vm_score", "vm_threshold", "required_family_count", "evidence_families", "observations", "anti_bot_score", "anti_bot_observations", "related_request_ids", "graph", "frontend"]}
        }
      ]
    },
    "mixedFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "runtime", "tier", "artifact_ids", "vm_score", "anti_bot_score", "evidence_families", "boundary"],
      "properties": {
        "finding_id": {"$ref": "#/$defs/findingId"},
        "runtime": {"const": "mixed"},
        "tier": {"enum": ["candidate", "likely-vm"]},
        "artifact_ids": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/uint64"}},
        "vm_score": {"type": "integer", "minimum": 0},
        "anti_bot_score": {"type": "integer", "minimum": 0},
        "evidence_families": {"type": "array", "items": {"type": "string"}},
        "boundary": {"$ref": "#/$defs/edge"}
      }
    }
  }
}
