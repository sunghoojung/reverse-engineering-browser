{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://origin-trace.local/protocol/vm-bytecode-v1.schema.json",
  "title": "Inert VM bytecode image v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "image_id",
    "definition_id",
    "entry_offsets",
    "bytes_hex"
  ],
  "properties": {
    "format": {
      "const": "reb-vm-bytecode-v1"
    },
    "image_id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$(?![\\s\\S])"
    },
    "definition_id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$(?![\\s\\S])"
    },
    "entry_offsets": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 65535
      },
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true
    },
    "bytes_hex": {
      "type": "string",
      "maxLength": 131072,
      "pattern": "^(?:[a-f0-9]{2})*$(?![\\s\\S])"
    }
  }
}
