        "width": {
          "enum": [
            1,
            2,
            4
          ]
        },
        "signed": {
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "immediate",
            "register",
            "address",
            "offset"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "register",
                  "address"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "signed": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "offset"
              }
            }
          },
          "then": {
            "properties": {
              "signed": {
                "const": true
              }
            }
