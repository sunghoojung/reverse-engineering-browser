{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://origin-trace.local/protocol/vm-definition-v1.schema.json",
  "title": "Declarative VM definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "definition_id",
    "architecture",
    "opcode_bytes",
    "operand_endianness",
    "register_count",
    "opcodes"
  ],
  "properties": {
    "format": {
      "const": "reb-vm-definition-v1"
    },
    "definition_id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$(?![\\s\\S])"
    },
    "architecture": {
      "enum": [
        "stack",
        "register"
      ]
    },
    "opcode_bytes": {
      "enum": [
        1,
        2
      ]
    },
    "operand_endianness": {
      "enum": [
        "little",
        "big"
      ]
    },
    "register_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 64
    },
    "opcodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/opcode"
      },
      "minItems": 1,
      "maxItems": 256
    }
  },
  "$defs": {
