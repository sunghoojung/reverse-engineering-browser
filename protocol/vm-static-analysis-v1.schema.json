{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://origin-trace.local/protocol/vm-static-analysis-v1.schema.json",
  "title": "Declared static VM analysis v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "definition",
    "image",
    "provenance",
    "instructions",
    "cfg",
    "coverage",
    "pseudocode",
    "diagnostics",
    "warnings",
    "equivalence_proven"
  ],
  "properties": {
    "format": {
      "const": "reb-vm-static-analysis-v1"
    },
    "definition": {
      "$ref": "vm-definition-v1.schema.json"
    },
    "image": {
      "$ref": "vm-bytecode-v1.schema.json"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition_canonical_sha256",
        "definition_source_sha256",
        "image_bytes_sha256",
        "image_source_sha256"
      ],
      "properties": {
        "definition_canonical_sha256": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
        },
        "definition_source_sha256": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "image_bytes_sha256": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
        },
        "image_source_sha256": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "instructions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/instruction"
      },
      "minItems": 0,
      "maxItems": 4096
    },
    "cfg": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes",
        "edges",
        "entries",
        "complete"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "instruction_id",
              "offset",
              "reachable"
            ],
            "properties": {
              "instruction_id": {
                "type": "string",
                "maxLength": 10,
                "pattern": "^insn:(0|[1-9][0-9]{0,4})$(?![\\s\\S])"
              },
              "offset": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              },
              "reachable": {
                "type": "boolean"
              }
            }
          },
          "minItems": 0,
          "maxItems": 4096
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from_offset",
              "to_offset",
              "kind",
              "status",
              "evidence"
            ],
            "properties": {
              "from_offset": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              },
              "to_offset": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": -2147483648,
                    "maximum": 4294967295
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "kind": {
                "enum": [
                  "fallthrough",
                  "jump",
                  "branch_taken",
                  "branch_not_taken",
                  "call",
                  "call_continuation",
                  "return",
                  "unknown"
                ]
              },
              "status": {
                "enum": [
                  "resolved",
                  "mid_instruction",
                  "out_of_range",
                  "undecoded",
                  "unknown"
                ]
              },
              "evidence": {
                "const": "declared_static"
              }
            }
          },
          "minItems": 0,
          "maxItems": 8192
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "offset",
              "status"
            ],
            "properties": {
              "offset": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              },
              "status": {
                "enum": [
                  "resolved",
                  "mid_instruction",
                  "out_of_range",
                  "undecoded"
                ]
              }
            }
          },
          "minItems": 1,
          "maxItems": 64
        },
        "complete": {
          "const": false
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decoded_bytes",
        "total_bytes",
        "instruction_count",
        "stop_reason",
        "undecoded_bytes"
      ],
      "properties": {
        "decoded_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "instruction_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "stop_reason": {
          "enum": [
            "end",
            "unknown_opcode",
            "truncated_instruction",
            "invalid_operand",
            "instruction_budget"
          ]
        },
        "undecoded_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        }
      }
    },
    "pseudocode": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pseudocode"
      },
      "minItems": 0,
      "maxItems": 8192
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "offset",
          "code",
          "message"
        ],
        "properties": {
          "offset": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              },
              {
                "type": "null"
              }
            ]
          },
          "code": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z_]{1,64}$(?![\\s\\S])"
          },
          "message": {
            "type": "string",
            "maxLength": 512
          }
        }
      },
      "minItems": 0,
      "maxItems": 8257
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 512
      },
      "minItems": 0,
      "maxItems": 16
    },
    "equivalence_proven": {
      "const": false
    }
  },
  "$defs": {
    "instruction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "offset",
        "size",
        "bytes_hex",
        "opcode",
        "mnemonic",
        "operands",
        "operation",
        "args",
        "semantics_status",
        "flow",
        "pseudocode"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^insn:(0|[1-9][0-9]{0,4})$(?![\\s\\S])"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 34
        },
        "bytes_hex": {
          "type": "string",
          "maxLength": 68,
          "pattern": "^(?:[a-f0-9]{2}){1,34}$(?![\\s\\S])"
        },
        "opcode": {
          "type": "string",
          "maxLength": 4,
          "pattern": "^(?:[a-f0-9]{2}){1,2}$(?![\\s\\S])"
        },
        "mnemonic": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,31}$(?![\\s\\S])"
        },
        "operands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decoded_operand"
          },
          "minItems": 0,
          "maxItems": 8
        },
        "operation": {
          "enum": [
            "unknown",
            "nop",
            "stack_const",
            "stack_add",
            "stack_drop",
            "stack_dup",
            "register_const",
            "register_move",
            "register_add",
            "load",
            "store",
            "jump",
            "branch_zero",
            "stack_branch_zero",
            "call",
            "return",
            "halt"
          ]
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 32,
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,31}$(?![\\s\\S])"
          },
          "minItems": 0,
          "maxItems": 3
        },
        "semantics_status": {
          "enum": [
            "declared",
            "unknown"
          ]
        },
        "flow": {
          "$ref": "vm-definition-v1.schema.json#/$defs/flow"
        },
        "pseudocode": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pseudocode"
          },
          "minItems": 1,
          "maxItems": 2
        }
      }
    },
    "decoded_operand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "width",
        "signed",
        "kind",
        "offset",
        "bytes_hex",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,31}$(?![\\s\\S])"
        },
        "width": {
          "enum": [
            1,
            2,
            4
          ]
        },
        "signed": {
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "immediate",
            "register",
            "address",
            "offset"
          ]
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "bytes_hex": {
          "type": "string",
          "maxLength": 8,
          "pattern": "^(?:[a-f0-9]{2}){1,4}$(?![\\s\\S])"
        },
        "value": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 4294967295
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "register",
                  "address"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "signed": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "offset"
              }
            }
          },
          "then": {
            "properties": {
              "signed": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "pseudocode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instruction_id",
        "offset",
        "text",
        "status"
      ],
      "properties": {
        "instruction_id": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^insn:(0|[1-9][0-9]{0,4})$(?![\\s\\S])"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "text": {
          "type": "string",
          "maxLength": 512
        },
        "status": {
          "enum": [
            "declared",
            "unknown"
          ]
        }
      }
    }
  }
}
