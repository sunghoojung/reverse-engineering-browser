    {
      "id": "authored-throw-and-effects",
      "mode": "trusted-differential",
      "source": "let completion='normal';let result;const effects=[];try{effects.push('before');throw new TypeError('authored');}catch(error){completion='throw';result=error.name;}",
      "expected_observation": [
        "observation",
